# Throwaway target system: Debian with systemd and SSH, like a fresh MPP VM.
FROM debian:12
ENV DEBIAN_FRONTEND=noninteractive
# python3 belongs here so the endpoint test really runs its TLS stage
# instead of skipping it.
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus \
      openssh-server sudo curl ca-certificates openssl procps iproute2 \
      python3 \
    && rm -rf /var/lib/apt/lists/*
# For this test only: root login. The key is placed there at run time.
RUN mkdir -p /run/sshd \
    && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' \
         /etc/ssh/sshd_config \
    && systemctl enable ssh
# Units that cannot run inside the container
RUN rm -f /lib/systemd/system/multi-user.target.wants/systemd-logind.service \
    && systemctl mask systemd-udevd systemd-modules-load \
         systemd-journald-audit.socket
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
