#!/usr/bin/expect -f
# Answers the two interactive questions of the first run: OpenSSH's
# host-key question and the fingerprint confirmation of the enrollment.
# See issue #16 on the duplicate prompt.
set timeout 1800
log_user 1
set nats_user [lindex $argv 0]
set ssh_target [lindex $argv 1]
spawn ./prtg-nats install-mpp $ssh_target --nats-user $nats_user
expect {
  -re "continue connecting \\(yes/no"  { send "yes\r"; exp_continue }
  -re "Continue\\? \\\[y/N\\\]"        { send "y\r";   exp_continue }
  -re "trust this CA\\? \\\[y/N\\\]"   { send "y\r";   exp_continue }
  timeout { puts "\nTIMEOUT during the installation run"; exit 99 }
  eof
}
catch wait result
exit [lindex $result 3]
