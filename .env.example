# Site settings for the stack. Copy to .env beside compose.yaml, fill in the
# three required values, then "docker compose up -d".
#
# Compose passes these to the API container as environment variables. They are
# the only configuration living outside the runtime volume - everything else
# the platform manages itself, through the interface.

# --- Required: site-specific, no default ---

# FQDN of the NATS server. Has to resolve in DNS and is the SAN in the
# server certificate; the PRTG core and every probe connect through this
# name.
#NATS_FQDN=

# IP address on which the containers publish their ports.
#NATS_HOST_IP=

# IP address of the PRTG core.
#PRTG_CORE_IP=

# --- Defaults: change only when needed ---

# TLS client port of the NATS server, used by the PRTG core and every probe.
NATS_PORT=23561

# Port serving the public CA and the health CGI over plain HTTP. A probe has
# to fetch the CA before it can verify anything served with it.
CA_HTTP_PORT=80

# Organisation in the subject of the generated CA. Only affects a new CA.
CA_ORGANIZATION=PRTG NATS

# Source address the restricted management key is valid from.
# Default: NATS_HOST_IP/32
#MPP_SSH_SOURCE_CIDR=

# The same for iperf measurement endpoints, and without that default. A probe
# sees this installation under its internal address; an endpoint on a public
# network sees it under the address this site leaves with, which nothing here
# can derive. Unset, every endpoint invitation has to name its own. Several
# networks are allowed, separated by commas.
#IPERF_SSH_SOURCE_CIDR=

# --- Web interface ---

# Host port for the web interface. TLS terminates in the reverse proxy, with a
# certificate issued by the installation's own CA.
WEB_HTTPS_PORT=8443

# Name the certificate of the web interface is issued for.
# Defaults to NATS_FQDN, which is right for a single-server installation.
#WEB_FQDN=
