# Source inputs for the managed iPerf3 artifacts. The build verifies both
# archives before extracting them; changing a version therefore requires an
# explicit checksum update in the same review.
IPERF_VERSION=3.21
# Minimum accepted only when a probe's userspace platform has no managed
# artifact. This matches the iperf3 version in current Raspberry Pi OS Trixie.
IPERF_SYSTEM_MIN_VERSION=3.18
IPERF_SOURCE_URL=https://downloads.es.net/pub/iperf/iperf-3.21.tar.gz
IPERF_SOURCE_SHA256=656e4405ebd620121de7ceca3eaf43a88f79ea1b857d041a6a0b1314801acdd8

OPENSSL_VERSION=3.5.8
OPENSSL_SOURCE_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.8/openssl-3.5.8.tar.gz
OPENSSL_SOURCE_SHA256=a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2

# The newest source release timestamp. Build tools that honor
# SOURCE_DATE_EPOCH use it instead of the wall clock.
IPERF_SOURCE_DATE_EPOCH=1787658999
