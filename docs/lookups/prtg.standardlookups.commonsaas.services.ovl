<?xml version="1.0" encoding="UTF-8"?>
 <ValueLookup id="prtg.standardlookups.commonsaas.services" desiredValue="1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="PaeValueLookup.xsd">
    <Lookups>
      <Range from="-1" to="-1" state="OK">Not Checked</Range>
      <Range from="0" to="0" state="OK">Not Available</Range>
      <Range from="1" to="99999" state="OK">Available</Range>
    </Lookups>
  </ValueLookup>