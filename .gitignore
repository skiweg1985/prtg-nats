# Generated runtime state and secrets
/runtime/

# Local environment overrides
/.env
/.env.*
!/.env.example

# Backup archives
/backups/

# Archived Gitea history, kept out of the published tree
/.backup/

# Scratch checkouts the agent tooling creates
/.claude/worktrees/

# Real host names and addresses the static check greps for. Belongs on the
# machine that knows them, never in the published tree. The name deliberately
# avoids a ".local" suffix - the check would flag its own ignore entry.
/tests/internal-identifiers.patterns

# Python bytecode from the sensor checks
__pycache__/
*.pyc

# Editor and operating-system files
.DS_Store
*.swp
*.tmp

# Web platform build output and local dependencies
/web/frontend/node_modules/
/web/frontend/dist/
/web/backend/.venv/
/web/backend/*.egg-info/
/tools/iperf3/artifacts/
.pytest_cache/
.ruff_cache/
.mypy_cache/
