SENSOR_NAME=iperf-throughput
SENSOR_VERSION=1
SENSOR_DESCRIPTION=Uplink quality against an own iperf3 endpoint (throughput, loss, jitter, latency)
SENSOR_SCRIPT=script/iperf-throughput.py
SENSOR_PRIVILEGED=
SENSOR_REQUIREMENTS=
SENSOR_NEEDS_INTERFACE=false
# This sensor measures against a self-operated endpoint. The entry tells
# "./prtg-nats sensor deploy" that the credentials of the configured
# endpoints belong along as a profile; they are managed with
# "./prtg-nats iperf-server".
SENSOR_IPERF=iperf3
