# Events wpa_supplicant reports on stdout, with the cause they mean for
# the sensor. Order decides: the first matching line wins, so a follow-up
# message does not overwrite the actual cause.
FAILURE_EVENTS = (
    ("CTRL-EVENT-SSID-TEMP-DISABLED", "WRONG_KEY", "auth-failed-psk",
     "PSK rejected"),
    ("CTRL-EVENT-EAP-TLS-CERT-ERROR", None, "server-cert-rejected",
     "RADIUS certificate rejected"),
    ("CTRL-EVENT-EAP-FAILURE", None, "auth-failed-eap",
     "credentials rejected by RADIUS"),
    ("CTRL-EVENT-AUTH-REJECT", None, "auth-rejected",
     "authentication rejected by AP"),
    ("CTRL-EVENT-ASSOC-REJECT", None, "assoc-rejected",
     "association rejected by AP"),
    ("CTRL-EVENT-NETWORK-NOT-FOUND", None, "ssid-not-found",
     "SSID not found"),
)


# An access point that turns a station away says why in the association
# response, and wpa_supplicant passes the number straight through. Without
# it PRTG says only "rejected"; with it the difference between "no capacity
# left" (17), "come back later" (30) and "denied for a reason outside the
# standard" (12, typical for MAC filters and client blocks) is readable from
# the sensor message alone.
STATUS_CODE = re.compile(r"status_code=(\d+)")


def with_status_code(message, line):
    """The event's own status code, appended where it names one."""
    found = STATUS_CODE.search(line)
    if not found:
        return message
    return "%s (status %s)" % (message, found.group(1))


class Blocked(Exception):
    """The test could not be carried out - no statement about the Wi-Fi."""

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


class Failed(Exception):
    """The test ran, but the sign-in failed."""

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def hex_value(value):
    """Write string fields as hex.

    wpa_supplicant reads every string field either in quotation marks or
    as a hex string. The hex form makes quotation marks, backslashes and
    line breaks in SSIDs or passwords harmless - there is no escaping to
    overlook, and no way to smuggle a second directive into the
    configuration.
    """
    return value.encode("utf-8").hex()


def wpa_psk(passphrase, ssid):
    """PMK from passphrase and SSID, as wpa_passphrase produces it.

    That way the passphrase itself never sits in a file, not even briefly
    under /run.
    """
    return hashlib.pbkdf2_hmac(
        "sha1", passphrase.encode("utf-8"), ssid.encode("utf-8"), 4096, 32
    ).hex()


def read_profile(name):
    """Read credentials from a protected profile file.

    Only this privileged part can read it; the sensor script knows merely
    the profile name. That way no password sits in the PRTG
    configuration.
    """
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", name):
        raise Blocked("bad-request", "Invalid profile name")
    path = os.path.join(PROFILE_DIR, name + ".env")
    if not os.path.isfile(path):
        raise Blocked("profile-missing", "Configured profile does not exist")

    values = {}
    with open(path, "r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            key = key.strip().lower()
            if key in STRING_FIELDS:
                values[key] = value.strip()
    return values


def default_route_interfaces():
    """Interfaces the host routes its default routes over."""
    try:
        output = subprocess.run(
            ["ip", "-j", "route", "show", "default"],
            capture_output=True, text=True, timeout=10, check=True,
        ).stdout
        routes = json.loads(output or "[]")
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
        # Better no test at all than a test on the management path.
        raise Blocked("internal-error", "Could not determine the default route")
    return {route.get("dev") for route in routes if route.get("dev")}


def allowed_interfaces():
    if not os.path.isfile(ALLOWED_INTERFACES):
        return set()
    with open(ALLOWED_INTERFACES, "r", encoding="utf-8") as handle:
        return {
            line.strip() for line in handle
            if line.strip() and not line.startswith("#")
        }


def check_interface(interface):
    """Check every reason this interface is off limits.

    The most important: a test on the interface carrying the default
    route would cut the probe off from its NATS server and the host from
    its administration.
    """
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,15}", interface):
        raise Blocked("bad-request", "Invalid interface name")
    if not os.path.isdir(os.path.join("/sys/class/net", interface)):
        raise Blocked("iface-missing",
                      "Interface %s does not exist" % interface)
    if not os.path.exists(os.path.join("/sys/class/net", interface, "wireless")):
        raise Blocked("iface-not-wireless",
                      "Interface %s is not a wireless interface" % interface)
    if interface in default_route_interfaces():
        raise Blocked("iface-protected",
                      "Interface %s carries a default route" % interface)
    permitted = allowed_interfaces()
    if not permitted:
        raise Blocked("iface-not-reserved",
                      "No test interface is reserved on this probe")
    if interface not in permitted:
        raise Blocked("iface-not-reserved",
                      "Interface %s is not reserved for tests" % interface)


def check_file(path, label):
    if not path.startswith("/") or re.search(r"[\x00-\x1f]", path):
        raise Blocked("bad-request", "Invalid path for %s" % label)
    if not os.path.isfile(path):
        raise Blocked("file-missing", "Configured %s does not exist" % label)


def build_network_block(job):
    """The network={...} block for the chosen method.

    All variable values go into the file as hex strings; fixed values
    like key_mgmt or phase2 stand as literals.
    """
    lines = ["network={", "  ssid=%s" % hex_value(job["ssid"])]
    if job.get("hidden"):
        lines.append("  scan_ssid=1")
    if job.get("bssid"):
        if not re.fullmatch(r"(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}",
                            job["bssid"]):
            raise Blocked("bad-request", "Invalid BSSID")
        lines.append("  bssid=%s" % job["bssid"].lower())

    method = job["auth"]
    if method == "psk":
        if not job.get("psk"):
            raise Blocked("bad-request", "WPA2-PSK requires a passphrase")
        if not 8 <= len(job["psk"]) <= 63:
            raise Blocked("bad-request",
                          "The passphrase must be 8 to 63 characters long")
        lines.append("  key_mgmt=WPA-PSK")
        lines.append("  psk=%s" % wpa_psk(job["psk"], job["ssid"]))
        lines.append("}")
        return lines

    lines.append("  key_mgmt=WPA-EAP")
    if not job.get("identity"):
        raise Blocked("bad-request", "Enterprise authentication requires an identity")
    lines.append("  identity=%s" % hex_value(job["identity"]))
    if job.get("anonymous_identity"):
        lines.append("  anonymous_identity=%s"
                     % hex_value(job["anonymous_identity"]))

    if job.get("verify_server", True):
        if not job.get("ca_cert"):
            raise Blocked(
                "bad-request",
                "Server verification requires a CA certificate; "
                "pass --no-verify-server to test without it",
            )
        check_file(job["ca_cert"], "CA certificate")
        lines.append("  ca_cert=%s" % hex_value(job["ca_cert"]))
        if job.get("domain_suffix_match"):
            lines.append("  domain_suffix_match=%s"
                         % hex_value(job["domain_suffix_match"]))

    if method == "peap":
        if not job.get("password"):
            raise Blocked("bad-request", "PEAP requires a password")
        lines.append("  eap=PEAP")
        lines.append("  password=%s" % hex_value(job["password"]))
        lines.append('  phase2="auth=MSCHAPV2"')
    else:
        for field, label in (("client_cert", "client certificate"),
                             ("private_key", "private key")):
            if not job.get(field):
                raise Blocked("bad-request", "EAP-TLS requires a %s" % label)
            check_file(job[field], label)
        lines.append("  eap=TLS")
        lines.append("  client_cert=%s" % hex_value(job["client_cert"]))
        lines.append("  private_key=%s" % hex_value(job["private_key"]))
        if job.get("private_key_passwd"):
            lines.append("  private_key_passwd=%s"
                         % hex_value(job["private_key_passwd"]))
    lines.append("}")
    return lines


class SupplicantRun:
    """A wpa_supplicant instance with event stream and cleanup."""

    def __init__(self, interface, workdir):
        self.interface = interface
        self.workdir = workdir
        self.process = None
        self.events = []
        self.lock = threading.Lock()
        self.reader = None

    def start(self, config_path):
        try:
            self.process = subprocess.Popen(
                ["wpa_supplicant", "-i", self.interface, "-c", config_path,
                 "-D", "nl80211,wext"],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1,
            )
        except OSError:
            raise Blocked("internal-error", "Could not start wpa_supplicant")
        self.reader = threading.Thread(target=self._read, daemon=True)
        self.reader.start()

    def _read(self):
        for line in self.process.stdout:
            with self.lock:
                self.events.append((time.monotonic(), line.rstrip("\n")))

    def seen(self, needle, since=0.0):
        """Point in time of the first line with this text, otherwise None."""
        with self.lock:
            for stamp, line in self.events:
                if stamp >= since and needle in line:
                    return stamp
        return None

    def lines(self):
        """Everything the supplicant said so far, with its timestamps."""
        if self.reader is not None:
            # After stop() the pipe is closed; the reader finishes the last
            # lines within moments, and they are often the ones that matter.
            self.reader.join(timeout=1)
        with self.lock:
            return list(self.events)

    def failure(self):
        """The first line that names a cause."""
        with self.lock:
            snapshot = list(self.events)
        for _, line in snapshot:
            for marker, detail, code, message in FAILURE_EVENTS:
                if marker in line and (detail is None or detail in line):
                    return code, with_status_code(message, line)
        return None

    def control(self, *arguments):
        try:
            return subprocess.run(
                ["wpa_cli", "-p", self.workdir, "-i", self.interface, *arguments],
                capture_output=True, text=True, timeout=10,
            ).stdout
        except (subprocess.SubprocessError, OSError):
            return ""

    def stop(self):
        if self.process is None:
            return
        self.process.send_signal(signal.SIGTERM)
        try:
            self.process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait(timeout=5)


def parse_status(text):
    values = {}
    for line in text.splitlines():
        key, _, value = line.partition("=")
        if value:
            values[key.strip()] = value.strip()
    return values


def link_fingerprint(run):
    """What identifies this association: which cell, and whether it stands.

    Read before and after the DHCP stage. Two sensors share one radio on a
    probe, and the lock serialises their runs but not what the network does
    in between - a lease collected after the link changed belongs to the
    other run, not to this one.
    """
    status = parse_status(run.control("status"))
    return status.get("bssid", ""), status.get("wpa_state", "")


def collect_link_details(run, result):
    """Radio readings of the current connection, as far as still available."""
    status = parse_status(run.control("status"))
    signal_info = parse_status(run.control("signal_poll"))
    for key, value in (
        ("bssid", status.get("bssid", "")),
        ("ssid", status.get("ssid", "")),
        ("frequency_mhz", int(signal_info.get("FREQUENCY", 0)
                              or status.get("freq", 0) or 0)),
        ("signal_dbm", int(signal_info.get("RSSI", 0) or 0)),
    ):
        if value:
            result["details"][key] = value


def clear_process_group(process):
    """Take the whole session down, not just the process we started.

    dhcpcd 9 splits its privileges across child processes and does not
    take them with it when it segfaults on the way out. Left alone they
    outlive the run in the helper's cgroup, so systemd never sees the
    unit finish and waits out its stop timeout on every single call.
    """
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except OSError:
        pass
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


# udhcpc insists on a script to hand the lease to, and runs its own if none
# is named - which would put the address on the interface and make this a
# connection rather than a test. /bin/true is the script that does nothing.
#
# Not one of ours: a script of ours would have to live somewhere it can be
# executed, and the run directory is mounted noexec. The lease is read from
# what udhcpc says instead.
UDHCPC_SCRIPT = "/bin/true"

# "udhcpc: lease of 10.0.0.5 obtained from 10.0.0.1, lease time 28800"
UDHCPC_LEASE = re.compile(
    r"lease of (?P<address>\S+) obtained from (?P<server>[^,\s]+)")

# "rtt min/avg/max/mdev = 1.234/..." - the average is the reading.
PING_TIME = re.compile(r"= [\d.]+/([\d.]+)/")

def dhcp_command(interface, seconds):
    """The DHCP client to run, and how to ask it for one lease.

    udhcpc first. dhcpcd 9 confines its own child processes with seccomp,
    and where the kernel is 64-bit while userland is 32-bit - the ordinary
    shape of Raspberry Pi OS armhf on 64-bit hardware - the filter does not
    match the processes it guards. Every syscall falls through and the
    kernel kills the client with SIGSYS before it sends a single packet,
    which reads exactly like a DHCP server that never answered.

    udhcpc carries no sandbox and ships with busybox on every Raspberry Pi
    OS. With /bin/true as its script it configures nothing, which is what
    keeps this a measurement.
    """
    tries = max(2, min(4, seconds // 3))
    udhcpc = ["-i", interface, "-n", "-q", "-f",
              "-t", str(tries), "-T", "3", "-s", UDHCPC_SCRIPT]
    if shutil.which("busybox"):
        return ["busybox", "udhcpc", *udhcpc]
    if shutil.which("udhcpc"):
        return ["udhcpc", *udhcpc]
    return ["dhcpcd", "-4", "-T", "-t", str(seconds), interface]


def parse_lease(output):
    """The lease, from whichever client reported it.

    dhcpcd prints assignments, udhcpc writes a sentence. Both name the
    address and the server that offered it, which is the whole measurement.
    """
    lease = {}
    for line in output.splitlines():
        key, _, value = line.strip().partition("=")
        if key in ("new_ip_address", "new_dhcp_server_identifier",
                   "new_routers"):
            value = value.strip("'")
            if value:
                lease[key] = value
    if "new_ip_address" in lease:
        return lease

    found = UDHCPC_LEASE.search(output)
    if found:
        lease["new_ip_address"] = found.group("address")
        lease["new_dhcp_server_identifier"] = found.group("server")
    return lease


def run_dhcp(interface, budget, log=None):
    """DHCP in test mode: a complete cycle without setting the address.

    The client asks for a lease and reports it; nothing is put on the
    interface. The sensor thereby measures how long the DHCP server takes
    without leaving a route or an address on a test interface.
    """
    seconds = max(3, int(budget))
    command = dhcp_command(interface, seconds)

    started = time.monotonic()
    # A file, not a pipe: the children below inherit the handle and outlive
    # their parent, so a pipe would reach EOF only once they are gone - and
    # reading it would be the very thing that waits for them.
    #
    # stderr goes to the same place. It is where both clients say why they
    # gave up, and discarding it once cost a long afternoon: a client killed
    # before it sent anything looks, from stdout alone, exactly like a DHCP
    # server that stayed silent.
    with tempfile.TemporaryFile() as sink:
        try:
            # Its own session, so the whole group can be cleared out below.
            process = subprocess.Popen(
                command, stdout=sink, stderr=sink, start_new_session=True,
            )
        except OSError:
            raise Blocked("internal-error",
                          "Could not run %s" % os.path.basename(command[0]))
        try:
            process.wait(timeout=seconds + 5)
            timed_out = False
        except subprocess.TimeoutExpired:
            timed_out = True
        finally:
            clear_process_group(process)
        duration = int((time.monotonic() - started) * 1000)
        sink.seek(0)
        output = sink.read().decode("utf-8", "replace")
    if log is not None:
        log.dhcp(output)
        log.event("%s ended after %d ms%s" % (
            os.path.basename(command[0]), duration,
            " (timed out)" if timed_out
            else ", exit status %s" % process.returncode))

    if timed_out:
        raise Failed("dhcp-timeout", "no DHCP answer")

    # The lease decides, not the exit status: dhcpcd 9.4.1 on Bookworm
    # prints a complete lease in test mode and then segfaults while
    # cleaning up. The DHCP server has answered at that point, and that is
    # what the sensor measures.
    lease = parse_lease(output)
    if "new_ip_address" not in lease:
        raise dhcp_failure(command, process.returncode, output)
    return duration, lease


def gateway_target(lease):
    """Whom to ask whether the network carries traffic at all.

    The router the lease names, where it names one - that is the address
    a client would send everything else to. udhcpc reports no router on
    its output line, so the server that offered the lease stands in for
    it; in a branch network the two are the same box, and either way it
    is an address inside the network this run was placed in.
    """
    routers = lease.get("new_routers", "").split()
    if routers:
        return routers[0], "router"
    server = lease.get("new_dhcp_server_identifier", "")
    return (server, "dhcp server") if server else ("", "")


def reach_gateway(interface, address, target, budget):
    """Ask the gateway whether it answers, from the address just leased.

    An address alone proves that a DHCP server replied, nothing more. A
    client that is put in the wrong network can hold a perfectly valid
    lease and still reach nothing - seen on a probe whose guest network
    handed out addresses of the internal one and then dropped every
    packet. This is the step that tells the two apart.

    The lease was taken in test mode, so the interface carries nothing
    yet. A /32 plus a host route is the smallest thing that lets a packet
    out, and it needs no netmask - which udhcpc never reports. Both are
    removed again before this returns.
    """
    if not shutil.which("ping"):
        raise Blocked("ping-missing",
                      "This probe has no ping, so the gateway cannot be "
                      "tested; use --gateway none")
    seconds = max(2, min(10, int(budget)))
    added_address = added_route = False
    started = time.monotonic()
    try:
        added_address = subprocess.run(
            ["ip", "addr", "add", "%s/32" % address, "dev", interface],
            capture_output=True, timeout=10, check=False).returncode == 0
        added_route = subprocess.run(
            ["ip", "route", "add", "%s/32" % target, "dev", interface,
             "src", address],
            capture_output=True, timeout=10, check=False).returncode == 0
        if not added_address or not added_route:
            raise Blocked("internal-error",
                          "Could not put the leased address on %s"
                          % interface)
        done = subprocess.run(
            ["ping", "-c", "2", "-W", str(seconds), "-I", address, target],
            capture_output=True, timeout=seconds * 2 + 5, check=False,
            text=True)
    except subprocess.TimeoutExpired:
        raise Failed("gateway-unreachable", "gateway %s no reply" % target)
    finally:
        if added_route:
            subprocess.run(["ip", "route", "del", "%s/32" % target,
                            "dev", interface],
                           capture_output=True, timeout=10, check=False)
        if added_address:
            subprocess.run(["ip", "addr", "del", "%s/32" % address,
                            "dev", interface],
                           capture_output=True, timeout=10, check=False)
    if done.returncode != 0:
        raise Failed("gateway-unreachable", "gateway %s no reply" % target)
    found = PING_TIME.search(done.stdout)
    if found:
        return int(float(found.group(1)))
    return int((time.monotonic() - started) * 1000)


def dhcp_failure(command, returncode, output):
    """Say what went wrong, in the words of whoever knows.

    A client that died on a signal never asked anybody, so reporting the
    DHCP server as unresponsive would blame the wrong machine.
    """
    client = os.path.basename(command[0])
    if returncode is not None and returncode < 0:
        signalled = -returncode
        if signalled == signal.SIGSYS:
            return Blocked(
                "dhcp-client-broken",
                "%s was killed by its own syscall filter before it sent "
                "anything; this probe needs a different DHCP client" % client)
        return Blocked(
            "dhcp-client-broken",
            "%s was killed by signal %d before it reported a lease"
            % (client, signalled))
    detail = ""
    for line in reversed(output.splitlines()):
        line = line.strip()
        if line and "=" not in line:
            detail = line
            break
    if detail:
        return Failed("dhcp-timeout",
                      "The DHCP request was not answered (%s)" % detail)
    return Failed("dhcp-timeout", "The DHCP request was not answered")


def wait_for_connection(run, deadline):
    """Wait for association and a completed handshake.

    The timestamps come from wpa_supplicant's event stream. They separate
    the radio link (association) from the authentication - on enterprise
    networks exactly that separation is the interesting statement.
    """
    associated = None
    while time.monotonic() < deadline:
        cause = run.failure()
        if cause is not None:
            raise Failed(*cause)
        if associated is None:
            associated = run.seen("Associated with")
        if run.seen("CTRL-EVENT-CONNECTED") is not None:
            return associated, run.seen("CTRL-EVENT-CONNECTED")
        if run.process.poll() is not None:
            raise Blocked("internal-error", "wpa_supplicant stopped unexpectedly")
        time.sleep(0.05)

    cause = run.failure()
    if cause is not None:
        raise Failed(*cause)
    if associated is None:
        raise Failed("assoc-timeout", "no association")
    raise Failed("auth-timeout", "key negotiation timed out")


def unblock_radio(interface):
    """Lift a software block on this interface's radio.

    Raspberry Pi OS ships with the radio soft-blocked, and it stays that way
    until something uses Wi-Fi. On a probe that never did, "ip link set up"
    fails with "Operation not possible due to RF-kill" - an interface that
    exists, is wireless, is reserved, and still cannot be brought up.

    Lifting it is what the reservation is for: the interface was handed over
    to be switched on and off for tests, and nothing else uses it. A hardware
    block is a different matter - a physical switch is a decision somebody
    made with their hands, and no test overrules that.
    """
    directory = os.path.join("/sys/class/net", interface, "phy80211")
    try:
        entries = [name for name in os.listdir(directory)
                   if name.startswith("rfkill")]
    except OSError:
        # No rfkill for this radio: nothing blocks it, nothing to lift.
        return

    for name in entries:
        control = os.path.join(directory, name)
        if read_flag(os.path.join(control, "hard")):
            raise Blocked(
                "iface-blocked",
                "The radio of %s is blocked in hardware" % interface)
        if not read_flag(os.path.join(control, "soft")):
            continue
        try:
            with open(os.path.join(control, "soft"), "w") as handle:
                handle.write("0")
        except OSError:
            raise Blocked(
                "iface-blocked",
                "The radio of %s is blocked and could not be released"
                % interface)


# The radio's burnt-in address, asked of the driver. /sys only knows the
# address currently set, and after the first run under a network's own
# address that is no longer the radio's.
SIOCETHTOOL = 0x8946
ETHTOOL_GPERMADDR = 0x00000020
MAC_ADDRESS = re.compile(r"^[0-9a-f]{2}(?::[0-9a-f]{2}){5}$")


def permanent_mac(interface):
    """The address the radio was built with, or "" where it cannot be read."""
    request = array.array("B", struct.pack("II", ETHTOOL_GPERMADDR, 32)
                          + bytes(32))
    address, _ = request.buffer_info()
    # struct ifreq: the name, then a pointer, padded to the largest member
    # of its union. 40 bytes covers both 32- and 64-bit userlands.
    ifreq = struct.pack("16sP", interface.encode("ascii"), address)
    ifreq += bytes(40 - len(ifreq))
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
            fcntl.ioctl(probe.fileno(), SIOCETHTOOL, ifreq)
    except OSError:
        return ""
    size = struct.unpack_from("I", request, 4)[0]
    raw = bytes(request[8:8 + min(size, 32)])
    if len(raw) != 6 or raw == bytes(6):
        return ""
    return ":".join("%02x" % byte for byte in raw)


def network_mac(permanent, ssid):
    """The address this radio uses on one network.

    Derived, not random: the same radio gets the same address on the same
    network every time, so it keeps one DHCP lease and can be found again
    in the infrastructure. A different network gets a different address,
    which is the point - some gateways carry the VLAN of a station's last
    session over to its next one on another SSID (see ADR 0012). 02 marks
    it as locally administered and unicast, as phones do with their
    private address per network.
    """
    digest = hashlib.sha256(
        (permanent + "\n" + ssid).encode("utf-8")).digest()
    return ":".join("%02x" % byte for byte in (0x02,) + tuple(digest[:5]))


def client_mac(job, permanent):
    """The address a run signs in with, and what kind of address it is."""
    choice = job["mac"]
    if choice == "permanent":
        if not permanent:
            raise Blocked("mac-not-settable",
                          "%s does not report its own address" % job["interface"])
        return permanent, "permanent"
    if choice == "auto":
        if not permanent:
            raise Blocked("mac-not-settable",
                          "%s does not report its own address, so no "
                          "per-network address can be derived"
                          % job["interface"])
        return network_mac(permanent, job["ssid"]), "auto"
    return choice, "fixed"


def set_mac(interface, address):
    """Give the interface an address; it has to be down for that."""
    done = subprocess.run(["ip", "link", "set", interface, "address", address],
                          capture_output=True, text=True, timeout=10,
                          check=False)
    if done.returncode != 0:
        # Falling back to the old address would bring back exactly what
        # the per-network address exists to avoid, without anyone noticing.
        raise Blocked("mac-not-settable", "%s refused %s: %s" % (
            interface, address, done.stderr.strip() or "no reason given"))


def read_flag(path):
    try:
        with open(path, "r", encoding="ascii") as handle:
            return handle.read().strip() == "1"
    except OSError:
        return False


def perform_test(job, log=None):
    log = log if log is not None else RunLog()
    interface = job["interface"]
    check_interface(interface)

    reclaim_interface(interface)
    log.event("interface %s reclaimed" % interface)
    permanent = permanent_mac(interface)

    started = time.monotonic()
    deadline = started + job["timeout"]
    workdir = tempfile.mkdtemp(prefix=WORKDIR_PREFIX, dir=RUN_DIR)
    os.chmod(workdir, 0o700)
    run = SupplicantRun(interface, workdir)
    result = {
        "result": "ok",
        "code": "ok",
        "message": "",
        "timings": {},
        "details": {},
    }

    try:
        config_path = os.path.join(workdir, "wpa.conf")
        lines = ["ctrl_interface=%s" % workdir, "ap_scan=1"]
        lines.extend(build_network_block(job))
        with open(os.open(config_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                          0o600), "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")

        # Set on every run, the radio's own address included: the
        # interface keeps whatever the previous run left, and a run under
        # another network's address would bring back exactly the carry-over
        # this is about.
        mac, mac_kind = client_mac(job, permanent)
        set_mac(interface, mac)
        log.event("client address %s (%s)" % (mac, mac_kind))
        result["details"]["mac"] = mac
        result["details"]["mac_kind"] = mac_kind

        unblock_radio(interface)
        powered = subprocess.run(["ip", "link", "set", interface, "up"],
                                 capture_output=True, text=True, timeout=10,
                                 check=False)
        if powered.returncode != 0:
            # Naming what the kernel said beats "the test failed
            # unexpectedly": whoever reads this in PRTG is not on the probe
            # and cannot go looking.
            raise Blocked(
                "iface-down",
                "Could not power up %s: %s"
                % (interface, powered.stderr.strip() or "no reason given"))
        log.event("%s up" % interface)
        run.start(config_path)
        log.event("wpa_supplicant started, %s authentication" % job["auth"])
        associated, connected = wait_for_connection(run, deadline)
        log.event("connected")

        result["timings"]["assoc_ms"] = int((associated - started) * 1000)
        result["timings"]["auth_ms"] = int((connected - associated) * 1000)
        collect_link_details(run, result)

        if job["stage"] == "dhcp":
            before = link_fingerprint(run)
            log.event("DHCP started")
            duration, lease = run_dhcp(
                interface, deadline - time.monotonic(), log)
            after = link_fingerprint(run)
            # Reporting an address from a link that is no longer the one we
            # measured would be worse than reporting none: it reads like a
            # healthy result for a network this run never reached.
            if after != before or after[1] != "COMPLETED":
                raise Failed("assoc-lost", "link changed during DHCP")
            result["timings"]["dhcp_ms"] = duration
            result["details"]["ip_address"] = lease.get("new_ip_address", "")
            result["details"]["dhcp_server"] = lease.get(
                "new_dhcp_server_identifier", "")

            # An address alone is not a working network, so the gateway is
            # asked by default. "none" is for a network that drops ICMP,
            # where the question has no answer to give.
            if job["gateway"] != "none":
                if job["gateway"]:
                    target, kind = job["gateway"], "gateway"
                else:
                    target, kind = gateway_target(lease)
                if not target:
                    raise Failed("gateway-unreachable",
                                 "lease names no router or server")
                result["details"]["gateway"] = target
                result["details"]["gateway_kind"] = kind
                log.event("pinging %s %s" % (kind, target))
                result["timings"]["gateway_ms"] = reach_gateway(
                    interface, lease["new_ip_address"], target,
                    deadline - time.monotonic())
                log.event("%s answered in %d ms" % (
                    target, result["timings"]["gateway_ms"]))

        result["message"] = "OK"
    except Failed as failure:
        log.event("failed: %s" % failure.code)
        result["result"] = "failed"
        result["code"] = failure.code
        result["message"] = failure.message
        # A failure carries readings too: did association still happen,
        # and how strong was the signal? Exactly that distinguishes a
        # rejected sign-in from a too-weak radio link.
        associated = run.seen("Associated with")
        if associated is not None:
            result["timings"]["assoc_ms"] = int((associated - started) * 1000)
        collect_link_details(run, result)
    finally:
        # Always clean up: no running instance, no active test
        # interface, and no configuration with credentials under /run.
        run.stop()
        log.supplicant(run.lines())
        subprocess.run(["ip", "link", "set", interface, "down"],
                       capture_output=True, timeout=10, check=False)
        # Leave the radio as it was found.
        if permanent:
            subprocess.run(["ip", "link", "set", interface, "address",
                            permanent],
                           capture_output=True, timeout=10, check=False)
        shutil.rmtree(workdir, ignore_errors=True)
        log.event("cleaned up")

    result["timings"]["total_ms"] = int((time.monotonic() - started) * 1000)
    return result


def merge_profile(job):
    """Direct parameters take precedence; the profile fills the gaps."""
    if not job.get("profile"):
        return job
    profile = read_profile(job["profile"])
    for key, value in profile.items():
        if not job.get(key):
            job[key] = value
    return job


def validate_job(job):
    for field in STRING_FIELDS:
        value = job.get(field)
        if value is None:
            continue
        if not isinstance(value, str) or re.search(r"[\x00-\x08\x0a-\x1f]", value):
            raise Blocked("bad-request", "Invalid value for %s" % field)

    job["interface"] = job.get("interface") or "wlan0"
    job["auth"] = (job.get("auth") or "psk").lower()
    if job["auth"] not in AUTH_METHODS:
        raise Blocked("bad-request", "Unsupported authentication method")
    if not job.get("ssid"):
        raise Blocked("bad-request", "An SSID is required")
    if len(job["ssid"].encode("utf-8")) > 32:
        raise Blocked("bad-request", "The SSID is longer than 32 bytes")
    job["stage"] = job.get("stage") or "dhcp"
    if job["stage"] not in ("assoc", "dhcp"):
        raise Blocked("bad-request", "Unsupported test stage")
    # Empty means the lease decides, "none" switches the step off. Anything
    # else has to be an address: a name would have to be resolved first,
    # and a sensor that cannot reach its network cannot resolve anything.
    job["gateway"] = (job.get("gateway") or "").strip()
    if job["gateway"] and job["gateway"] != "none":
        try:
            socket.inet_aton(job["gateway"])
        except OSError:
            raise Blocked("bad-request",
                          "--gateway takes an IPv4 address or \"none\"")
    # auto is the default: one address per network, derived from the
    # radio's own (see network_mac). An explicit address is for networks
    # that only let in a known one - a DHCP reservation, an allowlist.
    job["mac"] = (job.get("mac") or "auto").strip().lower().replace("-", ":")
    if job["mac"] not in ("auto", "permanent"):
        if not MAC_ADDRESS.match(job["mac"]):
            raise Blocked("bad-request",
                          "--mac takes auto, permanent or an address "
                          "like 02:00:00:00:00:01")
        if int(job["mac"][:2], 16) & 1:
            raise Blocked("bad-request",
                          "--mac %s is a multicast address" % job["mac"])
    try:
        job["timeout"] = int(job.get("timeout") or 45)
    except (TypeError, ValueError):
        raise Blocked("bad-request", "Invalid timeout")
    if not 5 <= job["timeout"] <= 300:
        raise Blocked("bad-request", "The timeout must be 5 to 300 seconds")
    try:
        job["max_age"] = int(job.get("max_age") or 300)
    except (TypeError, ValueError):
        raise Blocked("bad-request", "Invalid maximum age")
    if not 30 <= job["max_age"] <= 3600:
        raise Blocked("bad-request",
                      "The maximum age must be 30 to 3600 seconds")
    return job


def lock_budget(timeout):
    """The share of a run's budget it may spend waiting for the radio."""
    return min(LOCK_WAIT_CEILING, max(1.0, timeout / 2.0))


def lock_interface(interface, wait=LOCK_WAIT_SECONDS):
    """Exclude parallel runs on the same interface.

    Two simultaneous tests would take the radio link away from each
    other and both report a wrong result.

    A run that overlaps its predecessor by a few seconds is ordinary when
    the scan interval sits anywhere near the time budget. Waiting that
    out is worth more than a sensor error on an interface that is about
    to be free - the error would say the test could not run, when all
    that happened was two runs meeting.
    """
    path = os.path.join(RUN_DIR, "prtg-sensor-wlan-auth.%s.lock" % interface)
    handle = open(os.open(path, os.O_WRONLY | os.O_CREAT, 0o600), "w")
    deadline = time.monotonic() + max(0.0, wait)
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except OSError:
            if time.monotonic() >= deadline:
                handle.close()
                raise Blocked(
                    "iface-busy",
                    "Another test is still running on %s after %.0f "
                    "seconds" % (interface, wait))
            time.sleep(0.25)


def owns_interface(command, interface):
    """Does this process belong to a test run on this interface?

    NetworkManager runs a supplicant of its own. It never carries a
    configuration below RUN_DIR, which is what tells the two apart - and
    killing the wrong one would take the host off the network.
    """
    tokens = command.replace("\0", " ").split()
    if not tokens:
        return False
    program = os.path.basename(tokens[0].rstrip(":"))
    if program == "wpa_supplicant":
        return WORKDIR_PREFIX in command and interface in tokens
    if program == "dhcpcd":
        return interface in tokens
    return False


def reclaim_interface(interface):
    """Take the interface back before the test starts.

    The lock keeps concurrent runs apart, but nothing keeps the remains
    of a run that never finished: a supplicant left by a crash, a dhcpcd
    that outlived its parent, a work directory from before a reboot.
    They belong to nobody, they hold the radio, and they would fail the
    next test on an interface that is nominally free.

    This runs behind the lock. Ahead of it, a waiting run would tear the
    interface out from under the one that legitimately holds it.
    """
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % entry, "rb") as handle:
                command = handle.read().decode("utf-8", "replace")
        except OSError:
            # The process ended while we were looking at it.
            continue
        if not owns_interface(command, interface):
            continue
        for number in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.kill(int(entry), number)
            except OSError:
                break
            if number is signal.SIGTERM:
                time.sleep(0.5)

    for name in os.listdir(RUN_DIR):
        stale = os.path.join(RUN_DIR, name)
        if name.startswith(WORKDIR_PREFIX) and os.path.isdir(stale):
            shutil.rmtree(stale, ignore_errors=True)

    # Whatever the remains left on the interface goes too: an address or
    # a route over the network under test has no business being there.
    for arguments in (["addr", "flush", "dev", interface],
                      ["link", "set", interface, "down"]):
        subprocess.run(["ip", *arguments], capture_output=True, timeout=10,
                       check=False)


def job_ttl(max_age):
    """How long a job survives without anybody asking for it.

    Three missed requests are not a deleted sensor: a probe that is
    restarting, or a scan that overran, must not cost a job its
    registration. Much longer than that and the radio would go on
    measuring for a sensor somebody removed days ago.
    """
    return max(JOB_TTL_MINIMUM, JOB_TTL_FACTOR * max_age)


def job_identity(job):
    """A stable name for a job, derived from everything it does.

    The credentials are part of it on purpose. A changed password is then
    a different job: the old one stops being asked for and expires,
    rather than the scheduler going on measuring with credentials nobody
    uses any more. What is deliberately not part of it is max_age - a
    sensor may ask for a different freshness without losing its history.
    """
    material = json.dumps([job.get(field) for field in IDENTITY_FIELDS],
                          sort_keys=True)
    return hashlib.sha256(material.encode("utf-8")).hexdigest()


def round_budget(jobs):
    """The time a round over every job on this radio can take.

    The worst case, deliberately: a failing sign-in uses its whole time
    budget, and it is the failing ones that have to stay measurable. The
    waiting counts too - a test run by hand on the probe can hold the
    radio while the scheduler waits out its lock, and a round that does
    not allow for it is one a measured age can overrun.
    """
    return sum(entry["job"]["timeout"] + lock_budget(entry["job"]["timeout"])
               for entry in jobs.values())


def refresh_threshold(max_age, jobs):
    """The age at which a result has to be renewed to stay in time."""
    return max(REFRESH_FLOOR_SECONDS, max_age - round_budget(jobs))


def min_max_age(jobs):
    """The smallest max_age this radio can keep, a round plus the floor.

    Below it the renewal would have to start before the floor allows, so
    results reach the sensor older than it asked for. The sensor compares
    its setting against this number and names it with failure code 13.
    """
    return round_budget(jobs) + REFRESH_FLOOR_SECONDS


class RunLog:
    """What one run produced, kept for its sensor log record.

    The supplicant's lines, the DHCP client's output and this helper's own
    account of the run - the lock, the stages, the cause it ended on. It
    lives as long as the run and is handed over once. Nothing of it goes to
    the journal, where it would outlive the run with the secrets in it.
    """

    def __init__(self):
        self.started = time.monotonic()
        self.events = []
        self.supplicant_lines = []
        self.dhcp_lines = []

    def _stamp(self, moment):
        return "+%.3fs" % max(0.0, moment - self.started)

    def event(self, text):
        self.events.append("%s %s" % (self._stamp(time.monotonic()), text))

    def supplicant(self, events):
        self.supplicant_lines.extend(
            "%s %s" % (self._stamp(stamp), line) for stamp, line in events)

    def dhcp(self, output):
        self.dhcp_lines.extend(
            line for line in output.splitlines() if line.strip())


# The body keys of a record are named for the operator who reads them, and
# none of them contains a word the platform masks in its own logs.
RECORD_DETAILS = (
    ("bssid", "bssid"), ("client_mac", "mac"), ("client_mac_kind", "mac_kind"),
    ("ip_address", "ip_address"), ("dhcp_server", "dhcp_server"),
    ("gateway", "gateway"), ("gateway_kind", "gateway_kind"),
    ("frequency_mhz", "frequency_mhz"), ("signal_dbm", "signal_dbm"),
)
RECORD_TIMINGS = ("assoc_ms", "auth_ms", "dhcp_ms", "gateway_ms", "total_ms")


def record_result(result):
    """A failed sign-in and a run that could not happen are both errors in
    the log; the code tells them apart."""
    return "ok" if result.get("result") == "ok" else "error"


def build_record(job, result, log):
    details = result.get("details") or {}
    timings = result.get("timings") or {}
    body = {
        # The configured network, not the one the link reported: a run that
        # never associated has no reading, and the log is filtered by it.
        "ssid": job.get("ssid") or "",
        "auth": job.get("auth") or "",
        "interface": job.get("interface") or "",
        "stage": job.get("stage") or "",
        "identity": job.get("identity") or "",
    }
    if job.get("profile"):
        body["profile"] = job["profile"]
    for key, source in RECORD_DETAILS:
        if details.get(source) not in (None, ""):
            body[key] = details[source]
    body["timings"] = {key: timings[key] for key in RECORD_TIMINGS
                       if key in timings}
    body["supplicant"] = list(log.supplicant_lines)
    body["dhcp"] = list(log.dhcp_lines)
    body["events"] = list(log.events)
    return {
        "id": str(uuid.uuid4()),
        "sensor": "wlan-auth",
        "job": job_identity(job)[:12],
        "time": datetime.datetime.now(datetime.timezone.utc).isoformat(
            timespec="seconds"),
        "result": record_result(result),
        "code": result.get("code") or "",
        "summary": result.get("message") or "",
        "body": body,
    }


# Below this a value cannot be blanked without mangling the text beyond
# reading - "ab" would blank every ab. A string holding one is dropped whole
# instead, as aruba-uplink does with its messages.
SHORTEST_MASKABLE = 4
SECRET_FIELDS = ("psk", "password", "private_key_passwd")
REDACTED = "..."
DROPPED = "[removed: held a secret too short to mask]"


def secret_patterns(job):
    """Every form a credential of this job can take in raw output.

    The value itself, the hex form build_network_block writes into the
    configuration, and for a passphrase the key derived from it - which is
    a secret in its own right, since it signs in as well as the passphrase
    does. Hex is matched in either case: tools print it both ways.
    """
    patterns = []
    for field in SECRET_FIELDS:
        value = job.get(field)
        if not value:
            continue
        patterns.append((value, re.compile(re.escape(value))))
        patterns.append((value, re.compile(re.escape(hex_value(value)),
                                           re.IGNORECASE)))
        if field == "psk" and job.get("ssid"):
            derived = wpa_psk(value, job["ssid"])
            patterns.append((derived, re.compile(derived, re.IGNORECASE)))
    return patterns


def redact_text(text, patterns):
    for value, pattern in patterns:
        if not pattern.search(text):
            continue
        if len(value) < SHORTEST_MASKABLE:
            return DROPPED
        text = pattern.sub(REDACTED, text)
    return text


def redact_record(record, job):
    """The record without the job's secrets, wherever they appear.

    The identity, addresses and certificate subjects stay: they are what a
    failed sign-in is looked up by in the RADIUS and gateway logs.
    """
    patterns = secret_patterns(job)

    def walk(value):
        if isinstance(value, str):
            return redact_text(value, patterns)
        if isinstance(value, list):
            cleaned = [walk(entry) for entry in value]
            return [entry for entry in cleaned if entry != DROPPED]
        if isinstance(value, dict):
            return {key: walk(entry) for key, entry in value.items()}
        return value

    return walk(record)


def shorten(lines, keep):
    """The first and the last lines, and how many were left out between.

    The start of a run is where the trouble starts, the end is where it
    ended; the middle of a scan loop repeats itself.
    """
    if len(lines) <= keep:
        return lines
    head = max(1, keep // 2)
    tail = max(1, keep - head)
    return (lines[:head]
            + ["[%d lines left out]" % (len(lines) - head - tail)]
            + lines[-tail:])


def fit_record(record):
    """The record shortened until the service takes it as one line."""
    body = record["body"]
    original = {}
    for field in RAW_FIELDS:
        original[field] = [line if len(line) <= RECORD_LINE_LENGTH
                           else line[:RECORD_LINE_LENGTH] + " [cut]"
                           for line in body.get(field, [])]
        body[field] = original[field]
    keep = {field: len(lines) for field, lines in original.items()}
    while len(json.dumps(record, separators=(",", ":"))) > RECORD_BUDGET:
        field = max(RAW_FIELDS, key=lambda name: keep[name])
        if keep[field] <= 2:
            break
        keep[field] //= 2
        body[field] = shorten(original[field], keep[field])
    return record


def send_record(record):
    """Hand one record to the return channel service.

    True once the service has it on disk, False for every other outcome -
    which nobody waits on.
    """
    line = (json.dumps(record, separators=(",", ":")) + "\n").encode("utf-8")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(RETURN_CHANNEL_TIMEOUT)
            connection.connect(RETURN_CHANNEL_SOCKET)
            connection.sendall(line)
            reply = bytearray()
            while b"\n" not in reply and len(reply) < 4096:
                chunk = connection.recv(4096)
                if not chunk:
                    break
                reply.extend(chunk)
        answer = json.loads(reply.decode("utf-8"))
    except (OSError, ValueError):
        return False
    return isinstance(answer, dict) and answer.get("ok") is True


def web_url():
    """The interface address from channel.env, or None."""
    try:
        with open(RETURN_CHANNEL_CONFIG, encoding="utf-8") as stream:
            for line in stream:
                key, _, value = line.strip().partition("=")
                if key == "WEB_URL":
                    value = value.strip().strip("\"'")
                    if (len(value) <= WEB_URL_LENGTH
                            and WEB_URL_PATTERN.fullmatch(value)):
                        return value
                    return None
    except (OSError, UnicodeDecodeError):
        pass
    return None


def report_run(job, result, log):
    """Write the run to the sensor log and point the result at the record.

    Nothing in here may change the measurement: a missing service, a full
    buffer or a bug in building the record cost the record, not the result
    PRTG gets.
    """
    try:
        record = fit_record(redact_record(build_record(job, result, log),
                                          job))
        result.pop("record_link", None)
        if send_record(record):
            result["record_id"] = record["id"]
            base = web_url()
            if base:
                result["record_link"] = base + RUN_LINK_PATH % record["id"]
    except Exception:
        # Never printed, like every other exception here: it could carry
        # what the record was about to hide.
        pass
    return result


class Scheduler:
    """Measures the registered jobs one after another on the one radio.

    PRTG knows a scanning interval per sensor and nothing about the other
    sensors on the same device, so it cannot keep two of them off one
    radio. This is the only place that sees every job, which is why the
    order is decided here instead of by whoever asked first.

    Everything it knows lives in this object and nowhere else. A restart
    therefore forgets the jobs and the credentials with them, and the
    next request registers them again - one cycle lost, nothing to clean
    up, and no file holding a password.
    """

    def __init__(self):
        self._guard = threading.Lock()
        self._jobs = {}
        self._wake = threading.Event()

    def collect(self, job, max_age):
        """Register or renew a job, and answer with what is known now."""
        identity = job_identity(job)
        now = time.monotonic()
        with self._guard:
            entry = self._jobs.get(identity)
            if entry is None:
                if len(self._jobs) >= MAX_JOBS:
                    raise Blocked(
                        "too-many-jobs",
                        "This helper already measures %d networks on this "
                        "probe" % len(self._jobs))
                entry = {"job": job, "result": None, "measured": None}
                self._jobs[identity] = entry
            entry["max_age"] = max_age
            entry["asked"] = now
            answer = self._answer(entry, now)
        # A job nobody has measured yet should not wait out the idle sleep.
        self._wake.set()
        return answer

    def _answer(self, entry, now):
        # Every answer carries what a round over this radio costs. A
        # sensor sets its own freshness and cannot see the other sensors
        # sharing the interface, so a value below the round is one no
        # schedule can ever meet. This is the only side that knows the
        # round, which is why it reports it with the result.
        shared = {"round_budget": round_budget(self._jobs),
                  "min_max_age": min_max_age(self._jobs),
                  "job_count": len(self._jobs)}
        if entry["result"] is None:
            answer = {"result": "pending", "code": "not-measured",
                      "message": "Registered on this probe, waiting for the "
                                 "first measurement",
                      "timings": {}, "details": {}, "age": None}
        else:
            answer = dict(entry["result"])
            answer["age"] = round(now - entry["measured"], 1)
        answer.update(shared)
        return answer

    def _due(self):
        """The job whose result has aged furthest beyond its share.

        Measuring the age against each job's own max_age is what shares
        the radio out evenly. A job that wants a fresh value every minute
        and one that is content with five are treated the same relative
        to what they asked for, and where the radio cannot serve them all
        they age together instead of one of them starving.
        """
        now = time.monotonic()
        best = None
        best_ratio = 0.0
        with self._guard:
            for identity, entry in list(self._jobs.items()):
                if now - entry["asked"] > job_ttl(entry["max_age"]):
                    # Nobody has asked for a long time: the sensor behind
                    # this job was deleted or paused in PRTG.
                    del self._jobs[identity]
                    continue
                if entry["measured"] is None:
                    return entry
                threshold = refresh_threshold(entry["max_age"], self._jobs)
                if threshold <= 0:
                    continue
                ratio = (now - entry["measured"]) / threshold
                if ratio > best_ratio:
                    best = entry
                    best_ratio = ratio
        return best if best_ratio >= 1.0 else None

    def snapshot(self):
        """What this service is measuring, for diagnosis on the probe.

        Without it nothing about a running schedule is observable: the
        probe writes no sensor output to the journal, so the only other
        way to tell a job that expired from one that was never registered
        is to wait and guess. Credentials are deliberately absent - the
        truncated identity is enough to tell two jobs apart.
        """
        now = time.monotonic()
        jobs = []
        with self._guard:
            budget = round_budget(self._jobs)
            for identity, entry in sorted(self._jobs.items()):
                result = entry["result"] or {}
                age = entry["measured"]
                jobs.append({
                    "job": identity[:12],
                    "interface": entry["job"]["interface"],
                    "ssid": entry["job"].get("ssid") or "",
                    "stage": entry["job"]["stage"],
                    "timeout": entry["job"]["timeout"],
                    "max_age": entry["max_age"],
                    "age": None if age is None else round(now - age, 1),
                    "renew_at": round(
                        refresh_threshold(entry["max_age"], self._jobs), 1),
                    "asked_ago": round(now - entry["asked"], 1),
                    "expires_in": round(
                        job_ttl(entry["max_age"]) - (now - entry["asked"]), 1),
                    "result": result.get("result", ""),
                    "code": result.get("code", ""),
                    # Which network answered is the question a probe with
                    # several SSIDs on one radio is debugged with, and the
                    # address alone does not answer it: a lease can come
                    # from the wrong VLAN and still look healthy. The
                    # DHCP server says who handed it out.
                    "ip": (result.get("details") or {}).get(
                        "ip_address", ""),
                    "dhcp": (result.get("details") or {}).get(
                        "dhcp_server", ""),
                    # The address the run signed in with - the key to find
                    # it in the gateway's user table and in Central.
                    "mac": (result.get("details") or {}).get("mac", ""),
                })
        return {"result": "ok", "code": "ok",
                "message": "%d job(s), %d s of radio time per round"
                           % (len(jobs), budget),
                "round_budget": budget, "jobs": jobs,
                "timings": {}, "details": {}}

    def _measure(self, job, log):
        """One measurement, behind the interface lock.

        The lock no longer keeps two sensors apart - nothing else in this
        process measures. It keeps this thread and a test somebody runs
        by hand on the probe apart, the one case left where two
        wpa_supplicant instances could meet on one interface.
        """
        handle = None
        try:
            handle = lock_interface(job["interface"],
                                    lock_budget(job["timeout"]))
            log.event("interface %s locked" % job["interface"])
            return perform_test(job, log)
        except Blocked as blocked:
            log.event("blocked: %s" % blocked.code)
            if blocked.code == "iface-busy":
                # Somebody is testing by hand. Leave the stored result
                # alone and come back on the next pass: a measurement
                # that did not happen must not overwrite one that did.
                return None
            return {"result": "blocked", "code": blocked.code,
                    "message": blocked.message, "timings": {}, "details": {}}
        except Exception:
            # The exception is never printed - it could carry credentials.
            log.event("blocked: internal-error")
            return {"result": "blocked", "code": "internal-error",
                    "message": "The test failed unexpectedly",
                    "timings": {}, "details": {}}
        finally:
            if handle is not None:
                handle.close()

    def measure(self, entry):
        """One pass for one job: measure, log the run, keep the result."""
        log = RunLog()
        result = self._measure(entry["job"], log)
        if result is None:
            # Nothing was measured, so there is no run to log either.
            return
        report_run(entry["job"], result, log)
        with self._guard:
            entry["result"] = result
            entry["measured"] = time.monotonic()

    def run(self):
        while True:
            entry = self._due()
            if entry is None:
                self._wake.wait(SCHEDULER_IDLE_SECONDS)
                self._wake.clear()
                continue
            self.measure(entry)
            # Rest whatever the outcome: a run that did not get the radio
            # is no reason to try again within the same second.
            time.sleep(RADIO_PAUSE_SECONDS)


SCHEDULER = Scheduler()


def ping_answer():
    """Self-test of the permission chain, for the deployment.

    Does the sensor script reach this helper at all, and can the test it
    would run find its tools? The second half is what a deployment hangs
    on. It is the one moment where a missing tool can still be reported
    as a failed deployment that restores the previous state - after that
    it would only surface as a sensor error on the first scan, hours
    later and on somebody else's screen.
    """
    missing = [name for name in REQUIRED_PROGRAMS
               if shutil.which(name) is None]
    if not any(shutil.which(name) for name in DHCP_PROGRAMS):
        missing.append(" or ".join(DHCP_PROGRAMS))
    if missing:
        return {"result": "blocked", "code": "tool-missing",
                "message": "Not installed on this probe: %s"
                           % ", ".join(missing),
                "timings": {}, "details": {}}
    return {"result": "ok", "code": "ok", "message": "helper reachable",
            "timings": {}, "details": {}}


def handle_request(payload):
    """One request, one answer. This never raises."""
    try:
        job = json.loads(payload or "{}")
        if not isinstance(job, dict):
            raise ValueError
    except ValueError:
        return {"result": "blocked", "code": "bad-request",
                "message": "The request could not be parsed",
                "timings": {}, "details": {}}

    try:
        action = job.get("action")
        if action == "ping":
            return ping_answer()
        if action == "status":
            # Read-only, and the only window into a running schedule.
            return SCHEDULER.snapshot()
        job = validate_job(merge_profile(job))
        if action == "collect":
            return SCHEDULER.collect(job, job["max_age"])
        # "test" measures on the spot. The sensor script never asks for
        # it; whoever debugs on the probe does, and then wants the radio
        # used rather than a stored value explained to them. It is logged
        # like a scheduled run, because that is where they will look.
        log = RunLog()
        result = SCHEDULER._measure(job, log)
        if result is None:
            # The radio is busy with a scheduled run; say so instead of
            # logging a run that never happened.
            return {"result": "blocked", "code": "iface-busy",
                    "message": "Another test is still running on %s "
                               "after %.0f seconds"
                               % (job["interface"],
                                  lock_budget(job["timeout"])),
                    "timings": {}, "details": {}}
        return report_run(job, result, log)
    except Blocked as blocked:
        return {"result": "blocked", "code": blocked.code,
                "message": blocked.message, "timings": {}, "details": {}}
    except Exception:
        # The exception is never printed - it could carry credentials.
        return {"result": "blocked", "code": "internal-error",
                "message": "The test failed unexpectedly",
                "timings": {}, "details": {}}


def listen_socket():
    """The listening socket systemd handed over, or None.

    sd_listen_fds without the library: systemd puts the number of
    descriptors in LISTEN_FDS, names the process they belong to in
    LISTEN_PID, and starts them at descriptor 3. Without them this
    program is the filter on stdin and stdout it has always been, which
    is how it is called by hand on the probe.
    """
    if os.environ.get("LISTEN_PID") != str(os.getpid()):
        return None
    try:
        count = int(os.environ.get("LISTEN_FDS", "0"))
    except ValueError:
        return None
    if count < 1:
        return None
    return socket.socket(fileno=3, family=socket.AF_UNIX,
                         type=socket.SOCK_STREAM)


def serve_connection(connection, slots):
    try:
        connection.settimeout(CONNECTION_TIMEOUT)
        payload = bytearray()
        while len(payload) <= REQUEST_LIMIT:
            chunk = connection.recv(65536)
            if not chunk:
                break
            payload.extend(chunk)
        answer = handle_request(payload.decode("utf-8", "replace"))
        connection.sendall((json.dumps(answer) + "\n").encode("utf-8"))
    except OSError:
        # A client that hung up mid-answer is not this service's problem.
        pass
    finally:
        connection.close()
        slots.release()


def serve_forever(listener):
    """Answer requests while the scheduler measures in the background."""
    threading.Thread(target=SCHEDULER.run, daemon=True).start()
    slots = threading.Semaphore(MAX_CONNECTIONS)
    while True:
        slots.acquire()
        try:
            connection, _ = listener.accept()
        except OSError:
            slots.release()
            continue
        threading.Thread(target=serve_connection, args=(connection, slots),
                         daemon=True).start()


def main():
    # The deployment asks which systemd unit shape this helper needs before
    # it writes one. Answered here because this program is the only thing
    # that knows: it schedules the radio, so it has to outlive the
    # connection that asked.
    if sys.argv[1:] == ["--unit-mode"]:
        print("daemon")
        return

    if os.geteuid() != 0:
        emit({"result": "blocked", "code": "no-privileges",
              "message": "This helper must run as root"})

    listener = listen_socket()
    if listener is not None:
        serve_forever(listener)
        return

    emit(handle_request(sys.stdin.read(REQUEST_LIMIT)))


def emit(result):
    print(json.dumps(result))
    sys.stdout.flush()
    # The calling sensor script evaluates only the JSON.
    os._exit(0)


if __name__ == "__main__":
    main()
