# Template for a credential profile of the "wlan-auth" sensor.
#
# On the probe the file lives at
# /etc/prtg-nats/sensors/wlan-auth/profiles/NAME.env with mode 0600, owned
# by root. Only the privileged helper reads it; the sensor script knows the
# profile name alone. That way no password sits in the PRTG sensor
# configuration.
#
# It is deployed with:
#   ./prtg-nats sensor profile wlan-auth USER NAME --from-file FILE
#
# or filled in from the web interface, which writes the same file and
# uploads the certificates along with it. The keys are declared in
# parameters.json beside the manifest; this template is the same list for
# whoever writes the file by hand.
#
# Parameters given directly on the sensor take precedence over the values
# here.

# psk, peap or eap-tls
AUTH=peap

SSID=Corporate

# Restrict the test to one access point
# BSSID=

# Only with AUTH=psk
# PSK=

# With AUTH=peap and AUTH=eap-tls alike: the RADIUS server is asked about
# a user either way, and the sensor refuses the run without this.
IDENTITY=svc-wlan-monitor

# Only with AUTH=peap
PASSWORD=
# The outer identity, if the RADIUS server expects one
# ANONYMOUS_IDENTITY=

# Only with AUTH=eap-tls. The passphrase belongs to the key file; leave it
# out for a key exported without one. It is not a user password - the
# certificate is what proves the identity.
# CLIENT_CERT=/etc/prtg-nats/sensors/wlan-auth/certs/probe.pem
# PRIVATE_KEY=/etc/prtg-nats/sensors/wlan-auth/certs/probe-key.pem
# PRIVATE_KEY_PASSWD=

# Verification of the RADIUS server certificate. Without the authority the
# sensor refuses the run, unless --no-verify-server is given in PRTG.
CA_CERT=/etc/prtg-nats/sensors/wlan-auth/certs/radius-ca.pem
DOMAIN_SUFFIX_MATCH=example.com
