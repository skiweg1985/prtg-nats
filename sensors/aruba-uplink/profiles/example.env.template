# Template for a credential profile of the "aruba-uplink" sensor.
#
# On the probe the file lives at
# /etc/prtg-nats/sensors/aruba-uplink/profiles/NAME.env. This sensor has no
# privileged helper, so the file belongs to the group of the service user
# and the sensor reads it itself. The PRTG sensor configuration only ever
# carries the profile name - no password sits in it.
#
# It is deployed with:
#   ./prtg-nats sensor profile aruba-uplink USER NAME --from-file FILE
#
# One profile per gateway. The name is what "--profile" refers to.

# Address of the gateway. A host name works as well, as long as the probe
# resolves it.
ARUBA_HOST=192.0.2.1

# A read-only account. The sensor never writes, and an account that cannot
# write is the one thing that limits the damage if the file ever leaks.
ARUBA_USER=monitoring

ARUBA_PASSWORD=

# SHA-256 fingerprint of the gateway certificate, lower case hex, with or
# without colons.
#
# The gateway presents a self-signed certificate, so there is no authority
# to check it against. Pinning the fingerprint is the honest answer:
# without it the sensor could not tell the gateway apart from anything else
# that answers on that address. Leave it empty for the first run - the
# sensor then refuses to measure and reports the fingerprint it saw, so
# setting it up is a copy rather than a guess.
ARUBA_CERT_SHA256=
