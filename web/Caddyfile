# The reverse proxy in front of the management platform.
#
# Three listeners. The HTTPS one serves the interface and the API. The probe
# channel takes reports from probes and admits nobody without a client
# certificate (ADR 0013). The plain-HTTP one serves exactly two files: the CA a
# probe fetches before it trusts anything, and the health CGI the PRTG core
# polls. That last listener is what the separate busybox server used to be.
#
# The backend never speaks TLS and never listens on a routable address; this
# file is the only thing an operator has to open up.

{
	auto_https disable_redirects
	admin off

	# A client that connects by address sends no server name - IP addresses
	# are never sent as SNI - and TLS policies are chosen by server name.
	# Without this, such a handshake fell through to a policy without client
	# auth on the probe channel, and the request carried no verified identity
	# at all. With it, a nameless handshake is treated as one for the bind
	# address, which every site here answers under.
	default_sni {$WEB_BIND_IP}

	# Client auth also makes Caddy require the Host header to match the
	# server name, which a nameless handshake can never do: every request by
	# address got 421. The check keeps a certificate admitted for one site
	# from being used on another behind the same listener. This listener
	# carries only the probe channel, with one client_auth policy for both its
	# names, so there is nothing to cross over to.
	servers {$WEB_BIND_IP}:{$PROBE_CHANNEL_PORT} {
		strict_sni_host insecure_off
	}
}

# The interface answers on the name and on the bare host address: an internal
# installation often has no DNS entry yet, and a browser pointed at the IP
# would otherwise be refused at the TLS handshake with nothing to explain why.
https://{$WEB_FQDN}:{$WEB_HTTPS_PORT}, https://{$WEB_BIND_IP}:{$WEB_HTTPS_PORT} {
	# Caddy shares the host network namespace; without this it would listen on
	# every host address instead of the one the stack publishes.
	bind {$WEB_BIND_IP}

	# Issued by the installation's own CA, not by Caddy's internal one. That
	# is deliberate: an operator who compared the CA fingerprint once trusts
	# the interface, the NATS server and the enrolment channel with that
	# single decision - and a probe can fetch over HTTPS with --cacert
	# instead of --insecure. Both SANs above are in the certificate.
	tls /etc/caddy/certs/web.pem /etc/caddy/certs/web-key.pem

	encode gzip zstd

	# The probe identity is the probe channel's business alone. Nothing on
	# this site sets it, so whatever a browser sends under that name is
	# dropped before it can reach the backend.
	request_header -X-Probe-Identity

	# Never forwarded from here: the probe routes trust X-Probe-Identity, and
	# only the probe channel below has verified a certificate behind it. A
	# probe pointed at the wrong port gets a plain 404 rather than the
	# interface's front page.
	handle /probe/* {
		respond 404
	}

	# The API. Loopback because web-api joins the host network namespace.
	handle /api/* {
		reverse_proxy 127.0.0.1:8100 {
			# Server-sent events must not be buffered or the live job log
			# arrives all at once when the job is already over.
			flush_interval -1
		}
	}

	# Enrolment. Reached by a host that has no session and no identity yet,
	# carrying a single-use invitation token. Same backend, no cookie.
	#
	# Rewritten rather than exposed at its API path on purpose: this URL is
	# typed into a one-liner and lands in runbooks, so it must not carry the
	# API version. /api/v1 is an implementation detail of the backend; /enroll
	# is the contract with the host.
	handle /enroll/* {
		rewrite * /api/v1{uri}
		reverse_proxy 127.0.0.1:8100
	}

	handle /health {
		reverse_proxy 127.0.0.1:8100
	}

	# Everything else is the single-page interface.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	header {
		# The interface loads nothing from anywhere else, so the policy can be
		# this strict. connect-src keeps 'self' for the event stream.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# The probe channel (ADR 0013). Its own port because the TLS handshake here
# demands a client certificate signed by the probe CA, which no browser has;
# the interface must not ask for one. Same server certificate as the
# interface, so a probe verifies this end with the CA it already trusts.
#
# Both names, like the interface: a probe that cannot resolve the name is
# given the address instead.
https://{$WEB_FQDN}:{$PROBE_CHANNEL_PORT}, https://{$WEB_BIND_IP}:{$PROBE_CHANNEL_PORT} {
	bind {$WEB_BIND_IP}

	tls /etc/caddy/certs/web.pem /etc/caddy/certs/web-key.pem {
		client_auth {
			# A handshake without a certificate from this CA fails before
			# any request exists. Whether the probe is still enrolled is the
			# backend's call, on every request: a retired probe keeps a
			# valid certificate until it expires.
			mode require_and_verify
			trust_pool file /etc/caddy/certs/probe-ca.pem
		}
	}

	# Only the probe routes. The interface and its API are not reachable on
	# this port, so a probe certificate never opens anything but these.
	handle /probe/v1/* {
		reverse_proxy 127.0.0.1:8100 {
			# The verified certificate's subject, which the probe CA issues
			# as CN=<NATS username> and nothing else. Setting the header
			# replaces whatever the client sent under that name.
			header_up X-Probe-Identity {http.request.tls.client.subject}
		}
	}

	handle {
		respond 404
	}

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Plain HTTP, on purpose and only here. A probe has to obtain the CA before it
# can verify anything served with it; the fingerprint is compared out of band,
# exactly as install-mpp.sh already does with --ca-sha256. Nothing else is
# served here - everything else is sent on to the interface over TLS.
#
# No host matcher: the two files here are public and identical whatever name
# the request arrives under, and an installation reached through an alias or a
# CNAME would otherwise fail to fetch the CA for no reason. A host matcher
# would also leave every non-matching request answering an empty 200, which
# reads like something worked.
http://:{$CA_HTTP_PORT} {
	bind {$WEB_BIND_IP}

	root * /srv/public

	handle /nats-ca.pem {
		file_server
	}

	handle /cgi-bin/nats-health {
		file_server
	}

	# Somebody who types the bare host name lands here, on the listener that
	# only carries two files. Sending them to the interface is the whole
	# point: a 404 on the front page reads like nothing is installed, and
	# nothing here tells them the interface is one port over.
	#
	# {host} rather than the configured name, so a request that arrived on
	# the bare address stays on the address - the certificate covers both,
	# and an installation without a DNS entry yet would otherwise be
	# redirected to a name the browser cannot resolve. The port is always
	# written out; a browser drops it again from the address bar when it is
	# the default one.
	handle {
		redir https://{host}:{$WEB_HTTPS_PORT}{uri}
	}

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format console
	}
}
