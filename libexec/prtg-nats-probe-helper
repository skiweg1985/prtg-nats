#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

STATE_DIR="/var/lib/prtg-nats-probe-state"
TRANSACTION_DIR="${STATE_DIR}/transactions"
SENSOR_TRANSACTION_STATE_DIR="${STATE_DIR}/sensor-transactions"
SENSOR_COMMIT_TOMBSTONE_DIR="${SENSOR_TRANSACTION_STATE_DIR}/committed"
MAXIMUM_SENSOR_COMMIT_TOMBSTONES=1024
MPP_SERVICE="prtg.mpprobe.service"
MPP_CONFIG_DIR="/etc/paessler/mpprobe"
CERT_DIR="${MPP_CONFIG_DIR}/certs"
CA_PATH="${CERT_DIR}/nats-docker-ca.pem"
TOML_CONFIG="${MPP_CONFIG_DIR}/config.toml"
YAML_CONFIG="${MPP_CONFIG_DIR}/config.yaml"
MPP_PACKAGE="prtgmpprobe"
# What install-mpp.sh registers to reach the package. The uninstall takes the
# same paths back, so a removed probe leaves no repository behind that would
# keep offering the package on the next apt update.
MPP_REPOSITORY_FILES=(
  "/etc/apt/sources.list.d/paessler.sources"
  "/usr/share/keyrings/paessler-archive-keyring.asc"
  "/etc/yum.repos.d/paessler-prtg.repo"
)
MAXIMUM_INPUT_BYTES=65536
# Sensor scripts are larger than a configuration, but they stay text.
MAXIMUM_SENSOR_BYTES=262144
# This file is around 50 KB; the limit leaves room to grow without inviting
# anyone to push a disk image through the channel.
MAXIMUM_HELPER_BYTES=524288
# One signed executable, base64 encoded. The decoded limit is checked again
# before anything is made executable.
MAXIMUM_TOOL_ENVELOPE_BYTES=16777216
MAXIMUM_TOOL_BYTES=12582912
# Raised whenever a request is added or its meaning changes. The platform
# compares it against what it expects and offers an update when it is behind.
# An older helper reports no version at all, which is the same answer.
HELPER_VERSION=9
# Where enroll-probe.sh puts this script and the key that authorises its
# replacement. Written here rather than derived from $0: under the forced
# command $0 is whatever sshd decided to call us.
HELPER_PATH="/usr/local/sbin/prtg-nats-probe-helper"
HELPER_SIGNING_KEY="/etc/prtg-nats/helper-signing.pub"
SENSOR_SCRIPT_DIR="/opt/paessler/share/scripts"
SENSOR_CONFIG_ROOT="/etc/prtg-nats/sensors"
SENSOR_WRAPPER_DIR="/usr/local/sbin"
SENSOR_SUDOERS_DIR="/etc/sudoers.d"
SENSOR_UNIT_DIR="/etc/systemd/system"
SENSOR_VENV_ROOT="/var/lib/prtg-nats-sensors/venv"
SENSOR_NM_CONFIG="/etc/NetworkManager/conf.d/99-prtg-sensor-interfaces.conf"
SENSOR_TOOL_ROOT="/opt/prtg-nats/tools"
SYSTEM_IPERF_MIN_VERSION="3.18"
SYSTEM_IPERF_PATH="/usr/bin/iperf3"

# --- Overlay ---------------------------------------------------------------
# The WireGuard tunnel to the platform. The private key is kept beside the
# rendered configuration rather than only inside it, so the configuration can
# be rewritten - a mode change, a new endpoint - without the probe losing the
# identity the hub knows it by.
OVERLAY_INTERFACE="prtgnats0"
OVERLAY_CONFIG="/etc/wireguard/${OVERLAY_INTERFACE}.conf"
OVERLAY_CONFIG_ENV="/etc/prtg-nats/overlay.env"
OVERLAY_PRIVATE_KEY="/etc/prtg-nats/overlay.key"
OVERLAY_WATCH_PATH="/usr/local/sbin/prtg-nats-overlay-watch"
OVERLAY_UNIT="prtg-nats-overlay"
# The NATS route lives in a table of its own and a policy rule decides whether
# it applies. That is what lets the watcher test the direct path without
# taking the tunnel route out of the way first - pulling a route to find out
# whether it is needed interrupts exactly what it is measuring.
OVERLAY_ROUTING_TABLE="prtgnats"
OVERLAY_ROUTING_TABLE_ID=51820
OVERLAY_RULE_PRIORITY=100
OVERLAY_RT_TABLES="/etc/iproute2/rt_tables.d/prtg-nats.conf"
# Where enroll-probe.sh wrote the management key. The overlay adds the hub
# address to its from= list; it never replaces what is there.
MANAGEMENT_AUTHORIZED_KEYS="/var/lib/prtg-nats-admin/.ssh/authorized_keys"

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# A blocked deployment needs the transaction that owns the sensor, not the
# transaction that happened to collide with it. Keep that identifier on its
# own protocol line so both clients can offer an exact, tx-bound recovery
# command without scraping the explanatory sentence.
die_active_sensor_transaction() {
  local active_transaction="$1"

  shift
  validate_token "${active_transaction}" ||
    die "The active sensor transaction marker is invalid"
  printf 'ERROR: %s\n' "$*" >&2
  printf 'active_transaction=%s\n' "${active_transaction}" >&2
  exit 1
}

validate_token() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

active_config() {
  local found=()

  [[ -f "${TOML_CONFIG}" ]] && found+=("${TOML_CONFIG}")
  [[ -f "${YAML_CONFIG}" ]] && found+=("${YAML_CONFIG}")
  [[ "${#found[@]}" -eq 1 ]] ||
    die "Expected exactly one supported MPP config.toml or config.yaml"
  printf '%s\n' "${found[0]}"
}

# Like active_config, but additionally accepts a host that is not yet
# configured and then names the intended YAML target path.
target_config() {
  [[ ! -f "${TOML_CONFIG}" ]] ||
    die "A legacy config.toml is active; central configuration writes YAML only"
  printf '%s\n' "${YAML_CONFIG}"
}

# Allows tab, newline, printable ASCII and UTF-8 continuation bytes, but
# rejects every other control character.
is_free_of_control_characters() {
  local remaining=""

  remaining="$(
    LC_ALL=C tr -d '\11\12\15\40-\176\200-\377' < "$1" |
      wc -c |
      tr -d '[:space:]'
  )"
  [[ "${remaining}" == "0" ]]
}

# Identifies the running helper down to the byte, which a version number
# cannot: it also catches a file that was edited on the probe.
helper_checksum() {
  [[ -f "${HELPER_PATH}" ]] || {
    printf 'none'
    return 0
  }
  sha256sum "${HELPER_PATH}" | awk '{print $1}'
}

# The executable has to match the userland that loads it. A Raspberry Pi can
# run a 64-bit kernel over a 32-bit armhf installation, so uname alone is not
# an architecture detector here.
probe_userspace_architecture() {
  local architecture=""
  local bits=""
  local machine=""

  if command -v dpkg >/dev/null 2>&1; then
    architecture="$(dpkg --print-architecture 2>/dev/null || true)"
    case "${architecture}" in
      amd64|arm64)
        printf '%s\n' "${architecture}"
        return 0
        ;;
      armhf)
        machine="$(uname -m 2>/dev/null || true)"
        if [[ "${machine}" == armv6l ]]; then
          printf 'armhf-v6\n'
        else
          printf 'armhf\n'
        fi
        return 0
        ;;
    esac
  fi
  if command -v rpm >/dev/null 2>&1; then
    architecture="$(rpm --eval '%{_arch}' 2>/dev/null || true)"
    case "${architecture}" in
      x86_64)
        printf 'amd64\n'
        return 0
        ;;
      aarch64)
        printf 'arm64\n'
        return 0
        ;;
      armv7hl|armv7l)
        printf 'armhf\n'
        return 0
        ;;
      armv6hl|armv6l)
        printf 'armhf-v6\n'
        return 0
        ;;
    esac
  fi

  bits="$(getconf LONG_BIT 2>/dev/null || true)"
  machine="$(uname -m 2>/dev/null || true)"
  case "${machine}:${bits}" in
    x86_64:64)
      printf 'amd64\n'
      ;;
    aarch64:64|arm64:64)
      printf 'arm64\n'
      ;;
    aarch64:32|arm64:32|armv7l:32|armv8l:32)
      printf 'armhf\n'
      ;;
    armv6l:32)
      printf 'armhf-v6\n'
      ;;
    *)
      printf 'unknown\n'
      ;;
  esac
}

probe_libc() {
  local reported=""

  reported="$(getconf GNU_LIBC_VERSION 2>/dev/null || true)"
  if [[ "${reported}" == glibc\ * ]]; then
    printf 'glibc\n'
    return 0
  fi
  reported="$(ldd --version 2>&1 | head -n 1 || true)"
  if [[ "${reported,,}" == *musl* ]]; then
    printf 'musl\n'
    return 0
  fi
  printf 'unknown\n'
}

probe_platform() {
  printf 'linux-%s-%s\n' "$(probe_userspace_architecture)" "$(probe_libc)"
}

read_limited_input() {
  local destination="$1"
  local limit="${2:-${MAXIMUM_INPUT_BYTES}}"

  head -c "$((limit + 1))" > "${destination}"
  [[ "$(wc -c < "${destination}")" -le "${limit}" ]] ||
    die "Transferred payload exceeds ${limit} bytes"
  [[ -s "${destination}" ]] || die "Transferred payload is empty"
  is_free_of_control_characters "${destination}" ||
    die "Transferred payload contains control characters"
}

# Structural validation at the probe's trust boundary. It is deliberately
# implemented independently of the renderer on the NATS server, so that even
# a faulty or malicious caller cannot deposit an arbitrary file.
validate_configuration_payload() {
  local payload="$1"
  local required_pattern=""

  for required_pattern in \
    '^id:[[:space:]]' \
    '^access_key:[[:space:]]' \
    '^name:[[:space:]]' \
    '^[[:space:]]+url:[[:space:]]+tls://' \
    '^[[:space:]]+user:[[:space:]]' \
    '^[[:space:]]+password:[[:space:]]' \
    '^[[:space:]]+server_ca:[[:space:]]+/'; do
    [[ "$(grep -c -E "${required_pattern}" "${payload}")" == "1" ]] ||
      die "Configuration lacks exactly one ${required_pattern} entry"
  done
}

# Reports the version only if the package is really installed. After
# "apt-get remove" without "purge" it stays registered with status
# "config-files" and a version, although the program files are gone.
installed_package_version() {
  local version=""

  if command -v dpkg-query >/dev/null 2>&1; then
    if [[ "$(
      dpkg-query -W -f '${db:Status-Status}' prtgmpprobe 2>/dev/null || true
    )" == "installed" ]]; then
      version="$(
        dpkg-query -W -f '${Version}' prtgmpprobe 2>/dev/null || true
      )"
    fi
  fi
  if [[ -z "${version}" ]] && command -v rpm >/dev/null 2>&1; then
    version="$(rpm -q --queryformat '%{VERSION}' prtgmpprobe 2>/dev/null || true)"
  fi
  printf '%s\n' "${version:-none}"
}

read_scalar() {
  local config_path="$1"
  local field="$2"

  [[ -f "${config_path}" ]] || return 1
  awk -v field="${field}" '
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }
    $0 ~ "^" field "[[:space:]]*:" {
      value = $0
      sub("^" field "[[:space:]]*:[[:space:]]*", "", value)
      value = trim(value)
      gsub(/^["\047]|["\047]$/, "", value)
      found = value
      matches++
    }
    END {
      if (matches != 1 || found == "" || found ~ /[[:cntrl:]]/) {
        exit 42
      }
      print found
    }
  ' "${config_path}"
}

rewrite_toml() {
  local input_path="$1"
  local output_path="$2"
  local username="$3"
  local password="$4"

  awk -v username="${username}" -v password="${password}" '
    function leading(value) {
      match(value, /^[[:space:]]*/)
      return substr(value, 1, RLENGTH)
    }
    /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
      section = $0
      gsub(/[[:space:]]/, "", section)
      in_auth = (section == "[nats.authentication]")
    }
    in_auth && /^[[:space:]]*user[[:space:]]*=/ {
      print leading($0) "user = \"" username "\""
      users++
      next
    }
    in_auth && /^[[:space:]]*password[[:space:]]*=/ {
      print leading($0) "password = \"" password "\""
      passwords++
      next
    }
    { print }
    END {
      if (users != 1 || passwords != 1) {
        exit 42
      }
    }
  ' "${input_path}" > "${output_path}" ||
    die "Could not locate unique NATS authentication entries in TOML config"
}

rewrite_yaml() {
  local input_path="$1"
  local output_path="$2"
  local username="$3"
  local password="$4"

  awk -v username="${username}" -v password="${password}" '
    function indent_count(value, copy) {
      copy = value
      sub(/[^[:space:]].*$/, "", copy)
      return length(copy)
    }
    /^[[:space:]]*authentication:[[:space:]]*$/ {
      in_auth = 1
      auth_indent = indent_count($0)
      print
      next
    }
    in_auth && $0 !~ /^[[:space:]]*$/ &&
      indent_count($0) <= auth_indent {
      in_auth = 0
    }
    in_auth && /^[[:space:]]*user:[[:space:]]*/ {
      prefix = $0
      sub(/user:.*/, "", prefix)
      print prefix "user: " username
      users++
      next
    }
    in_auth && /^[[:space:]]*password:[[:space:]]*/ {
      prefix = $0
      sub(/password:.*/, "", prefix)
      print prefix "password: " password
      passwords++
      next
    }
    { print }
    END {
      if (users != 1 || passwords != 1) {
        exit 42
      }
    }
  ' "${input_path}" > "${output_path}" ||
    die "Could not locate unique NATS authentication entries in YAML config"
}

stage_credentials() {
  local transaction_id="$1"
  local username="$2"
  local password="$3"
  local config_path=""
  local transaction=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  validate_token "${username}" || die "Invalid NATS username"
  [[ "${password}" =~ ^[[:xdigit:]]{64}$ ]] || die "Invalid generated password"

  config_path="$(active_config)"
  transaction="${TRANSACTION_DIR}/${transaction_id}"
  [[ ! -e "${transaction}" ]] || die "Transaction already exists"
  install -d -o root -g root -m 0700 "${TRANSACTION_DIR}" "${transaction}"
  cp -p "${config_path}" "${transaction}/original"
  cp -p "${config_path}" "${transaction}/candidate"
  printf '%s\n' "${config_path}" > "${transaction}/config-path"
  chmod 0600 "${transaction}/config-path"

  if [[ "${config_path}" == *.toml ]]; then
    rewrite_toml \
      "${transaction}/original" \
      "${transaction}/candidate.new" \
      "${username}" \
      "${password}"
  else
    rewrite_yaml \
      "${transaction}/original" \
      "${transaction}/candidate.new" \
      "${username}" \
      "${password}"
  fi
  chmod --reference="${transaction}/original" "${transaction}/candidate.new"
  chown --reference="${transaction}/original" "${transaction}/candidate.new"
  mv "${transaction}/candidate.new" "${transaction}/candidate"
  printf 'OK staged %s\n' "${transaction_id}"
}

# Accepts a complete, centrally rendered configuration. The sequence is the
# same as for the pure password change, but additionally covers the initial
# configuration of a not-yet-configured host.
stage_configuration() {
  local transaction_id="$1"
  local config_path=""
  local transaction=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  config_path="$(target_config)"
  transaction="${TRANSACTION_DIR}/${transaction_id}"
  [[ ! -e "${transaction}" ]] || die "Transaction already exists"
  install -d -o root -g root -m 0700 "${TRANSACTION_DIR}" "${transaction}"

  read_limited_input "${transaction}/candidate"
  validate_configuration_payload "${transaction}/candidate"
  chmod 0600 "${transaction}/candidate"

  if [[ -f "${config_path}" ]]; then
    cp -p "${config_path}" "${transaction}/original"
  else
    : > "${transaction}/original-absent"
    chmod 0600 "${transaction}/original-absent"
  fi
  printf '%s\n' "${config_path}" > "${transaction}/config-path"
  chmod 0600 "${transaction}/config-path"
  printf 'OK staged-config %s\n' "${transaction_id}"
}

transaction_config_path() {
  local transaction="$1"
  local config_path=""

  config_path="$(<"${transaction}/config-path")"
  [[ "${config_path}" == "${TOML_CONFIG}" ||
     "${config_path}" == "${YAML_CONFIG}" ]] ||
    die "Unexpected MPP configuration path"
  printf '%s\n' "${config_path}"
}

# Installs a file as the configuration. For an already existing
# configuration, its owner and mode are kept.
#
# For an initial configuration the group is decisive: prtg.mpprobe.service
# does not run as root but under its own service user
# (User=/Group=paessler_mpprobe on MPP 3.10.0). A file with 0600 root:root is
# unreadable for it, and the service then aborts with
# "Failed to read config file: Permission denied". The group of the
# configuration directory is therefore adopted and 0640 set: root writes,
# the service user reads, nobody else.
install_configuration() {
  local source_path="$1"
  local config_path="$2"
  local transaction_id="$3"
  local temporary_path="${config_path}.prtg-nats-${transaction_id}"
  local config_directory=""
  local directory_group=""

  install -o root -g root -m 0600 "${source_path}" "${temporary_path}"
  if [[ -f "${config_path}" ]]; then
    chown --reference="${config_path}" "${temporary_path}"
    chmod --reference="${config_path}" "${temporary_path}"
  else
    config_directory="$(dirname -- "${config_path}")"
    directory_group="$(stat -c '%G' "${config_directory}")"
    if [[ -n "${directory_group}" && "${directory_group}" != "root" ]]; then
      chown "root:${directory_group}" "${temporary_path}"
      chmod 0640 "${temporary_path}"
    fi
  fi
  mv "${temporary_path}" "${config_path}"
}

restore_previous_configuration() {
  local transaction="$1"
  local config_path="$2"
  local transaction_id="$3"

  if [[ -f "${transaction}/original" ]]; then
    install_configuration \
      "${transaction}/original" "${config_path}" "${transaction_id}"
    systemctl restart "${MPP_SERVICE}" || true
  else
    rm -f -- "${config_path}"
    systemctl stop "${MPP_SERVICE}" || true
  fi
}

activate_credentials() {
  local transaction_id="$1"
  local transaction="${TRANSACTION_DIR}/${transaction_id}"
  local config_path=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  [[ -f "${transaction}/candidate" &&
     -f "${transaction}/config-path" ]] ||
    die "Unknown or incomplete transaction"
  [[ -f "${transaction}/original" ||
     -f "${transaction}/original-absent" ]] ||
    die "Unknown or incomplete transaction"
  config_path="$(transaction_config_path "${transaction}")"

  install_configuration \
    "${transaction}/candidate" "${config_path}" "${transaction_id}"
  systemctl enable "${MPP_SERVICE}" >/dev/null 2>&1 || true
  if ! systemctl restart "${MPP_SERVICE}" ||
    ! systemctl is-active --quiet "${MPP_SERVICE}"; then
    restore_previous_configuration \
      "${transaction}" "${config_path}" "${transaction_id}"
    die "MPP activation failed and the previous state was restored"
  fi
  printf 'OK activated %s\n' "${transaction_id}"
}

rollback_credentials() {
  local transaction_id="$1"
  local transaction="${TRANSACTION_DIR}/${transaction_id}"
  local config_path=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  [[ -f "${transaction}/config-path" ]] ||
    die "Unknown or incomplete transaction"
  [[ -f "${transaction}/original" ||
     -f "${transaction}/original-absent" ]] ||
    die "Unknown or incomplete transaction"
  config_path="$(transaction_config_path "${transaction}")"
  restore_previous_configuration \
    "${transaction}" "${config_path}" "${transaction_id}"
  if [[ -f "${transaction}/original" ]]; then
    systemctl is-active --quiet "${MPP_SERVICE}" ||
      die "MPP service is inactive after rollback"
  fi
  printf 'OK rolled-back %s\n' "${transaction_id}"
}

commit_credentials() {
  local transaction_id="$1"
  local transaction="${TRANSACTION_DIR}/${transaction_id}"

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  [[ "${transaction}" == "${TRANSACTION_DIR}/"* ]] ||
    die "Unsafe transaction path"
  [[ -d "${transaction}" ]] || die "Unknown transaction"
  rm -rf -- "${transaction}"
  printf 'OK committed %s\n' "${transaction_id}"
}

status_probe() {
  local config_path=""

  config_path="$(active_config)"
  systemctl is-active --quiet "${MPP_SERVICE}" ||
    die "MPP service is not active"
  printf 'OK active config=%s\n' "${config_path}"
}

# Reachability and inventory report. It deliberately does not fail while
# package or configuration are still missing, so it can serve as a
# connection test right after enrollment. The NATS password is never
# printed.
probe_info() {
  local config_path=""
  local service_state="inactive"

  systemctl is-active --quiet "${MPP_SERVICE}" && service_state="active"
  printf 'OK probe-info\n'
  printf 'package=%s\n' "$(installed_package_version)"
  printf 'service=%s\n' "${service_state}"
  # Before the early returns below, so the answer carries it even on a probe
  # whose configuration is still missing. A helper too old to know these
  # fields simply omits them, and that absence is what marks it as old.
  printf 'helper_version=%s\n' "${HELPER_VERSION}"
  printf 'helper_sha256=%s\n' "$(helper_checksum)"
  printf 'platform=%s\n' "$(probe_platform)"
  # When the probe is connected through its IP, its own host name is the
  # better name-giver than the address.
  printf 'hostname=%s\n' \
    "$(hostname -f 2>/dev/null || hostname 2>/dev/null || printf 'none')"
  if [[ -f "${CA_PATH}" ]] && command -v openssl >/dev/null 2>&1; then
    printf 'ca_sha256=%s\n' "$(
      openssl x509 -in "${CA_PATH}" -outform DER |
        openssl dgst -sha256 |
        awk '{print $NF}'
    )"
  else
    printf 'ca_sha256=none\n'
  fi
  print_overlay_fields
  if [[ -f "${TOML_CONFIG}" ]]; then
    printf 'config=%s\n' "${TOML_CONFIG}"
    return 0
  fi
  if [[ ! -f "${YAML_CONFIG}" ]]; then
    printf 'config=none\n'
    return 0
  fi
  config_path="${YAML_CONFIG}"
  printf 'config=%s\n' "${config_path}"
  printf 'id=%s\n' "$(read_scalar "${config_path}" id || printf 'none')"
  printf 'access_key=%s\n' \
    "$(read_scalar "${config_path}" access_key || printf 'none')"
  printf 'name=%s\n' "$(read_scalar "${config_path}" name || printf 'none')"
}

install_ca() {
  local staged="${STATE_DIR}/ca-candidate.pem"

  read_limited_input "${staged}"
  [[ "$(grep -c 'BEGIN CERTIFICATE' "${staged}")" == "1" ]] ||
    die "CA input must contain exactly one PEM certificate"
  if command -v openssl >/dev/null 2>&1; then
    openssl x509 -in "${staged}" -noout >/dev/null 2>&1 ||
      die "CA input is not a valid PEM certificate"
    openssl x509 -in "${staged}" -noout -text |
      grep -F 'CA:TRUE' >/dev/null ||
      die "Certificate is not a certificate authority"
    openssl x509 -in "${staged}" -noout -checkend 0 >/dev/null ||
      die "CA certificate has expired"
  fi
  install -d -o root -g root -m 0755 "${CERT_DIR}"
  install -o root -g root -m 0644 "${staged}" "${CA_PATH}"
  rm -f -- "${staged}"
  printf 'OK ca-installed %s\n' "${CA_PATH}"
}

# ---------------------------------------------------------------------------
# Replacing this script
#
# The one request that installs root code rather than data, which is why it is
# the only one that does not trust the channel it arrived on. Holding the
# management key opens the channel; replacing the helper additionally needs a
# signature from a key the probe was given during enrollment and that never
# travels over this channel. Everything else here guards against a well-meant
# but broken file: a helper that does not parse leaves the probe reachable
# only from a console.
# ---------------------------------------------------------------------------

update_helper() {
  local signature_base64="$1"
  local staged="${STATE_DIR}/helper-candidate"
  local signature="${STATE_DIR}/helper-candidate.sig"
  # In the target directory, because the last step has to be a rename: mv
  # across filesystems copies, and copying onto the file bash is reading right
  # now truncates the script mid-execution.
  local incoming="${HELPER_PATH}.incoming"
  local version=""

  # The length is a separate condition rather than a bounded repetition in the
  # pattern: above 255 that does not compile everywhere. A P-256 signature is
  # 96 characters.
  [[ "${signature_base64}" =~ ^[A-Za-z0-9+/=]+$ &&
     ${#signature_base64} -le 255 ]] ||
    die "helper-update signature is not base64"
  command -v openssl >/dev/null 2>&1 ||
    die "openssl is required to verify a helper update"
  [[ -f "${HELPER_SIGNING_KEY}" ]] ||
    die "No helper signing key on this probe; it was enrolled before signed updates and has to be enrolled again"

  read_limited_input "${staged}" "${MAXIMUM_HELPER_BYTES}"
  printf '%s' "${signature_base64}" | openssl base64 -d -A -out "${signature}" ||
    die "helper-update signature could not be decoded"
  openssl dgst -sha256 \
    -verify "${HELPER_SIGNING_KEY}" \
    -signature "${signature}" \
    "${staged}" >/dev/null 2>&1 ||
    die "helper-update signature does not match this probe's signing key"

  [[ "$(head -n 1 "${staged}")" == '#!'*bash* ]] ||
    die "helper-update payload is not a bash script"
  bash -n "${staged}" 2>/dev/null ||
    die "helper-update payload is not syntactically valid"
  version="$(
    sed -n 's/^HELPER_VERSION=\([0-9][0-9]*\)$/\1/p' "${staged}" | head -n 1
  )"
  [[ -n "${version}" ]] ||
    die "helper-update payload declares no HELPER_VERSION"

  install -o root -g root -m 0755 "${staged}" "${incoming}"
  mv -f -- "${incoming}" "${HELPER_PATH}"
  rm -f -- "${staged}" "${signature}"
  printf 'OK helper-updated version=%s sha256=%s\n' \
    "${version}" "$(helper_checksum)"
}

# ---------------------------------------------------------------------------
# Sensor scripts
#
# Sensors are managed centrally and rolled out over the same restricted
# channel as the configuration. Only text travels over the channel: the
# sensor script, its privileged helper and metadata. Everything that grants
# rights - the sudo rule and the interface reservation - is generated by
# this helper itself from the sensor name. A faulty or malicious caller
# cannot smuggle in its own sudo rule that way.
# ---------------------------------------------------------------------------

SENSOR_SLOTS=(script wrapper requirements version)

# Sensor files, units and managed-tool links form one installed state. Keep the
# lock outside the individual deployment transaction so two different
# transaction IDs still serialize on the sensor they both modify. Staging does
# not take this lock and can therefore continue while another transaction is
# awaiting commit or rollback.
sensor_transaction_lock_path() {
  local name="$1"

  validate_token "${name}" || die "Invalid sensor name"
  printf '%s/%s.lock\n' "${SENSOR_TRANSACTION_STATE_DIR}" "${name}"
}

sensor_active_transaction_path() {
  local name="$1"

  validate_token "${name}" || die "Invalid sensor name"
  printf '%s/%s.active\n' "${SENSOR_TRANSACTION_STATE_DIR}" "${name}"
}

sensor_commit_tombstone_path() {
  local transaction_id="$1"

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  printf '%s/%s\n' "${SENSOR_COMMIT_TOMBSTONE_DIR}" "${transaction_id}"
}

committed_sensor_transaction_name() {
  local transaction_id="$1"
  local tombstone=""
  local name=""
  local owner=""
  local mode=""

  tombstone="$(sensor_commit_tombstone_path "${transaction_id}")"
  [[ -e "${tombstone}" ]] || return 1
  [[ -f "${tombstone}" && ! -L "${tombstone}" ]] ||
    die "The sensor commit tombstone is invalid"
  owner="$(stat -c '%u' "${tombstone}" 2>/dev/null || true)"
  mode="$(stat -c '%a' "${tombstone}" 2>/dev/null || true)"
  # The complete helper starts only as UID 0. Comparing with EUID keeps the
  # function testable in isolation without weakening the deployed check.
  [[ "${owner}" == "${EUID}" && "${mode}" == "600" ]] ||
    die "The sensor commit tombstone is not root-only"
  name="$(<"${tombstone}")"
  validate_token "${name}" || die "The sensor commit tombstone is invalid"
  [[ "$(wc -l < "${tombstone}" | tr -d '[:space:]')" == "1" ]] ||
    die "The sensor commit tombstone is invalid"
  printf '%s\n' "${name}"
}

reject_committed_sensor_transaction_id() {
  local transaction_id="$1"

  if committed_sensor_transaction_name "${transaction_id}" >/dev/null; then
    die "Sensor transaction ${transaction_id} was already committed"
  fi
}

prune_sensor_commit_tombstones() {
  local current_transaction_id="$1"
  local expired=()
  local transaction_id=""

  [[ "${MAXIMUM_SENSOR_COMMIT_TOMBSTONES}" =~ ^[0-9]+$ &&
     "${MAXIMUM_SENSOR_COMMIT_TOMBSTONES}" -ge 1 ]] ||
    die "The sensor commit tombstone limit is invalid"
  mapfile -t expired < <(
    find "${SENSOR_COMMIT_TOMBSTONE_DIR}" \
      -mindepth 1 -maxdepth 1 -type f \
      ! -name '.*' ! -name "${current_transaction_id}" \
      -printf '%T@ %f\n' |
      sort -rn |
      awk -v maximum="${MAXIMUM_SENSOR_COMMIT_TOMBSTONES}" \
        'NR >= maximum { print $2 }'
  )
  for transaction_id in "${expired[@]}"; do
    validate_token "${transaction_id}" || continue
    rm -f -- "$(sensor_commit_tombstone_path "${transaction_id}")"
  done
}

record_sensor_commit_tombstone() {
  local transaction_id="$1"
  local name="$2"
  local tombstone=""
  local candidate="${SENSOR_COMMIT_TOMBSTONE_DIR}/.candidate"

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  validate_token "${name}" || die "Invalid sensor name"
  command -v flock >/dev/null 2>&1 ||
    die "flock is required for sensor commit tombstones"
  tombstone="$(sensor_commit_tombstone_path "${transaction_id}")"
  exec 8> "${SENSOR_COMMIT_TOMBSTONE_DIR}/.lock" ||
    die "Could not open the sensor commit tombstone lock"
  flock -x 8 || die "Could not lock sensor commit tombstones"
  printf '%s\n' "${name}" > "${candidate}"
  chmod 0600 "${candidate}"
  mv -Tf -- "${candidate}" "${tombstone}"
  prune_sensor_commit_tombstones "${transaction_id}"
  flock -u 8 || die "Could not unlock sensor commit tombstones"
  exec 8>&-
}

acquire_sensor_transaction_lock() {
  local name="$1"
  local lock_path=""

  command -v flock >/dev/null 2>&1 ||
    die "flock is required for serialized sensor deployments"
  lock_path="$(sensor_transaction_lock_path "${name}")"
  exec 9> "${lock_path}" || die "Could not open the sensor deployment lock"
  flock -x 9 || die "Could not lock the sensor deployment"
}

release_sensor_transaction_lock() {
  flock -u 9 || die "Could not unlock the sensor deployment"
  exec 9>&-
}

read_active_sensor_transaction() {
  local name="$1"
  local marker=""
  local transaction_id=""

  marker="$(sensor_active_transaction_path "${name}")"
  [[ -e "${marker}" ]] || return 0
  [[ -f "${marker}" && ! -L "${marker}" ]] ||
    die "The active sensor transaction marker is invalid"
  transaction_id="$(<"${marker}")"
  validate_token "${transaction_id}" ||
    die "The active sensor transaction marker is invalid"
  [[ "$(wc -l < "${marker}" | tr -d '[:space:]')" == "1" ]] ||
    die "The active sensor transaction marker is invalid"
  printf '%s\n' "${transaction_id}"
}

# Claims the installed sensor state for one transaction. The answer tells the
# caller whether work remains. A completed activation is a successful retry;
# an interrupted activation has to be rolled back because installation may
# have stopped between any two filesystem or systemd operations.
claim_sensor_activation() {
  local transaction_id="$1"
  local transaction="$2"
  local name="$3"
  local marker=""
  local marker_candidate=""
  local active_transaction=""

  marker="$(sensor_active_transaction_path "${name}")"
  active_transaction="$(read_active_sensor_transaction "${name}")"
  if [[ -n "${active_transaction}" &&
        "${active_transaction}" != "${transaction_id}" ]]; then
    die_active_sensor_transaction "${active_transaction}" \
      "Sensor ${name} has an active transaction; commit or roll it back first"
  fi
  if [[ -z "${active_transaction}" ]]; then
    marker_candidate="${marker}.candidate-${BASHPID}"
    printf '%s\n' "${transaction_id}" > "${marker_candidate}"
    chmod 0600 "${marker_candidate}"
    mv -Tf -- "${marker_candidate}" "${marker}"
  fi

  if [[ -f "${transaction}/activation-complete" ]]; then
    printf 'complete\n'
  elif [[ -f "${transaction}/activated" ]]; then
    die "Sensor ${name} has an interrupted activation; roll transaction ${transaction_id} back"
  else
    printf 'pending\n'
  fi
}

require_active_sensor_transaction() {
  local transaction_id="$1"
  local name="$2"
  local active_transaction=""

  active_transaction="$(read_active_sensor_transaction "${name}")"
  [[ -n "${active_transaction}" ]] ||
    die "Sensor ${name} has no active transaction"
  [[ "${active_transaction}" == "${transaction_id}" ]] ||
    die_active_sensor_transaction "${active_transaction}" \
      "Transaction ${transaction_id} is not active for sensor ${name}"
}

clear_active_sensor_transaction() {
  local transaction_id="$1"
  local name="$2"
  local marker=""

  require_active_sensor_transaction "${transaction_id}" "${name}"
  marker="$(sensor_active_transaction_path "${name}")"
  rm -f -- "${marker}"
}

# Before the activated marker exists no installed file has been touched. A
# retry may therefore discard a half-written snapshot and record it again.
# Once activated exists, claim_sensor_activation rejects the retry instead.
clear_incomplete_sensor_snapshot() {
  local transaction="$1"
  local slot=""

  [[ ! -f "${transaction}/activated" ]] ||
    die "An activated sensor snapshot cannot be replaced"
  for slot in "${SENSOR_SLOTS[@]}"; do
    rm -f -- \
      "${transaction}/original-${slot}" \
      "${transaction}/original-${slot}-absent"
  done
  rm -f -- \
    "${transaction}/original-tool-current" \
    "${transaction}/original-tool-current-absent" \
    "${transaction}/original-tool-metadata" \
    "${transaction}/original-tool-metadata-absent"
}

# The caller can ask for the tool a known sensor declares, never for an
# arbitrary executable. The same fixed vocabulary decides the install path.
managed_tool_for_sensor() {
  case "$1" in
    iperf-throughput)
      printf 'iperf3\n'
      ;;
    *)
      :
      ;;
  esac
}

managed_tool_binary_name() {
  case "$1" in
    iperf3)
      printf 'iperf3\n'
      ;;
    *)
      die "Unsupported managed tool: $1"
      ;;
  esac
}

managed_tool_current_link() {
  printf '%s/%s/current\n' "${SENSOR_TOOL_ROOT}" "$1"
}

managed_tool_metadata_path() {
  printf '%s/%s/tool.env\n' "${SENSOR_CONFIG_ROOT}" "$1"
}

managed_tool_has_release_artifact() {
  local tool="$1"
  local platform="$2"

  case "${tool}:${platform}" in
    iperf3:linux-amd64-glibc|\
      iperf3:linux-arm64-glibc|\
      iperf3:linux-armhf-glibc)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# The service user owns the scripts and runs them. On MPP 3.10 that is
# paessler_mpprobe. If the unit query fails, the group of the script
# directory serves as the substitute - the package creates it to match.
sensor_service_user() {
  local service_user=""

  service_user="$(
    systemctl show "${MPP_SERVICE}" -p User --value 2>/dev/null || true
  )"
  if [[ -z "${service_user}" || "${service_user}" == "root" ]]; then
    service_user="$(stat -c '%G' "${SENSOR_SCRIPT_DIR}" 2>/dev/null || true)"
  fi
  [[ -n "${service_user}" && "${service_user}" != "root" ]] ||
    die "Could not determine an unprivileged MPP service user"
  id -u "${service_user}" >/dev/null 2>&1 ||
    die "The MPP service user does not exist: ${service_user}"
  printf '%s\n' "${service_user}"
}

# The target paths are hard-wired and built solely from the validated
# sensor name. The caller never names a path.
sensor_slot_target() {
  local name="$1"
  local slot="$2"

  case "${slot}" in
    script)
      printf '%s/%s.py\n' "${SENSOR_SCRIPT_DIR}" "${name}"
      ;;
    wrapper)
      printf '%s/prtg-sensor-%s\n' "${SENSOR_WRAPPER_DIR}" "${name}"
      ;;
    requirements)
      printf '%s/%s/requirements.txt\n' "${SENSOR_CONFIG_ROOT}" "${name}"
      ;;
    version)
      printf '%s/%s/version\n' "${SENSOR_CONFIG_ROOT}" "${name}"
      ;;
    *)
      die "Unsupported sensor slot: ${slot}"
      ;;
  esac
}

# Not a transferred slot: this helper writes the file itself, from the script
# it was handed. See install_sensor_files for what it is good for.
sensor_shebang_path() {
  printf '%s/%s/shebang\n' "${SENSOR_CONFIG_ROOT}" "$1"
}

# Syntax check without side effects: compile() compiles in memory only.
# py_compile is out, because it atomically moves the generated file to its
# target path and, as root, would even replace a device like /dev/null.
compile_python() {
  python3 -c '
import sys

with open(sys.argv[1], "rb") as handle:
    compile(handle.read(), sys.argv[1], "exec")
' "$1" >/dev/null 2>&1
}

validate_sensor_payload() {
  local slot="$1"
  local payload="$2"

  case "${slot}" in
    script|wrapper)
      head -n 1 "${payload}" |
        grep -E -x '#!(/usr/bin/env python3|/usr/bin/python3)' >/dev/null ||
        die "A sensor ${slot} must start with a python3 shebang"
      compile_python "${payload}" ||
        die "The transferred sensor ${slot} is not valid Python"
      ;;
    requirements)
      # Simple requirement lines only. Options like --index-url belong in
      # the probe's pip configuration, not in a transferred file.
      grep -E -q -v '^[[:space:]]*(#.*)?$|^[A-Za-z0-9][A-Za-z0-9._-]*([<>=!~]=?[A-Za-z0-9._*+-]+)?[[:space:]]*$' \
        "${payload}" &&
        die "The requirements file contains unsupported entries"
      ;;
    version)
      [[ "$(wc -l < "${payload}")" -le 1 ]] &&
        validate_token "$(head -n 1 "${payload}")" ||
        die "Invalid sensor version"
      ;;
  esac
  return 0
}

stage_sensor() {
  local transaction_id="$1"
  local name="$2"
  local slot="$3"
  local transaction=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  validate_token "${name}" || die "Invalid sensor name"
  reject_committed_sensor_transaction_id "${transaction_id}"
  sensor_slot_target "${name}" "${slot}" >/dev/null

  transaction="${TRANSACTION_DIR}/${transaction_id}"
  install -d -o root -g root -m 0700 "${TRANSACTION_DIR}" "${transaction}"
  if [[ -f "${transaction}/sensor-name" ]]; then
    [[ "$(<"${transaction}/sensor-name")" == "${name}" ]] ||
      die "The transaction already belongs to a different sensor"
  else
    printf '%s\n' "${name}" > "${transaction}/sensor-name"
    chmod 0600 "${transaction}/sensor-name"
  fi
  [[ ! -f "${transaction}/slot-${slot}" ]] ||
    die "Slot ${slot} is already staged in this transaction"

  read_limited_input "${transaction}/slot-${slot}" "${MAXIMUM_SENSOR_BYTES}"
  validate_sensor_payload "${slot}" "${transaction}/slot-${slot}"
  chmod 0600 "${transaction}/slot-${slot}"
  printf 'OK sensor-staged %s %s\n' "${name}" "${slot}"
}

validate_managed_tool_binary() {
  local tool="$1"
  local version="$2"
  local candidate="$3"
  local output=""
  local reported_version=""

  case "${tool}" in
    iperf3)
      output="$("${candidate}" --version 2>&1)" ||
        die "The managed iperf3 executable cannot run on this probe"
      reported_version="$(
        printf '%s\n' "${output}" | head -n 1 | awk '{print $2}'
      )"
      [[ "${reported_version}" == "${version}" ]] ||
        die "The managed iperf3 executable reports the wrong version"
      printf '%s\n' "${output}" | grep -i 'authentication' >/dev/null ||
        die "The managed iperf3 executable lacks authentication support"
      ;;
    *)
      die "Unsupported managed tool: ${tool}"
      ;;
  esac
}

version_at_least() {
  local actual="$1"
  local minimum="$2"
  local oldest=""

  [[ "${actual}" =~ ^[0-9]+([.][0-9]+)*$ &&
     "${minimum}" =~ ^[0-9]+([.][0-9]+)*$ ]] || return 1
  oldest="$(printf '%s\n%s\n' "${minimum}" "${actual}" | sort -V | head -n 1)"
  [[ "${oldest}" == "${minimum}" ]]
}

iperf_binary_version() {
  local candidate="$1"

  "${candidate}" --version 2>&1 | head -n 1 |
    sed -n 's/^iperf \([0-9][0-9.]*\).*/\1/p'
}

iperf_binary_has_authentication() {
  local candidate="$1"

  "${candidate}" --version 2>&1 | grep -i 'authentication' >/dev/null
}

root_executable_path_is_trusted() {
  local candidate="$1"
  local owner=""
  local mode=""

  [[ -x "${candidate}" && -f "${candidate}" && ! -L "${candidate}" ]] ||
    return 1
  owner="$(stat -c '%u' "${candidate}" 2>/dev/null || true)"
  mode="$(stat -c '%a' "${candidate}" 2>/dev/null || true)"
  [[ "${owner}" == "0" && "${mode}" =~ ^[0-7]{3,4}$ &&
     $((8#${mode} & 8#22)) -eq 0 ]]
}

managed_tool_path_is_trusted() {
  root_executable_path_is_trusted "$1"
}

system_tool_path_is_trusted() {
  local candidate="$1"

  [[ "${candidate}" == "${SYSTEM_IPERF_PATH}" ]] &&
    root_executable_path_is_trusted "${candidate}"
}

validate_system_tool_binary() {
  local tool="$1"
  local candidate="$2"
  local version=""

  case "${tool}" in
    iperf3)
      system_tool_path_is_trusted "${candidate}" ||
        die "The system iperf3 fallback must be the fixed root-owned package executable ${SYSTEM_IPERF_PATH} and not writable by group or others"
      version="$(iperf_binary_version "${candidate}")"
      version_at_least "${version}" "${SYSTEM_IPERF_MIN_VERSION}" ||
        die "System iperf3 ${version:-unknown} is older than ${SYSTEM_IPERF_MIN_VERSION}"
      iperf_binary_has_authentication "${candidate}" ||
        die "The system iperf3 executable lacks authentication support"
      ;;
    *)
      die "Unsupported managed tool: ${tool}"
      ;;
  esac
}

# The signed envelope contains one executable and immutable metadata. Keeping
# it to a single file avoids archive extraction at the root trust boundary.
stage_sensor_tool() {
  local transaction_id="$1"
  local name="$2"
  local signature_base64="$3"
  local transaction=""
  local scratch=""
  local envelope=""
  local signature=""
  local encoded=""
  local candidate=""
  local expected_tool=""
  local tool=""
  local version=""
  local platform=""
  local expected_sha256=""
  local expected_size=""
  local actual_sha256=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  validate_token "${name}" || die "Invalid sensor name"
  reject_committed_sensor_transaction_id "${transaction_id}"
  expected_tool="$(managed_tool_for_sensor "${name}")"
  [[ -n "${expected_tool}" ]] ||
    die "Sensor ${name} has no approved managed tool"
  [[ "${signature_base64}" =~ ^[A-Za-z0-9+/=]+$ &&
     ${#signature_base64} -le 255 ]] ||
    die "sensor-tool-stage signature is not base64"
  command -v openssl >/dev/null 2>&1 ||
    die "openssl is required to verify a managed tool"
  [[ -f "${HELPER_SIGNING_KEY}" ]] ||
    die "No helper signing key on this probe; enrol it again before deploying managed tools"

  install -d -o root -g root -m 0700 "${STATE_DIR}"
  scratch="$(mktemp -d "${STATE_DIR}/.sensor-tool-stage.XXXXXXXX")"
  # Invalid or forged input must not consume persistent transaction space.
  # The helper serves one request per process, so this EXIT trap is scoped to
  # this request and also covers every die() below.
  trap 'rm -rf -- "${scratch}"' EXIT
  envelope="${scratch}/envelope"
  signature="${scratch}/envelope.sig"
  encoded="${scratch}/payload.b64"
  candidate="${scratch}/binary"
  read_limited_input "${envelope}" "${MAXIMUM_TOOL_ENVELOPE_BYTES}"
  printf '%s' "${signature_base64}" |
    openssl base64 -d -A -out "${signature}" ||
    die "sensor-tool-stage signature could not be decoded"
  openssl dgst -sha256 \
    -verify "${HELPER_SIGNING_KEY}" \
    -signature "${signature}" \
    "${envelope}" >/dev/null 2>&1 ||
    die "sensor-tool-stage signature does not match this probe's signing key"

  [[ "$(sed -n '1p' "${envelope}")" == 'PRTG-NATS-MANAGED-TOOL-V1' &&
     "$(sed -n '7p' "${envelope}")" == '' &&
     "$(wc -l < "${envelope}")" -eq 8 ]] ||
    die "The managed tool envelope has an invalid structure"
  tool="$(sed -n '2s/^tool=//p' "${envelope}")"
  version="$(sed -n '3s/^version=//p' "${envelope}")"
  platform="$(sed -n '4s/^platform=//p' "${envelope}")"
  expected_sha256="$(sed -n '5s/^sha256=//p' "${envelope}")"
  expected_size="$(sed -n '6s/^size=//p' "${envelope}")"
  [[ "${tool}" == "${expected_tool}" ]] ||
    die "The managed tool does not belong to sensor ${name}"
  validate_token "${version}" || die "Invalid managed tool version"
  [[ "${platform}" == "$(probe_platform)" ]] ||
    die "The managed tool platform ${platform} does not match $(probe_platform)"
  [[ "${expected_sha256}" =~ ^[0-9a-f]{64}$ ]] ||
    die "Invalid managed tool SHA-256"
  [[ "${expected_size}" =~ ^[0-9]+$ &&
     "${expected_size}" -gt 0 &&
     "${expected_size}" -le "${MAXIMUM_TOOL_BYTES}" ]] ||
    die "Invalid managed tool size"

  sed -n '8p' "${envelope}" > "${encoded}"
  grep -E -x '[A-Za-z0-9+/]+={0,2}' "${encoded}" >/dev/null ||
    die "The managed tool payload is not base64"
  base64 -d "${encoded}" > "${candidate}" 2>/dev/null ||
    die "The managed tool payload could not be decoded"
  [[ "$(wc -c < "${candidate}")" -eq "${expected_size}" ]] ||
    die "The managed tool size does not match its signed metadata"
  actual_sha256="$(sha256sum "${candidate}" | awk '{print $1}')"
  [[ "${actual_sha256}" == "${expected_sha256}" ]] ||
    die "The managed tool checksum does not match its signed metadata"
  chmod 0700 "${candidate}"
  validate_managed_tool_binary "${tool}" "${version}" "${candidate}"

  transaction="${TRANSACTION_DIR}/${transaction_id}"
  install -d -o root -g root -m 0700 "${TRANSACTION_DIR}" "${transaction}"
  if [[ -f "${transaction}/sensor-name" ]]; then
    [[ "$(<"${transaction}/sensor-name")" == "${name}" ]] ||
      die "The transaction belongs to a different sensor"
  else
    printf '%s\n' "${name}" > "${transaction}/sensor-name"
    chmod 0600 "${transaction}/sensor-name"
  fi
  [[ ! -f "${transaction}/tool-binary" ]] ||
    die "A managed tool is already staged in this transaction"
  mv -- "${candidate}" "${transaction}/tool-binary"
  printf '%s\n' "${tool}" > "${transaction}/tool-name"
  printf '%s\n' "${version}" > "${transaction}/tool-version"
  printf '%s\n' "${platform}" > "${transaction}/tool-platform"
  printf '%s\n' "${expected_sha256}" > "${transaction}/tool-sha256"
  printf 'managed\n' > "${transaction}/tool-source"
  chmod 0600 "${transaction}"/tool-{name,version,platform,sha256,source}
  rm -rf -- "${scratch}"
  trap - EXIT
  printf 'OK sensor-tool-staged %s %s version=%s platform=%s sha256=%s\n' \
    "${name}" "${tool}" "${version}" "${platform}" "${expected_sha256}"
}

# The privileged part of a sensor runs as its own service behind a Unix
# socket, not through sudo.
#
# prtg.mpprobe.service sets NoNewPrivileges=yes - the kernel then ignores
# the setuid bit of sudo, and the vendor means it exactly that way. The
# socket needs no intervention in that hardening: AF_UNIX is allowed in
# RestrictAddressFamilies, and the service itself is not subject to the
# seccomp rules of the MPP unit. Who may reach the socket is decided by its
# group alone.
#
# Accept=yes hands the connection to the program as stdin and stdout. The
# helper therefore stays an ordinary filter program: JSON in, JSON out -
# usable on the command line exactly as over the socket.
write_sensor_units() {
  local name="$1"
  local service_user="$2"
  local service_group=""
  local socket_unit="${SENSOR_UNIT_DIR}/prtg-sensor-${name}.socket"
  local service_unit="${SENSOR_UNIT_DIR}/prtg-sensor-${name}@.service"

  service_group="$(id -gn "${service_user}")" ||
    die "Could not determine the group of ${service_user}"
  install -d -o root -g root -m 0755 "${SENSOR_UNIT_DIR}"

  {
    printf '# Erzeugt von prtg-nats. Nicht von Hand bearbeiten.\n'
    printf '[Unit]\n'
    printf 'Description=Privileged helper socket for the PRTG sensor %s\n\n' \
      "${name}"
    printf '[Socket]\n'
    printf 'ListenStream=/run/prtg-sensor-%s.sock\n' "${name}"
    printf 'SocketUser=root\n'
    printf 'SocketGroup=%s\n' "${service_group}"
    printf 'SocketMode=0660\n'
    printf 'Accept=yes\n'
    printf 'MaxConnections=4\n\n'
    printf '[Install]\n'
    printf 'WantedBy=sockets.target\n'
  } > "${socket_unit}.candidate"

  {
    printf '# Erzeugt von prtg-nats. Nicht von Hand bearbeiten.\n'
    printf '[Unit]\n'
    printf 'Description=Privileged helper for the PRTG sensor %s\n\n' "${name}"
    printf '[Service]\n'
    printf 'Type=simple\n'
    printf 'ExecStart=%s/prtg-sensor-%s\n' "${SENSOR_WRAPPER_DIR}" "${name}"
    printf 'User=root\n'
    printf 'Group=root\n'
    printf 'StandardInput=socket\n'
    printf 'StandardOutput=socket\n'
    printf 'StandardError=journal\n'
    # Emergency brake in case a helper hangs despite its own time budgets.
    printf 'RuntimeMaxSec=600\n'
  } > "${service_unit}.candidate"

  chmod 0644 "${socket_unit}.candidate" "${service_unit}.candidate"
  mv "${socket_unit}.candidate" "${socket_unit}"
  mv "${service_unit}.candidate" "${service_unit}"

  systemctl daemon-reload
  systemctl enable --now "prtg-sensor-${name}.socket" >/dev/null 2>&1 ||
    die "Could not activate the privileged helper socket of ${name}"

  # Earlier versions of this repository deployed a sudo rule instead. It
  # would be ineffective, but it should not be left lying around either.
  rm -f -- "${SENSOR_SUDOERS_DIR}/prtg-sensor-${name}"
}

remove_sensor_units() {
  local name="$1"

  systemctl disable --now "prtg-sensor-${name}.socket" >/dev/null 2>&1 || true
  rm -f -- \
    "${SENSOR_UNIT_DIR}/prtg-sensor-${name}.socket" \
    "${SENSOR_UNIT_DIR}/prtg-sensor-${name}@.service" \
    "${SENSOR_SUDOERS_DIR}/prtg-sensor-${name}"
  systemctl daemon-reload
}

# Debian splits ensurepip into a separate package; without python3-venv,
# "python3 -m venv" fails with a message that helps nobody. The package name
# is fixed in the script: the management channel cannot be used to pull in
# arbitrary packages through it.
ensure_venv_support() {
  if python3 -c 'import ensurepip, venv' >/dev/null 2>&1; then
    return 0
  fi

  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get update >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y python3-venv \
      >/dev/null 2>&1 || true
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y python3 >/dev/null 2>&1 || true
  fi

  python3 -c 'import ensurepip, venv' >/dev/null 2>&1
}

# Some sensors need a distribution program rather than a PyPI package. The
# mapping is fixed in the script, for the same reason as python3-venv: the
# management channel cannot be used to pull arbitrary packages through it.
# Release-owned executables such as iperf3 do not belong here; they travel as
# signed managed tools and never fall back to the distribution.
#
# What a sensor needs from the system, as "PROGRAM PACKAGE...". The program
# is what the check looks for, the packages are the ways to get it - tried in
# order, first one that provides the program wins.
#
# wlan-auth asks for busybox, whose udhcpc carries out the DHCP stage. It is
# already on every Raspberry Pi OS, so this normally installs nothing.
sensor_system_package() {
  case "$1" in
    wlan-auth)
      printf 'busybox busybox\n'
      ;;
    *)
      :
      ;;
  esac
}

# Installs a sensor's system package afterwards, in case it is missing.
#
# A failure deliberately does not abort the deployment transaction: the
# sensor's self-test reports a missing tool anyway, and activation then
# restores the previous state. Checking this one place is better than having
# two places that catch the same thing.
ensure_sensor_package() {
  local specification="$1"
  local package=""
  local program=""
  local -a fields=()
  local -a candidates=()

  [[ -n "${specification}" ]] || return 0
  read -r -a fields <<< "${specification}"
  program="${fields[0]}"
  candidates=("${fields[@]:1}")
  [[ -n "${program}" && "${#candidates[@]}" -gt 0 ]] || return 0
  command -v "${program}" >/dev/null 2>&1 && return 0

  # No recommends: a probe gets the tool a sensor asks for, not the set of
  # programs a desktop would want alongside it.
  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get update >/dev/null 2>&1 || true
    for package in "${candidates[@]}"; do
      DEBIAN_FRONTEND=noninteractive apt-get install -y \
        --no-install-recommends "${package}" >/dev/null 2>&1 || continue
      command -v "${program}" >/dev/null 2>&1 && break
    done
  elif command -v dnf >/dev/null 2>&1; then
    for package in "${candidates[@]}"; do
      dnf install -y "${package}" >/dev/null 2>&1 || continue
      command -v "${program}" >/dev/null 2>&1 && break
    done
  fi

  command -v "${program}" >/dev/null 2>&1 || return 1
  quiesce_sensor_daemon "${program}"
}

# A tool installed for a sensor must not bring a daemon along with it.
#
# dhcpcd5 activates dhcpcd.service, which would then run alongside
# NetworkManager and fight it over every interface no test has reserved. The
# sensor calls the binary directly and wants nothing running in between.
#
# Only reached right after an install, so a probe that was already using the
# daemon for its own networking is never touched: the check above returns
# early when the program is present.
quiesce_sensor_daemon() {
  local unit="$1.service"

  systemctl list-unit-files "${unit}" >/dev/null 2>&1 || return 0
  systemctl cat "${unit}" >/dev/null 2>&1 || return 0
  systemctl disable --now "${unit}" >/dev/null 2>&1 || true
  systemctl mask "${unit}" >/dev/null 2>&1 || true
  return 0
}

# Establishes the prerequisites for sensors with dependencies and reports
# the state. Without this command, a missing python3-venv would only show up
# in the middle of a deployment transaction.
prepare_sensor_host() {
  local python_version=""

  python_version="$(
    python3 -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' \
      2>/dev/null || true
  )"
  [[ -n "${python_version}" ]] || die "Python 3 is not installed on this probe"
  ensure_venv_support ||
    die "Could not enable Python virtual environments (python3-venv)"
  printf 'OK sensor-prepared python=%s venv=ready\n' "${python_version}"
}

create_sensor_venv() {
  local name="$1"
  local requirements="$2"
  local service_user="$3"
  local venv="${SENSOR_VENV_ROOT}/${name}"

  # Debian blocks system-wide installation since PEP 668. Every sensor
  # with dependencies therefore gets its own environment. An internal
  # package mirror is configured on the probe via /etc/pip.conf.
  ensure_venv_support ||
    die "Python virtual environments are unavailable; python3-venv is missing"
  install -d -o root -g root -m 0755 "${SENSOR_VENV_ROOT}"
  rm -rf -- "${venv}"
  python3 -m venv "${venv}" >/dev/null 2>&1 ||
    die "Could not create a virtual environment for ${name}"
  "${venv}/bin/pip" install \
    --quiet --disable-pip-version-check --require-virtualenv \
    --requirement "${requirements}" >/dev/null 2>&1 ||
    die "Could not install the dependencies of ${name}"
  # python3 -m venv inherits this helper's umask 077 and creates the whole
  # environment for root only. The installed script's shebang points at this
  # interpreter though, and the service user has to start it - without the
  # following two lines even the self-test fails on missing permissions.
  # The same split as for the script itself: owned by root, access for the
  # group, nothing for anyone else. The capital X sets the x bit only where
  # it already is - directories and programs, not a library.
  chown -R "root:${service_user}" "${venv}"
  chmod -R go-w,g+rX "${venv}"
  printf '%s\n' "${venv}"
}

prepare_sensor_tool_transaction() {
  local transaction="$1"
  local name="$2"
  local tool=""
  local platform=""

  tool="$(managed_tool_for_sensor "${name}")"
  [[ -n "${tool}" ]] || return 0
  if [[ -f "${transaction}/tool-source" ]]; then
    case "$(<"${transaction}/tool-source")" in
      managed)
        [[ -f "${transaction}/tool-binary" ]] ||
          die "The staged managed tool is incomplete"
        return 0
        ;;
      system)
        [[ -f "${transaction}/tool-name" &&
           -f "${transaction}/tool-platform" &&
           -f "${transaction}/tool-minimum-version" ]] ||
          die "The staged system tool fallback is incomplete"
        return 0
        ;;
      *)
        die "The staged sensor tool source is invalid"
        ;;
    esac
  fi

  platform="$(probe_platform)"
  [[ "${platform}" != *unknown* ]] ||
    die "The probe userspace platform could not be determined"
  if managed_tool_has_release_artifact "${tool}" "${platform}"; then
    die "Sensor ${name} requires its signed ${tool} release artifact"
  fi

  # A system executable is accepted only outside the release matrix. The
  # helper fixes both package and path; the management caller cannot turn the
  # fallback into an arbitrary root executable.
  printf '%s\n' "${tool}" > "${transaction}/tool-name"
  printf 'system\n' > "${transaction}/tool-source"
  printf '%s\n' "${platform}" > "${transaction}/tool-platform"
  printf '%s\n' "${SYSTEM_IPERF_MIN_VERSION}" \
    > "${transaction}/tool-minimum-version"
  chmod 0600 "${transaction}"/tool-{name,source,platform,minimum-version}
}

record_managed_tool_original() {
  local transaction="$1"
  local name="$2"
  local tool=""
  local current=""
  local metadata=""

  [[ -f "${transaction}/tool-name" ]] || return 0
  tool="$(<"${transaction}/tool-name")"
  current="$(managed_tool_current_link "${tool}")"
  metadata="$(managed_tool_metadata_path "${name}")"
  if [[ -L "${current}" ]]; then
    readlink "${current}" > "${transaction}/original-tool-current"
  elif [[ -e "${current}" ]]; then
    die "Managed tool current path is not a symbolic link: ${current}"
  else
    : > "${transaction}/original-tool-current-absent"
  fi
  if [[ -f "${metadata}" ]]; then
    cp -p "${metadata}" "${transaction}/original-tool-metadata"
  else
    : > "${transaction}/original-tool-metadata-absent"
  fi
  chmod 0600 "${transaction}"/original-tool-*
}

install_managed_tool() {
  local transaction="$1"
  local name="$2"
  local tool=""
  local version=""
  local platform=""
  local expected_sha256=""
  local binary_name=""
  local tool_root=""
  local release=""
  local target=""
  local incoming=""
  local current=""
  local next_link=""
  local metadata=""
  local actual_sha256=""

  [[ -f "${transaction}/tool-binary" ]] || return 0
  tool="$(<"${transaction}/tool-name")"
  version="$(<"${transaction}/tool-version")"
  platform="$(<"${transaction}/tool-platform")"
  expected_sha256="$(<"${transaction}/tool-sha256")"
  binary_name="$(managed_tool_binary_name "${tool}")"
  tool_root="${SENSOR_TOOL_ROOT}/${tool}"
  release="${tool_root}/${version}/${platform}"
  target="${release}/${binary_name}"
  incoming="${release}/.${binary_name}.incoming"
  current="$(managed_tool_current_link "${tool}")"
  next_link="${tool_root}/.current-${BASHPID}"
  metadata="$(managed_tool_metadata_path "${name}")"

  install -d -o root -g root -m 0755 \
    "${SENSOR_TOOL_ROOT}" "${tool_root}" "${tool_root}/${version}" "${release}"
  if managed_tool_path_is_trusted "${target}"; then
    actual_sha256="$(sha256sum "${target}" | awk '{print $1}')"
  fi
  if [[ "${actual_sha256}" != "${expected_sha256}" ]]; then
    # Never inspect or execute an untrusted cache entry. Replace a changed
    # owner, mode, symlink or digest atomically from the already verified
    # transaction payload, then validate the installed root-owned bytes.
    rm -f -- "${incoming}"
    install -o root -g root -m 0755 "${transaction}/tool-binary" "${incoming}"
    actual_sha256="$(sha256sum "${incoming}" | awk '{print $1}')"
    [[ "${actual_sha256}" == "${expected_sha256}" ]] || {
      rm -f -- "${incoming}"
      die "The staged managed tool differs from the approved artifact"
    }
    mv -Tf -- "${incoming}" "${target}"
  fi
  chown root:root "${target}"
  chmod 0755 "${target}"
  managed_tool_path_is_trusted "${target}" ||
    die "The managed tool cache is not a trusted root-owned executable"
  validate_managed_tool_binary "${tool}" "${version}" "${target}"

  rm -f -- "${next_link}"
  ln -s "${version}/${platform}" "${next_link}"
  mv -Tf -- "${next_link}" "${current}"
  install -d -o root -g root -m 0755 "$(dirname -- "${metadata}")"
  {
    printf 'TOOL=%s\n' "${tool}"
    printf 'SOURCE=managed\n'
    printf 'VERSION=%s\n' "${version}"
    printf 'PLATFORM=%s\n' "${platform}"
    printf 'SHA256=%s\n' "${expected_sha256}"
    printf 'PATH=%s\n' "${target}"
  } > "${metadata}.candidate"
  chmod 0644 "${metadata}.candidate"
  mv -f -- "${metadata}.candidate" "${metadata}"
}

install_system_tool() {
  local transaction="$1"
  local name="$2"
  local tool=""
  local platform=""
  local minimum_version=""
  local system_path=""
  local version=""
  local digest=""
  local tool_root=""
  local current=""
  local next_link=""
  local metadata=""

  tool="$(<"${transaction}/tool-name")"
  platform="$(<"${transaction}/tool-platform")"
  minimum_version="$(<"${transaction}/tool-minimum-version")"
  [[ "${minimum_version}" == "${SYSTEM_IPERF_MIN_VERSION}" ]] ||
    die "The system tool fallback policy does not match this helper"
  managed_tool_has_release_artifact "${tool}" "${platform}" &&
    die "A system tool cannot replace an available managed release artifact"

  case "${tool}" in
    iperf3)
      system_path="${SYSTEM_IPERF_PATH}"
      [[ -x "${system_path}" ]] ||
        die "No system iperf3 exists at ${SYSTEM_IPERF_PATH}; install version ${SYSTEM_IPERF_MIN_VERSION} or newer with the operating system package manager"
      ;;
    *)
      die "Unsupported managed tool: ${tool}"
      ;;
  esac

  validate_system_tool_binary "${tool}" "${system_path}"
  version="$(iperf_binary_version "${system_path}")"
  digest="$(sha256sum "${system_path}" | awk '{print $1}')"

  tool_root="${SENSOR_TOOL_ROOT}/${tool}"
  current="$(managed_tool_current_link "${tool}")"
  next_link="${tool_root}/.current-system-${BASHPID}"
  metadata="$(managed_tool_metadata_path "${name}")"
  install -d -o root -g root -m 0755 \
    "${SENSOR_TOOL_ROOT}" "${tool_root}" "$(dirname -- "${metadata}")"
  rm -f -- "${next_link}"
  ln -s "$(dirname -- "${SYSTEM_IPERF_PATH}")" "${next_link}"
  mv -Tf -- "${next_link}" "${current}"
  {
    printf 'TOOL=%s\n' "${tool}"
    printf 'SOURCE=system\n'
    printf 'VERSION=%s\n' "${version}"
    printf 'MINIMUM_VERSION=%s\n' "${minimum_version}"
    printf 'PLATFORM=%s\n' "${platform}"
    printf 'SHA256=%s\n' "${digest}"
    printf 'PATH=%s\n' "${system_path}"
  } > "${metadata}.candidate"
  chmod 0644 "${metadata}.candidate"
  mv -f -- "${metadata}.candidate" "${metadata}"
}

install_sensor_tool() {
  local transaction="$1"
  local name="$2"
  local source=""

  source="$(<"${transaction}/tool-source")"
  case "${source}" in
    managed)
      install_managed_tool "${transaction}" "${name}"
      ;;
    system)
      install_system_tool "${transaction}" "${name}"
      ;;
    *)
      die "The sensor tool source is invalid"
      ;;
  esac
}

restore_managed_tool() {
  local transaction="$1"
  local name="$2"
  local tool=""
  local current=""
  local next_link=""
  local metadata=""

  [[ -f "${transaction}/tool-name" ]] || return 0
  tool="$(<"${transaction}/tool-name")"
  current="$(managed_tool_current_link "${tool}")"
  next_link="${SENSOR_TOOL_ROOT}/${tool}/.current-restore-${BASHPID}"
  metadata="$(managed_tool_metadata_path "${name}")"
  if [[ -f "${transaction}/original-tool-current" ]]; then
    rm -f -- "${next_link}"
    ln -s "$(<"${transaction}/original-tool-current")" "${next_link}"
    mv -Tf -- "${next_link}" "${current}"
  elif [[ -f "${transaction}/original-tool-current-absent" ]]; then
    rm -f -- "${current}"
  fi
  if [[ -f "${transaction}/original-tool-metadata" ]]; then
    cp -p "${transaction}/original-tool-metadata" "${metadata}.restore"
    mv -f -- "${metadata}.restore" "${metadata}"
  elif [[ -f "${transaction}/original-tool-metadata-absent" ]]; then
    rm -f -- "${metadata}"
  fi
}

install_sensor_files() {
  local transaction="$1"
  local name="$2"
  local service_user="$3"
  local venv=""
  local slot=""
  local prepared="${transaction}/prepared-script"

  install -d -o root -g root -m 0755 \
    "${SENSOR_CONFIG_ROOT}" "${SENSOR_CONFIG_ROOT}/${name}"
  if [[ -n "$(managed_tool_for_sensor "${name}")" ]]; then
    [[ -f "${transaction}/tool-source" ]] ||
      die "Sensor ${name} has no selected tool source"
    install_sensor_tool "${transaction}" "${name}"
  fi
  ensure_sensor_package "$(sensor_system_package "${name}")" || true
  if [[ -f "${transaction}/slot-requirements" ]]; then
    venv="$(create_sensor_venv \
      "${name}" "${transaction}/slot-requirements" "${service_user}")"
  fi

  # The helper and its sudo rule first, then the metadata, the script last:
  # the entry point should never stand there without its foundation.
  if [[ -f "${transaction}/slot-wrapper" ]]; then
    install -o root -g root -m 0755 \
      "${transaction}/slot-wrapper" "$(sensor_slot_target "${name}" wrapper)"
    write_sensor_units "${name}" "${service_user}"
  fi
  for slot in requirements version; do
    [[ -f "${transaction}/slot-${slot}" ]] || continue
    install -o root -g root -m 0644 \
      "${transaction}/slot-${slot}" "$(sensor_slot_target "${name}" "${slot}")"
  done

  cp -p "${transaction}/slot-script" "${prepared}"
  if [[ -n "${venv}" ]]; then
    # The line the catalogue shipped is kept before it is overwritten, because
    # the platform compares the installed script against the catalogue file
    # byte for byte. Without it a sensor with dependencies would report as
    # modified from the moment it is installed, and redeploying would not help
    # - the next install writes the same interpreter back in. list_sensors
    # puts this line in again before it hashes.
    head -n 1 "${transaction}/slot-script" \
      > "$(sensor_shebang_path "${name}")"
    chmod 0644 "$(sensor_shebang_path "${name}")"
    sed -i "1s|^#!.*|#!${venv}/bin/python3|" "${prepared}"
  else
    # A sensor that lost its requirements runs on the system Python again and
    # keeps the shebang it came with. A leftover file would claim otherwise.
    rm -f -- "$(sensor_shebang_path "${name}")"
  fi
  install -o root -g "${service_user}" -m 0750 \
    "${prepared}" "$(sensor_slot_target "${name}" script)"
  rm -f -- "${prepared}"
}

# Undo an activation. Only the slots activate_sensor recorded a "before" for
# are touched: a staged slot without one was never installed, and deleting its
# target would take away the working sensor that is still standing there - the
# rollout failed before it ever replaced anything.
restore_sensor_files() {
  local transaction="$1"
  local name="$2"
  local service_user="$3"
  local slot=""
  local target=""

  for slot in "${SENSOR_SLOTS[@]}"; do
    [[ -f "${transaction}/slot-${slot}" ]] || continue
    target="$(sensor_slot_target "${name}" "${slot}")"
    if [[ -f "${transaction}/original-${slot}" ]]; then
      install -o root -g root -m 0600 \
        "${transaction}/original-${slot}" "${target}.restore"
      chown --reference="${transaction}/original-${slot}" "${target}.restore"
      chmod --reference="${transaction}/original-${slot}" "${target}.restore"
      mv "${target}.restore" "${target}"
    elif [[ -f "${transaction}/original-${slot}-absent" ]]; then
      rm -f -- "${target}"
    fi
  done
  restore_managed_tool "${transaction}" "${name}"
  if [[ -f "$(sensor_slot_target "${name}" wrapper)" ]]; then
    write_sensor_units "${name}" "${service_user}"
  else
    remove_sensor_units "${name}"
  fi
}

# Runs a command the way prtg.mpprobe.service runs its sensor scripts: as
# the service user and with the same hardening.
#
# Without this reproduction the self-test is worthless. A call from the root
# shell has neither NoNewPrivileges nor the restricted address families - so
# it passes even when the sensor fails at exactly those limits in the real
# service context. The properties are read from the running unit, so the
# reproduction stays faithful even if Paessler changes them later.
run_like_probe_service() {
  local service_user="$1"
  local properties=()
  local option=""
  local value=""
  shift

  if ! command -v systemd-run >/dev/null 2>&1; then
    if command -v runuser >/dev/null 2>&1; then
      runuser -u "${service_user}" -- "$@"
      return "$?"
    fi
    die "Neither systemd-run nor runuser is available for the self-check"
  fi

  for option in \
    NoNewPrivileges \
    RestrictSUIDSGID \
    RestrictAddressFamilies \
    RestrictNamespaces \
    LockPersonality \
    PrivateTmp \
    ProtectHome \
    ProtectSystem \
    ProtectKernelModules \
    ProtectKernelTunables; do
    value="$(
      systemctl show "${MPP_SERVICE}" -p "${option}" --value 2>/dev/null || true
    )"
    [[ -n "${value}" ]] || continue
    properties+=(--property="${option}=${value}")
  done

  systemd-run \
    --pipe \
    --quiet \
    --collect \
    --wait \
    --uid="${service_user}" \
    --gid="$(id -gn "${service_user}")" \
    "${properties[@]}" \
    -- "$@"
}

# The counterpart to "the service starts again": a freshly deployed sensor
# script has to run under the MPP service's conditions and deliver valid
# Script v2 JSON. That also proves the whole permission chain up to the
# privileged helper before the transaction completes.
sensor_self_check() {
  local name="$1"
  local service_user="$2"
  local script=""
  local output=""

  script="$(sensor_slot_target "${name}" script)"
  output="$(
    printf -- '--self-check\n' |
      run_like_probe_service "${service_user}" "${script}" 2>/dev/null || true
  )"
  [[ -n "${output}" ]] || return 1
  printf '%s' "${output}" | python3 -c '
import json
import sys

try:
    document = json.loads(sys.stdin.read())
except ValueError:
    sys.exit(1)
sys.exit(0 if document.get("status") == "ok" else 1)
'
}

SENSOR_ACTIVATION_TRANSACTION=""
SENSOR_ACTIVATION_NAME=""
SENSOR_ACTIVATION_SERVICE_USER=""

# The activation owns the per-sensor flock while these traps are installed.
# Keep the active marker after restoring so no newer deployment can start
# before the caller explicitly acknowledges the failure with rollback.
restore_failed_sensor_activation() {
  local restore_status=0

  [[ -n "${SENSOR_ACTIVATION_TRANSACTION}" &&
     -n "${SENSOR_ACTIVATION_NAME}" &&
     -f "${SENSOR_ACTIVATION_TRANSACTION}/activated" &&
     ! -f "${SENSOR_ACTIVATION_TRANSACTION}/activation-complete" &&
     ! -f "${SENSOR_ACTIVATION_TRANSACTION}/activation-restored" ]] ||
    return 0

  set +e
  restore_sensor_files \
    "${SENSOR_ACTIVATION_TRANSACTION}" \
    "${SENSOR_ACTIVATION_NAME}" \
    "${SENSOR_ACTIVATION_SERVICE_USER}"
  restore_status="$?"
  if [[ "${restore_status}" -eq 0 ]]; then
    : > "${SENSOR_ACTIVATION_TRANSACTION}/activation-restored"
    chmod 0600 "${SENSOR_ACTIVATION_TRANSACTION}/activation-restored"
  else
    printf 'ERROR: Could not restore sensor %s after activation failure\n' \
      "${SENSOR_ACTIVATION_NAME}" >&2
  fi
  set -e
  return 0
}

sensor_activation_failure_exit() {
  local exit_status="$1"

  trap - ERR EXIT TERM INT
  restore_failed_sensor_activation
  exit "${exit_status}"
}

sensor_activation_signal_exit() {
  local exit_status="$1"

  trap - ERR EXIT TERM INT
  restore_failed_sensor_activation
  exit "${exit_status}"
}

activate_sensor() {
  local transaction_id="$1"
  local transaction=""
  local name=""
  local service_user=""
  local slot=""
  local target=""
  local activation_state=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  transaction="${TRANSACTION_DIR}/${transaction_id}"
  [[ -f "${transaction}/sensor-name" ]] ||
    die "Unknown or incomplete sensor transaction"
  name="$(<"${transaction}/sensor-name")"
  validate_token "${name}" || die "Invalid sensor name"
  [[ -f "${transaction}/slot-script" ]] ||
    die "A sensor transaction must contain a script"
  [[ -d "${SENSOR_SCRIPT_DIR}" ]] ||
    die "The Script v2 directory is missing: ${SENSOR_SCRIPT_DIR}"
  service_user="$(sensor_service_user)"

  acquire_sensor_transaction_lock "${name}"
  activation_state="$(claim_sensor_activation \
    "${transaction_id}" "${transaction}" "${name}")"
  if [[ "${activation_state}" == "complete" ]]; then
    release_sensor_transaction_lock
    printf 'OK sensor-activated %s\n' "${name}"
    return 0
  fi
  [[ "${activation_state}" == "pending" ]] ||
    die "The sensor activation state is invalid"

  SENSOR_ACTIVATION_TRANSACTION="${transaction}"
  SENSOR_ACTIVATION_NAME="${name}"
  SENSOR_ACTIVATION_SERVICE_USER="${service_user}"
  trap 'sensor_activation_failure_exit "$?"' ERR EXIT
  trap 'sensor_activation_signal_exit 143' TERM
  trap 'sensor_activation_signal_exit 130' INT

  clear_incomplete_sensor_snapshot "${transaction}"
  prepare_sensor_tool_transaction "${transaction}" "${name}"

  for slot in "${SENSOR_SLOTS[@]}"; do
    [[ -f "${transaction}/slot-${slot}" ]] || continue
    target="$(sensor_slot_target "${name}" "${slot}")"
    if [[ -f "${target}" ]]; then
      cp -p "${target}" "${transaction}/original-${slot}"
    else
      : > "${transaction}/original-${slot}-absent"
      chmod 0600 "${transaction}/original-${slot}-absent"
    fi
  done
  record_managed_tool_original "${transaction}" "${name}"

  # From here on the installed state is ours to undo, and the "before" of every
  # slot above is on disk. A rollback that arrives without this marker belongs
  # to a transaction that never got this far and therefore has nothing to
  # restore.
  : > "${transaction}/activated"
  chmod 0600 "${transaction}/activated"

  install_sensor_files "${transaction}" "${name}" "${service_user}"
  if ! sensor_self_check "${name}" "${service_user}"; then
    die "Sensor ${name} failed its self-check; the previous state was restored"
  fi
  : > "${transaction}/activation-complete"
  chmod 0600 "${transaction}/activation-complete"
  trap - ERR EXIT TERM INT
  SENSOR_ACTIVATION_TRANSACTION=""
  SENSOR_ACTIVATION_NAME=""
  SENSOR_ACTIVATION_SERVICE_USER=""
  release_sensor_transaction_lock
  printf 'OK sensor-activated %s\n' "${name}"
}

rollback_sensor() {
  local transaction_id="$1"
  local transaction=""
  local name=""
  local active_transaction=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  transaction="${TRANSACTION_DIR}/${transaction_id}"
  [[ -f "${transaction}/sensor-name" ]] ||
    die "Unknown or incomplete sensor transaction"
  name="$(<"${transaction}/sensor-name")"
  validate_token "${name}" || die "Invalid sensor name"
  acquire_sensor_transaction_lock "${name}"
  # A transaction that never reached activation left the installed sensor
  # untouched. Restoring it would mean removing files this transaction never
  # wrote - the rollout that failed while staging must not take the working
  # sensor down with it.
  if [[ ! -f "${transaction}/activated" ]]; then
    active_transaction="$(read_active_sensor_transaction "${name}")"
    if [[ "${active_transaction}" == "${transaction_id}" ]]; then
      clear_active_sensor_transaction "${transaction_id}" "${name}"
    fi
    rm -rf -- "${transaction}"
    release_sensor_transaction_lock
    printf 'OK sensor-rolled-back %s nothing-to-restore\n' "${name}"
    return 0
  fi
  require_active_sensor_transaction "${transaction_id}" "${name}"
  if [[ ! -f "${transaction}/activation-restored" ]]; then
    restore_sensor_files "${transaction}" "${name}" "$(sensor_service_user)"
  fi
  clear_active_sensor_transaction "${transaction_id}" "${name}"
  rm -rf -- "${transaction}"
  release_sensor_transaction_lock
  printf 'OK sensor-rolled-back %s\n' "${name}"
}

recover_sensor_transaction() {
  local name="$1"
  local expected_transaction_id="$2"
  local active_transaction_id=""
  local transaction=""
  local transaction_name=""
  local committed_name=""

  validate_token "${name}" || die "Invalid sensor name"
  validate_token "${expected_transaction_id}" || die "Invalid transaction ID"
  acquire_sensor_transaction_lock "${name}"
  active_transaction_id="$(read_active_sensor_transaction "${name}")"
  if [[ -z "${active_transaction_id}" ]]; then
    if committed_name="$(committed_sensor_transaction_name \
      "${expected_transaction_id}")"; then
      [[ "${committed_name}" == "${name}" ]] ||
        die "The committed transaction belongs to a different sensor"
      release_sensor_transaction_lock
      printf 'OK sensor-recovered %s transaction=%s already-committed\n' \
        "${name}" "${expected_transaction_id}"
      return 0
    fi
    release_sensor_transaction_lock
    printf 'OK sensor-recovered %s transaction=%s no-active\n' \
      "${name}" "${expected_transaction_id}"
    return 0
  fi
  [[ "${active_transaction_id}" == "${expected_transaction_id}" ]] ||
    die_active_sensor_transaction "${active_transaction_id}" \
      "Sensor ${name} has another active transaction; recovery requested ${expected_transaction_id}"

  transaction="${TRANSACTION_DIR}/${expected_transaction_id}"
  # A commit tombstone is authoritative even if its final marker cleanup was
  # interrupted. Finish that cleanup; restoring its snapshot would undo a
  # deployment that already committed.
  if committed_name="$(committed_sensor_transaction_name \
    "${expected_transaction_id}")"; then
    [[ "${committed_name}" == "${name}" ]] ||
      die "The committed transaction belongs to a different sensor"
    clear_active_sensor_transaction "${expected_transaction_id}" "${name}"
    rm -rf -- "${transaction}"
    release_sensor_transaction_lock
    printf 'OK sensor-recovered %s transaction=%s already-committed\n' \
      "${name}" "${expected_transaction_id}"
    return 0
  fi

  [[ -d "${transaction}" && ! -L "${transaction}" &&
     -f "${transaction}/sensor-name" ]] ||
    die "The active sensor transaction is missing or incomplete"
  transaction_name="$(<"${transaction}/sensor-name")"
  validate_token "${transaction_name}" ||
    die "The active sensor transaction has an invalid sensor name"
  [[ "${transaction_name}" == "${name}" ]] ||
    die "The active transaction belongs to a different sensor"

  if [[ -f "${transaction}/activated" &&
        ! -f "${transaction}/activation-restored" ]]; then
    restore_sensor_files "${transaction}" "${name}" "$(sensor_service_user)"
  fi
  clear_active_sensor_transaction "${expected_transaction_id}" "${name}"
  rm -rf -- "${transaction}"
  release_sensor_transaction_lock
  printf 'OK sensor-recovered %s transaction=%s rolled-back\n' \
    "${name}" "${expected_transaction_id}"
}

commit_sensor() {
  local transaction_id="$1"
  local transaction=""
  local name=""
  local transaction_name=""
  local committed_name=""
  local active_transaction=""

  validate_token "${transaction_id}" || die "Invalid transaction ID"
  transaction="${TRANSACTION_DIR}/${transaction_id}"

  # A successful commit may have reached the probe even when its SSH response
  # did not reach the caller. The tombstone makes that exact retry successful
  # without consulting or modifying whichever deployment is active now.
  if committed_name="$(committed_sensor_transaction_name \
    "${transaction_id}")"; then
    # Recovery after interruption between writing the tombstone and deleting
    # the transaction. Inspecting the transaction only after taking the lock
    # also closes the response-loss race where the first commit deletes it
    # while this retry is waiting. A newer marker is deliberately untouched.
    acquire_sensor_transaction_lock "${committed_name}"
    if [[ -e "${transaction}" ]]; then
      [[ -d "${transaction}" && ! -L "${transaction}" &&
         -f "${transaction}/sensor-name" ]] ||
        die "The committed sensor transaction path is invalid"
      transaction_name="$(<"${transaction}/sensor-name")"
      [[ "${transaction_name}" == "${committed_name}" ]] ||
        die "The committed transaction belongs to a different sensor"
    fi
    active_transaction="$(read_active_sensor_transaction "${committed_name}")"
    if [[ "${active_transaction}" == "${transaction_id}" ]]; then
      clear_active_sensor_transaction \
        "${transaction_id}" "${committed_name}"
    fi
    rm -rf -- "${transaction}"
    release_sensor_transaction_lock
    printf 'OK sensor-committed %s\n' "${committed_name}"
    return 0
  fi

  [[ -f "${transaction}/sensor-name" ]] ||
    die "Unknown or incomplete sensor transaction"
  name="$(<"${transaction}/sensor-name")"
  validate_token "${name}" || die "Invalid sensor name"

  acquire_sensor_transaction_lock "${name}"
  # A duplicate request can have waited here while the first request wrote
  # its tombstone and finished. Re-check after taking the lock so that
  # overlapping retries are idempotent as well as sequential ones.
  if committed_name="$(committed_sensor_transaction_name \
    "${transaction_id}")"; then
    [[ "${committed_name}" == "${name}" ]] ||
      die "The committed transaction belongs to a different sensor"
    active_transaction="$(read_active_sensor_transaction "${name}")"
    if [[ "${active_transaction}" == "${transaction_id}" ]]; then
      clear_active_sensor_transaction "${transaction_id}" "${name}"
    fi
    rm -rf -- "${transaction}"
    release_sensor_transaction_lock
    printf 'OK sensor-committed %s\n' "${name}"
    return 0
  fi
  require_active_sensor_transaction "${transaction_id}" "${name}"
  [[ -f "${transaction}/activation-complete" ]] ||
    die "Sensor transaction ${transaction_id} has not completed activation"

  # The tombstone is authoritative before either live marker is removed. A
  # retry can therefore finish cleanup safely after an interruption at any
  # later instruction.
  record_sensor_commit_tombstone "${transaction_id}" "${name}"
  clear_active_sensor_transaction "${transaction_id}" "${name}"
  rm -rf -- "${transaction}"
  release_sensor_transaction_lock
  printf 'OK sensor-committed %s\n' "${name}"
}

managed_tool_metadata_value() {
  local path="$1"
  local key="$2"

  [[ -f "${path}" ]] || return 0
  sed -n "s/^${key}=//p" "${path}" | head -n 1
}

sensor_tool_fields() {
  local name="$1"
  local tool=""
  local binary_name=""
  local current=""
  local metadata=""
  local version="none"
  local platform="none"
  local digest="none"
  local source="none"
  local path="none"
  local configured_version=""
  local configured_digest=""
  local candidate=""
  local expected_path=""
  local current_target=""
  local compatible="no"

  tool="$(managed_tool_for_sensor "${name}")"
  if [[ -z "${tool}" ]]; then
    printf 'tool=none\ttool_version=none\ttool_platform=none\ttool_sha256=none\ttool_source=none\ttool_path=none\ttool_compatible=none'
    return 0
  fi
  binary_name="$(managed_tool_binary_name "${tool}")"
  current="$(managed_tool_current_link "${tool}")"
  metadata="$(managed_tool_metadata_path "${name}")"
  configured_version="$(managed_tool_metadata_value "${metadata}" VERSION)"
  configured_digest="$(managed_tool_metadata_value "${metadata}" SHA256)"
  platform="$(managed_tool_metadata_value "${metadata}" PLATFORM)"
  source="$(managed_tool_metadata_value "${metadata}" SOURCE)"
  [[ -n "${source}" ]] || source="none"
  [[ -n "${platform}" ]] || platform="none"
  candidate="${current}/${binary_name}"
  if [[ -e "${candidate}" || -L "${candidate}" ]]; then
    path="$(readlink -f "${candidate}" 2>/dev/null || true)"
    [[ -n "${path}" ]] || path="none"
    case "${tool}" in
      iperf3)
        case "${source}" in
          managed)
            expected_path="${SENSOR_TOOL_ROOT}/${tool}/${configured_version}/${platform}/${binary_name}"
            current_target="$(readlink "${current}" 2>/dev/null || true)"
            # Trust and exact release path come before reading or executing the
            # binary. A writable, foreign-owned or symlinked target is status
            # drift, never root code that sensor-list should start.
            if [[ -L "${current}" &&
                  "${current_target}" == "${configured_version}/${platform}" &&
                  "${path}" == "${expected_path}" ]] &&
              managed_tool_path_is_trusted "${candidate}"; then
              digest="$(sha256sum "${candidate}" | awk '{print $1}')"
              # The signed digest is part of the trust boundary too. A
              # root-owned file with different bytes is drift to replace, not
              # a program sensor-list may start as root to identify it.
              if [[ "${digest}" == "${configured_digest}" ]]; then
                if ! version="$(iperf_binary_version \
                  "${candidate}" 2>/dev/null)"; then
                  version="none"
                fi
                [[ -n "${version}" ]] || version="none"
                if iperf_binary_has_authentication "${candidate}" &&
                  [[ "${version}" == "${configured_version}" ]] &&
                  managed_tool_has_release_artifact \
                    "${tool}" "${platform}"; then
                  compatible="yes"
                fi
              fi
            fi
            ;;
          system)
            # Do not execute a system path after its ownership or mode has
            # drifted. The same trust check guards install and observation.
            if system_tool_path_is_trusted "${path}"; then
              digest="$(sha256sum "${path}" | awk '{print $1}')"
              if ! version="$(iperf_binary_version \
                "${candidate}" 2>/dev/null)"; then
                version="none"
              fi
              [[ -n "${version}" ]] || version="none"
              if iperf_binary_has_authentication "${candidate}" &&
                version_at_least \
                  "${version}" "${SYSTEM_IPERF_MIN_VERSION}" &&
                ! managed_tool_has_release_artifact \
                  "${tool}" "${platform}"; then
                compatible="yes"
              fi
            fi
            ;;
        esac
        ;;
    esac
  fi
  printf 'tool=%s\ttool_version=%s\ttool_platform=%s\ttool_sha256=%s\ttool_source=%s\ttool_path=%s\ttool_compatible=%s' \
    "${tool}" "${version}" "${platform}" "${digest}" \
    "${source}" "${path}" "${compatible}"
}

list_sensors() {
  local directory=""
  local name=""
  local script=""
  local version=""

  printf 'OK sensor-list\n'
  shopt -s nullglob
  for directory in "${SENSOR_CONFIG_ROOT}"/*/; do
    name="$(basename -- "${directory}")"
    validate_token "${name}" || continue
    script="$(sensor_slot_target "${name}" script)"
    [[ -f "${script}" ]] || continue
    version="none"
    [[ ! -f "${directory}version" ]] || version="$(<"${directory}version")"
    printf '%s\tversion=%s\tsha256=%s\tinterfaces=%s\thelper=%s\thelper_sha256=%s\t%s\n' \
      "${name}" \
      "${version}" \
      "$(sensor_script_checksum "${name}" "${script}")" \
      "$(sensor_interface_list "${name}")" \
      "$(sensor_helper_state "${name}")" \
      "$(sensor_helper_checksum "${name}")" \
      "$(sensor_tool_fields "${name}")"
  done
  shopt -u nullglob
}

# The digest the platform holds is the one of the catalogue file, so this is
# the one that has to be answered - and the installed script differs from it
# by exactly the shebang install_sensor_files rewrote. That line goes back in
# first, and only where this helper is the one that wrote it: a shebang
# anybody else changed points the sensor at another interpreter and stays
# visible as the deviation it is.
sensor_script_checksum() {
  local name="$1"
  local script="$2"
  local shebang=""
  local own=""

  shebang="$(sensor_shebang_path "${name}")"
  own="#!${SENSOR_VENV_ROOT}/${name}/bin/python3"
  if [[ -f "${shebang}" && "$(head -n 1 "${script}")" == "${own}" ]]; then
    { cat "${shebang}"; tail -n +2 "${script}"; } |
      sha256sum |
      awk '{print $1}'
    return 0
  fi
  sha256sum "${script}" | awk '{print $1}'
}

# A sensor without a listening socket only reports in PRTG that it cannot
# reach its helper. The state therefore belongs in the overview.
# The digest of the privileged helper, so a platform can tell an installed
# one from the catalogue's.
#
# No shebang dance as in sensor_script_checksum: a helper is installed byte
# for byte, only the sensor script has its interpreter line rewritten to
# point at a virtual environment.
sensor_helper_checksum() {
  local wrapper=""

  wrapper="$(sensor_slot_target "$1" wrapper)"
  [[ -f "${wrapper}" ]] || {
    printf 'none\n'
    return 0
  }
  sha256sum "${wrapper}" | awk '{print $1}'
}

sensor_helper_state() {
  local name="$1"

  [[ -f "$(sensor_slot_target "${name}" wrapper)" ]] || {
    printf 'none\n'
    return 0
  }
  if systemctl is-active --quiet "prtg-sensor-${name}.socket"; then
    printf 'listening\n'
  else
    printf 'inactive\n'
  fi
}

sensor_interface_list() {
  local allowed="${SENSOR_CONFIG_ROOT}/$1/allowed-interfaces"

  [[ -f "${allowed}" ]] || {
    printf 'none\n'
    return 0
  }
  paste -s -d ',' -- "${allowed}" 2>/dev/null || printf 'none\n'
}

default_route_interfaces() {
  ip -o route show default 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") print $(i + 1) }' |
    sort -u
}

# One shared file for all reserved interfaces. Several files with the same
# key would displace each other in NetworkManager.
write_sensor_nm_configuration() {
  local interfaces=()
  local entry=""
  local specification=""
  local file=""
  local candidate="${SENSOR_NM_CONFIG}.candidate"

  [[ -d /etc/NetworkManager ]] || return 0
  shopt -s nullglob
  for file in "${SENSOR_CONFIG_ROOT}"/*/allowed-interfaces; do
    while IFS= read -r entry; do
      [[ -n "${entry}" ]] && interfaces+=("${entry}")
    done < "${file}"
  done
  shopt -u nullglob

  if [[ "${#interfaces[@]}" -eq 0 ]]; then
    rm -f -- "${SENSOR_NM_CONFIG}"
  else
    while IFS= read -r entry; do
      specification+="interface-name:${entry};"
    done < <(printf '%s\n' "${interfaces[@]}" | sort -u)
    install -d -o root -g root -m 0755 "$(dirname -- "${SENSOR_NM_CONFIG}")"
    {
      printf '# Generated by prtg-nats. These interfaces are reserved\n'
      printf '# for sensor tests and are not managed by NetworkManager.\n'
      printf '# Do not edit by hand.\n'
      printf '[keyfile]\n'
      printf 'unmanaged-devices=%s\n' "${specification%;}"
    } > "${candidate}"
    chmod 0644 "${candidate}"
    mv "${candidate}" "${SENSOR_NM_CONFIG}"
  fi
  if command -v nmcli >/dev/null 2>&1; then
    nmcli general reload conf >/dev/null 2>&1 || true
  fi
}

# Which radio interfaces this probe has, and what would be lost by taking one
# for tests. The reservation is a decision somebody has to make, and making it
# blind - from a name typed into a form - is how a probe loses the link it
# was actually using.
#
# Deliberately reports rather than judges: an interface carrying a default
# route is listed like any other, with the fact attached. Refusing is
# reserve_sensor_interface's job, and the two would drift apart if this made
# the same call a second time.
wireless_interfaces() {
  local path=""
  local interface=""
  local reserved=""
  local file=""
  local owner=""
  local routes=""
  local operstate=""
  local nm_state=""
  local connection=""

  printf 'OK wireless-interfaces\n'
  routes="$(default_route_interfaces | paste -s -d ',' - || true)"
  shopt -s nullglob
  for path in /sys/class/net/*/wireless; do
    interface="$(basename -- "$(dirname -- "${path}")")"
    validate_token "${interface}" || continue

    reserved="none"
    for file in "${SENSOR_CONFIG_ROOT}"/*/allowed-interfaces; do
      grep -q -x -- "${interface}" "${file}" 2>/dev/null || continue
      owner="$(basename -- "$(dirname -- "${file}")")"
      reserved="${owner}"
      break
    done

    operstate="unknown"
    [[ ! -r "/sys/class/net/${interface}/operstate" ]] ||
      operstate="$(<"/sys/class/net/${interface}/operstate")"

    # What NetworkManager thinks it is doing with the interface, and under
    # which connection. Both stay empty where nmcli is absent - the interface
    # is then simply not managed by anything that could object.
    nm_state="unknown"
    connection="none"
    if command -v nmcli >/dev/null 2>&1; then
      nm_state="$(
        nmcli -t -f DEVICE,STATE device 2>/dev/null |
          awk -F: -v d="${interface}" '$1 == d { print $2; exit }'
      )"
      connection="$(
        nmcli -t -f DEVICE,CONNECTION device 2>/dev/null |
          awk -F: -v d="${interface}" '$1 == d { print $2; exit }'
      )"
      [[ -n "${nm_state}" ]] || nm_state="unknown"
      [[ -n "${connection}" && "${connection}" != "--" ]] || connection="none"
    fi

    printf '%s\treserved=%s\tdefault_route=%s\toperstate=%s\tnm_state=%s\tconnection=%s\n' \
      "${interface}" \
      "${reserved}" \
      "$(printf '%s' ",${routes}," | grep -q ",${interface}," && printf 'yes' || printf 'no')" \
      "${operstate}" \
      "${nm_state}" \
      "${connection}"
  done
  shopt -u nullglob
}

# Reserves a Wi-Fi interface as the test interface.
#
# The check deliberately allows an interface that still carries a default
# route - that is exactly how NetworkManager hands it over. It refuses only
# when it would be the host's only default route: the reservation would then
# cut the management path and the probe's connection to the NATS server.
reserve_sensor_interface() {
  local name="$1"
  local interface="$2"
  local allowed=""
  local remaining=0

  validate_token "${name}" || die "Invalid sensor name"
  [[ "${interface}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,15}$ ]] ||
    die "Invalid interface name"
  [[ -d "/sys/class/net/${interface}" ]] ||
    die "Interface does not exist: ${interface}"
  [[ -e "/sys/class/net/${interface}/wireless" ]] ||
    die "Interface is not a wireless interface: ${interface}"
  remaining="$(default_route_interfaces | grep -v -x -- "${interface}" | wc -l)"
  [[ "${remaining}" -ge 1 ]] ||
    die "Interface ${interface} carries the only default route of this host"

  install -d -o root -g root -m 0755 \
    "${SENSOR_CONFIG_ROOT}" "${SENSOR_CONFIG_ROOT}/${name}"
  allowed="${SENSOR_CONFIG_ROOT}/${name}/allowed-interfaces"
  touch "${allowed}"
  if ! grep -q -x -- "${interface}" "${allowed}"; then
    printf '%s\n' "${interface}" >> "${allowed}"
  fi
  sort -u -o "${allowed}" "${allowed}"
  chmod 0644 "${allowed}"
  write_sensor_nm_configuration

  # NetworkManager releases the interface but leaves address and route in
  # place. Both have to go, or the test refuses the interface - and the host
  # would keep a route over a network that is about to be tested.
  if command -v nmcli >/dev/null 2>&1; then
    nmcli device set "${interface}" managed no >/dev/null 2>&1 || true
  fi
  ip addr flush dev "${interface}" >/dev/null 2>&1 || true
  ip link set "${interface}" down >/dev/null 2>&1 || true
  printf 'OK sensor-interface-reserved %s %s\n' "${name}" "${interface}"
}

release_sensor_interfaces() {
  local name="$1"
  local allowed="${SENSOR_CONFIG_ROOT}/${name}/allowed-interfaces"
  local interface=""

  [[ -f "${allowed}" ]] || return 0
  while IFS= read -r interface; do
    [[ -n "${interface}" ]] || continue
    if command -v nmcli >/dev/null 2>&1; then
      nmcli device set "${interface}" managed yes >/dev/null 2>&1 || true
    fi
  done < "${allowed}"
  rm -f -- "${allowed}"
  write_sensor_nm_configuration
}

# Counterpart to reserve_sensor_interface for a single interface. Without
# it, an accidental reservation would persist until the whole sensor is
# removed - and that takes the profiles with it.
release_sensor_interface() {
  local name="$1"
  local interface="$2"
  local allowed=""
  local remaining=""

  validate_token "${name}" || die "Invalid sensor name"
  [[ "${interface}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,15}$ ]] ||
    die "Invalid interface name"
  allowed="${SENSOR_CONFIG_ROOT}/${name}/allowed-interfaces"
  [[ -f "${allowed}" ]] &&
    grep -q -x -- "${interface}" "${allowed}" ||
    die "Interface ${interface} is not reserved for ${name}"

  remaining="$(grep -v -x -- "${interface}" "${allowed}" || true)"
  if [[ -n "${remaining}" ]]; then
    printf '%s\n' "${remaining}" > "${allowed}"
    chmod 0644 "${allowed}"
  else
    rm -f -- "${allowed}"
  fi
  # The file first, then NetworkManager: the configuration is regenerated
  # from whatever reservations are left.
  write_sensor_nm_configuration
  if command -v nmcli >/dev/null 2>&1; then
    nmcli device set "${interface}" managed yes >/dev/null 2>&1 || true
  fi
  printf 'OK sensor-interface-released %s %s\n' "${name}" "${interface}"
}

write_sensor_profile() {
  local name="$1"
  local profile="$2"
  local directory=""
  local candidate=""
  local mode=""
  local owner=""
  local service_user=""

  validate_token "${name}" || die "Invalid sensor name"
  validate_token "${profile}" || die "Invalid profile name"
  [[ -f "$(sensor_slot_target "${name}" script)" ]] ||
    die "Sensor ${name} is not installed"

  # Who may read the file follows from who has to read it.
  #
  # A sensor with a privileged helper never reads it itself - the helper
  # does, as root, and the file stays invisible to the service user. A
  # sensor without a helper runs as the service user and could not get at
  # it otherwise; there the file belongs to its group, and to it alone.
  #
  # The decision follows what is on disk, not a claim by the caller:
  # otherwise the management channel could be used to make a secret
  # readable that is not supposed to be.
  directory="${SENSOR_CONFIG_ROOT}/${name}/profiles"
  if [[ -f "$(sensor_slot_target "${name}" wrapper)" ]]; then
    install -d -o root -g root -m 0700 \
      "${SENSOR_CONFIG_ROOT}/${name}" "${directory}"
    mode=0600
    owner="root:root"
  else
    service_user="$(sensor_service_user)"
    install -d -o root -g root -m 0755 "${SENSOR_CONFIG_ROOT}/${name}"
    install -d -o root -g "${service_user}" -m 0750 "${directory}"
    mode=0640
    owner="root:${service_user}"
  fi
  candidate="${directory}/${profile}.env.candidate"
  read_limited_input "${candidate}" "${MAXIMUM_INPUT_BYTES}"
  grep -E -q -v '^[[:space:]]*(#.*)?$|^[A-Z][A-Z0-9_]*=' "${candidate}" && {
    rm -f -- "${candidate}"
    die "A credential profile accepts only KEY=VALUE lines"
  }
  chown "${owner}" "${candidate}"
  chmod "${mode}" "${candidate}"
  mv "${candidate}" "${directory}/${profile}.env"
  printf 'OK sensor-profile-written %s %s\n' "${name}" "${profile}"
}

remove_sensor_profile() {
  local name="$1"
  local profile="$2"

  validate_token "${name}" || die "Invalid sensor name"
  validate_token "${profile}" || die "Invalid profile name"
  rm -f -- "${SENSOR_CONFIG_ROOT}/${name}/profiles/${profile}.env"
  printf 'OK sensor-profile-removed %s %s\n' "${name}" "${profile}"
}

# A profile carries KEY=VALUE lines; a certificate or a key does not fit in
# one. It travels as a file of its own, and its path becomes a value in the
# profile - which is how the sensor scripts already expect to be told where
# such a file is.
#
# The name is the key of the profile entry plus an extension, nothing else.
# Deliberately narrower than a file name: the destination is built here from
# validated tokens, so the management channel is not a way to write to an
# arbitrary path even if the far side asked for one.
validate_profile_file_name() {
  [[ "$1" =~ ^[A-Z][A-Z0-9_]*\.[A-Za-z0-9]{1,10}$ ]]
}

write_sensor_file() {
  local name="$1"
  local profile="$2"
  local filename="$3"
  local directory=""
  local encoded=""
  local candidate=""
  local mode=""
  local owner=""
  local service_user=""

  validate_token "${name}" || die "Invalid sensor name"
  validate_token "${profile}" || die "Invalid profile name"
  validate_profile_file_name "${filename}" || die "Invalid profile file name"
  [[ -f "$(sensor_slot_target "${name}" script)" ]] ||
    die "Sensor ${name} is not installed"

  # The same rule as for the profile itself, and for the same reason: who may
  # read it follows from who has to read it, decided by what is on disk rather
  # than by a claim from the caller.
  directory="${SENSOR_CONFIG_ROOT}/${name}/files/${profile}"
  if [[ -f "$(sensor_slot_target "${name}" wrapper)" ]]; then
    install -d -o root -g root -m 0700 \
      "${SENSOR_CONFIG_ROOT}/${name}" \
      "${SENSOR_CONFIG_ROOT}/${name}/files" "${directory}"
    mode=0600
    owner="root:root"
  else
    service_user="$(sensor_service_user)"
    install -d -o root -g root -m 0755 "${SENSOR_CONFIG_ROOT}/${name}"
    install -d -o root -g "${service_user}" -m 0750 \
      "${SENSOR_CONFIG_ROOT}/${name}/files" "${directory}"
    mode=0640
    owner="root:${service_user}"
  fi

  # Base64 on the wire because the channel carries text and a key is bytes.
  encoded="${directory}/${filename}.b64"
  candidate="${directory}/${filename}.candidate"
  read_limited_input "${encoded}" "${MAXIMUM_INPUT_BYTES}"
  if ! base64 -d < "${encoded}" > "${candidate}" 2>/dev/null; then
    rm -f -- "${encoded}" "${candidate}"
    die "Transferred file is not valid base64"
  fi
  rm -f -- "${encoded}"
  [[ -s "${candidate}" ]] || {
    rm -f -- "${candidate}"
    die "Transferred file is empty"
  }
  chown "${owner}" "${candidate}"
  chmod "${mode}" "${candidate}"
  mv "${candidate}" "${directory}/${filename}"
  printf 'OK sensor-file-written %s %s %s\n' "${name}" "${profile}" "${filename}"
}

remove_sensor_file() {
  local name="$1"
  local profile="$2"

  validate_token "${name}" || die "Invalid sensor name"
  validate_token "${profile}" || die "Invalid profile name"
  rm -rf -- "${SENSOR_CONFIG_ROOT:?}/${name}/files/${profile}"
  printf 'OK sensor-files-removed %s %s\n' "${name}" "${profile}"
}

remove_sensor() {
  local name="$1"
  local active_transaction=""

  validate_token "${name}" || die "Invalid sensor name"
  acquire_sensor_transaction_lock "${name}"
  active_transaction="$(read_active_sensor_transaction "${name}")"
  [[ -z "${active_transaction}" ]] ||
    die_active_sensor_transaction "${active_transaction}" \
      "Sensor ${name} has an active transaction; commit or roll it back before removal"
  release_sensor_interfaces "${name}"
  remove_sensor_units "${name}"
  rm -f -- \
    "$(sensor_slot_target "${name}" script)" \
    "$(sensor_slot_target "${name}" wrapper)"
  # The credentials disappear together with the configuration directory.
  rm -rf -- \
    "${SENSOR_CONFIG_ROOT:?}/${name}" \
    "${SENSOR_VENV_ROOT:?}/${name}"
  release_sensor_transaction_lock
  printf 'OK sensor-removed %s\n' "${name}"
}

remove_access() {
  rm -f -- \
    /var/lib/prtg-nats-admin/.ssh/authorized_keys \
    /etc/sudoers.d/prtg-nats-admin
  printf 'OK management-access-removed\n'
}

# Sensors belong to this platform, not to the package. They survive its
# removal as systemd sockets nobody calls any more, so the uninstall counts
# them and says so rather than letting them be found months later.
installed_sensor_count() {
  local directory=""
  local name=""
  local count=0

  shopt -s nullglob
  for directory in "${SENSOR_CONFIG_ROOT}"/*/; do
    name="$(basename -- "${directory}")"
    validate_token "${name}" || continue
    [[ -f "$(sensor_slot_target "${name}" script)" ]] || continue
    count=$((count + 1))
  done
  shopt -u nullglob
  printf '%s\n' "${count}"
}

# The counterpart to install-mpp.sh: takes the probe software back off the
# host. Service, package, the configuration with the NATS CA and the Paessler
# repository the installer registered all go, so nothing keeps offering the
# package on the next update run.
#
# A piece that is already gone is not an error. A host without the package is
# a finished uninstall, and failing there would leave the remaining pieces
# behind - which is the state this command exists to prevent.
uninstall_mpp() {
  local package_version=""
  local package_state="absent"
  local repository_file=""
  local repositories=0

  package_version="$(installed_package_version)"
  systemctl disable --now "${MPP_SERVICE}" >/dev/null 2>&1 || true

  # Registration decides, not the reported version: after an earlier
  # "apt-get remove" the package sits in "config-files" and reports no
  # version, while its configuration stays registered. Purging is what takes
  # that last state with it.
  if command -v dpkg-query >/dev/null 2>&1 &&
    [[ -n "$(
      dpkg-query -W -f '${db:Status-Status}' "${MPP_PACKAGE}" 2>/dev/null || true
    )" ]]; then
    DEBIAN_FRONTEND=noninteractive apt-get purge -y "${MPP_PACKAGE}" \
      >/dev/null 2>&1 || die "Could not remove the ${MPP_PACKAGE} package"
    package_state="purged"
  elif command -v rpm >/dev/null 2>&1 &&
    rpm -q "${MPP_PACKAGE}" >/dev/null 2>&1; then
    dnf remove -y "${MPP_PACKAGE}" >/dev/null 2>&1 ||
      die "Could not remove the ${MPP_PACKAGE} package"
    package_state="removed"
  elif [[ "${package_version}" != "none" ]]; then
    die "No supported package manager to remove ${MPP_PACKAGE}"
  fi

  # Configuration and CA were written by this platform, so they leave with
  # it. The package's own purge does not touch them: it never wrote them.
  rm -rf -- "${MPP_CONFIG_DIR:?}"

  for repository_file in "${MPP_REPOSITORY_FILES[@]}"; do
    [[ -e "${repository_file}" ]] || continue
    rm -f -- "${repository_file}"
    repositories=$((repositories + 1))
  done

  printf 'OK mpp-uninstalled package=%s state=%s repositories=%s sensors=%s\n' \
    "${package_version}" \
    "${package_state}" \
    "${repositories}" \
    "$(installed_sensor_count)"
}

# ---------------------------------------------------------------------------
# The overlay
#
# A WireGuard tunnel to the platform, for the two directions that break when
# the site's own path does: the platform reaching a probe behind NAT, and the
# probe reaching NATS when the site-to-site tunnel is down.
#
# Three modes, and only one of them is about the tunnel itself:
#
#   off    no tunnel at all
#   auto   tunnel up; NATS traffic takes it only while the direct path is down
#   on     tunnel up; NATS traffic always takes it
#
# What makes "auto" honest is where the route lives. wg-quick installs none
# (Table = off); the overlay subnet goes into the main table once, and the
# route to the NATS server goes into a table of its own that a single policy
# rule switches on and off. So the direct path can be measured at any time
# without moving the route that is carrying traffic.
# ---------------------------------------------------------------------------

overlay_mode() {
  [[ -f "${OVERLAY_CONFIG_ENV}" ]] || {
    printf 'off'
    return 0
  }
  sed -n 's/^MODE=//p' "${OVERLAY_CONFIG_ENV}" | head -n 1
}

overlay_config_value() {
  local key="$1"

  [[ -f "${OVERLAY_CONFIG_ENV}" ]] || return 0
  sed -n "s/^${key}=//p" "${OVERLAY_CONFIG_ENV}" | head -n 1
}

ensure_overlay_package() {
  command -v wg >/dev/null 2>&1 && command -v wg-quick >/dev/null 2>&1 &&
    return 0

  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get update >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      --no-install-recommends wireguard-tools >/dev/null 2>&1 || true
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y wireguard-tools >/dev/null 2>&1 || true
  fi

  command -v wg >/dev/null 2>&1 && command -v wg-quick >/dev/null 2>&1 ||
    die "wireguard-tools is not available on this system.
Debian and Ubuntu carry it in the main archive. On RHEL 9 it comes from EPEL,
which this probe does not have enabled - enable it, or leave this probe off
the overlay."
}

ensure_overlay_key() {
  local key=""

  if [[ -s "${OVERLAY_PRIVATE_KEY}" ]]; then
    return 0
  fi
  install -d -o root -g root -m 0755 /etc/prtg-nats
  # Generated here and nowhere else: the private half of a probe's identity
  # has no reason to exist on the platform, so it never travels.
  key="$(wg genkey)" || die "Could not generate an overlay key"
  printf '%s\n' "${key}" > "${OVERLAY_PRIVATE_KEY}.new"
  chmod 0600 "${OVERLAY_PRIVATE_KEY}.new"
  mv -f "${OVERLAY_PRIVATE_KEY}.new" "${OVERLAY_PRIVATE_KEY}"
}

overlay_public_key() {
  [[ -s "${OVERLAY_PRIVATE_KEY}" ]] || return 1
  wg pubkey < "${OVERLAY_PRIVATE_KEY}"
}

write_overlay_routing_table() {
  install -d -o root -g root -m 0755 /etc/iproute2/rt_tables.d
  printf '# Written by prtg-nats. The overlay route to the NATS server.\n%s %s\n' \
    "${OVERLAY_ROUTING_TABLE_ID}" "${OVERLAY_ROUTING_TABLE}" \
    > "${OVERLAY_RT_TABLES}.new"
  chmod 0644 "${OVERLAY_RT_TABLES}.new"
  mv -f "${OVERLAY_RT_TABLES}.new" "${OVERLAY_RT_TABLES}"
}

# The watcher, written here rather than shipped as a second file: it runs as
# root, and anything that installs root code has to arrive under the helper's
# signature. Generating it keeps it inside the one file that is already
# verified before it is replaced (ADR 0006).
write_overlay_watch() {
  cat > "${OVERLAY_WATCH_PATH}.new" <<'WATCHEOF'
#!/usr/bin/env bash
#
# Written by prtg-nats. Do not edit: replaced whenever the overlay is
# configured.
#
# Decides whether the NATS route through the tunnel applies. The route itself
# never moves - it sits in its own table, and this only adds or removes the
# policy rule that points at it.

set -Eeuo pipefail

CONFIG="/etc/prtg-nats/overlay.env"
STATE="/var/lib/prtg-nats-probe-state/overlay-state"
[[ -f "${CONFIG}" ]] || exit 0
# shellcheck source=/dev/null
source "${CONFIG}"

MODE="${MODE:-off}"
INTERFACE="${INTERFACE:-prtgnats0}"
TABLE="${TABLE:-prtgnats}"
PRIORITY="${PRIORITY:-100}"
HANDSHAKE_MAX_AGE="${HANDSHAKE_MAX_AGE:-180}"
FAILURES_REQUIRED="${FAILURES_REQUIRED:-3}"
# Without these there is nothing to decide about, and guessing an address to
# add a routing rule for is the last thing this should do.
[[ -n "${NATS_HOST_IP:-}" && -n "${NATS_PORT:-}" ]] || exit 0

state_value() {
  [[ -f "${STATE}" ]] || return 0
  sed -n "s/^$1=//p" "${STATE}" | head -n 1
}

write_state() {
  printf 'DIRECT_OK=%s\nSTREAK=%s\nDIRECT_DEVICE=%s\nROUTE_ACTIVE=%s\nCHECKED=%s\n' \
    "$1" "$2" "$3" "$4" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "${STATE}.new"
  chmod 0644 "${STATE}.new"
  mv -f "${STATE}.new" "${STATE}"
}

rule_present() {
  ip rule show 2>/dev/null |
    grep -q "^${PRIORITY}:.*to ${NATS_HOST_IP} lookup ${TABLE}"
}

add_rule() {
  rule_present && return 0
  ip rule add to "${NATS_HOST_IP}/32" lookup "${TABLE}" \
    priority "${PRIORITY}" 2>/dev/null || true
}

remove_rule() {
  while rule_present; do
    ip rule del to "${NATS_HOST_IP}/32" lookup "${TABLE}" \
      priority "${PRIORITY}" 2>/dev/null || break
  done
}

# Seconds since the last handshake, or a number large enough to count as
# never. A tunnel without a fresh handshake is not a path to fall back to.
handshake_age() {
  local last=""

  last="$(wg show "${INTERFACE}" latest-handshakes 2>/dev/null |
    awk '{ print $2; exit }')" || last=""
  [[ -n "${last}" && "${last}" != "0" ]] || {
    printf '999999'
    return 0
  }
  printf '%s' "$(($(date +%s) - last))"
}

# The interface the direct path leaves through. While the rule is absent the
# kernel answers with it directly; while the rule is present the answer would
# be the tunnel, so the last known direct device is used instead. Falling back
# to the device that reaches the hub covers the first run after a reboot.
direct_device() {
  local device=""

  if ! rule_present; then
    device="$(ip route get "${NATS_HOST_IP}" 2>/dev/null |
      sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1)"
  fi
  [[ -n "${device}" ]] || device="$(state_value DIRECT_DEVICE)"
  if [[ -z "${device}" && -n "${ENDPOINT_ADDRESS:-}" ]]; then
    device="$(ip route get "${ENDPOINT_ADDRESS}" 2>/dev/null |
      sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1)"
  fi
  [[ "${device}" != "${INTERFACE}" ]] || device=""
  printf '%s' "${device}"
}

# A TCP connection bound to that interface, which is what makes the test
# independent of the rule: the packet leaves the way it would if the tunnel
# were not there at all.
direct_reachable() {
  local device="$1"

  python3 - "${NATS_HOST_IP}" "${NATS_PORT}" "${device}" <<'PYEOF'
import socket
import sys

host, port, device = sys.argv[1], int(sys.argv[2]), sys.argv[3]
connection = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
connection.settimeout(5)
try:
    if device:
        option = getattr(socket, "SO_BINDTODEVICE", 25)
        connection.setsockopt(socket.SOL_SOCKET, option, device.encode() + b"\0")
    connection.connect((host, port))
except OSError:
    sys.exit(1)
finally:
    connection.close()
PYEOF
}

ip route replace "${NATS_HOST_IP}/32" dev "${INTERFACE}" table "${TABLE}" \
  2>/dev/null || true

case "${MODE}" in
  off)
    remove_rule
    write_state "" 0 "$(state_value DIRECT_DEVICE)" "false"
    exit 0
    ;;
  on)
    # Deliberately not conditional. "on" that quietly falls back would be
    # "auto" under another name; a tunnel that is up but not handshaking is
    # reported instead, and the platform raises it.
    add_rule
    write_state "" 0 "$(state_value DIRECT_DEVICE)" "true"
    exit 0
    ;;
esac

device="$(direct_device)"
streak="$(state_value STREAK)"
previous="$(state_value DIRECT_OK)"
[[ "${streak}" =~ ^[0-9]+$ ]] || streak=0

if direct_reachable "${device}"; then
  current="true"
else
  current="false"
fi
if [[ "${current}" == "${previous}" ]]; then
  streak=$((streak + 1))
else
  streak=1
fi

if [[ "${current}" == "true" ]]; then
  ((streak >= FAILURES_REQUIRED)) && remove_rule
elif (($(handshake_age) <= HANDSHAKE_MAX_AGE)); then
  ((streak >= FAILURES_REQUIRED)) && add_rule
else
  # Both paths are down. Keeping the rule would only mean the traffic is lost
  # somewhere else; the direct path is the one that recovers on its own.
  remove_rule
fi

if rule_present; then
  active="true"
else
  active="false"
  [[ -n "${device}" ]] || device="$(state_value DIRECT_DEVICE)"
fi
write_state "${current}" "${streak}" "${device}" "${active}"
WATCHEOF
  chmod 0755 "${OVERLAY_WATCH_PATH}.new"
  mv -f "${OVERLAY_WATCH_PATH}.new" "${OVERLAY_WATCH_PATH}"
}

write_overlay_units() {
  cat > "${SENSOR_UNIT_DIR}/${OVERLAY_UNIT}.service" <<EOF
# Written by prtg-nats. Do not edit.
[Unit]
Description=Decide whether PRTG NATS traffic takes the overlay
After=network-online.target

[Service]
Type=oneshot
ExecStart=${OVERLAY_WATCH_PATH}
EOF
  cat > "${SENSOR_UNIT_DIR}/${OVERLAY_UNIT}.timer" <<EOF
# Written by prtg-nats. Do not edit.
[Unit]
Description=Check the overlay path for PRTG NATS

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target
EOF
  chmod 0644 "${SENSOR_UNIT_DIR}/${OVERLAY_UNIT}.service" \
    "${SENSOR_UNIT_DIR}/${OVERLAY_UNIT}.timer"
  systemctl daemon-reload
}

write_overlay_config() {
  local mode="$1"
  local hub_key="$2"
  local endpoint="$3"
  local address="$4"
  local allowed="$5"
  local keepalive="$6"

  install -d -o root -g root -m 0755 /etc/wireguard
  {
    printf '# Written by prtg-nats. Do not edit: replaced on every change.\n'
    printf '[Interface]\n'
    printf 'PrivateKey = %s\n' "$(<"${OVERLAY_PRIVATE_KEY}")"
    printf 'Address = %s/32\n' "${address}"
    # No routes from wg-quick: the overlay subnet goes into the main table
    # below, and the route to the NATS server into its own table, so a policy
    # rule can switch it without the interface noticing.
    printf 'Table = off\n'
    printf 'PostUp = ip route replace %s dev %%i\n' "${OVERLAY_SUBNET_VALUE}"
    printf 'PostUp = %s || true\n' "${OVERLAY_WATCH_PATH}"
    printf 'PostDown = ip rule del to %s/32 lookup %s priority %s 2>/dev/null || true\n' \
      "${OVERLAY_NATS_HOST_VALUE}" "${OVERLAY_ROUTING_TABLE}" \
      "${OVERLAY_RULE_PRIORITY}"
    printf '\n[Peer]\n'
    printf 'PublicKey = %s\n' "${hub_key}"
    printf 'Endpoint = %s\n' "${endpoint}"
    printf 'AllowedIPs = %s\n' "${allowed}"
    printf 'PersistentKeepalive = %s\n' "${keepalive}"
  } > "${OVERLAY_CONFIG}.new"
  chmod 0600 "${OVERLAY_CONFIG}.new"
  mv -f "${OVERLAY_CONFIG}.new" "${OVERLAY_CONFIG}"

  {
    printf '# Written by prtg-nats. Read by the overlay watcher.\n'
    printf 'MODE=%s\n' "${mode}"
    printf 'INTERFACE=%s\n' "${OVERLAY_INTERFACE}"
    printf 'TABLE=%s\n' "${OVERLAY_ROUTING_TABLE}"
    printf 'PRIORITY=%s\n' "${OVERLAY_RULE_PRIORITY}"
    printf 'NATS_HOST_IP=%s\n' "${OVERLAY_NATS_HOST_VALUE}"
    printf 'NATS_PORT=%s\n' "${OVERLAY_NATS_PORT_VALUE}"
    printf 'ENDPOINT_ADDRESS=%s\n' "${endpoint%:*}"
    printf 'HANDSHAKE_MAX_AGE=180\n'
    printf 'FAILURES_REQUIRED=3\n'
  } > "${OVERLAY_CONFIG_ENV}.new"
  chmod 0600 "${OVERLAY_CONFIG_ENV}.new"
  mv -f "${OVERLAY_CONFIG_ENV}.new" "${OVERLAY_CONFIG_ENV}"
}

configure_overlay() {
  local mode="$1"
  local staged="${STATE_DIR}/overlay-request"
  local hub_key="" endpoint="" address="" subnet="" nats_host="" nats_port=""
  local keepalive="" allowed=""

  case "${mode}" in
    off | auto | on) ;;
    *) die "Unknown overlay mode: ${mode}" ;;
  esac

  read_limited_input "${staged}" "${MAXIMUM_INPUT_BYTES}"
  hub_key="$(sed -n 's/^HUB_PUBLIC_KEY=//p' "${staged}" | head -n 1)"
  endpoint="$(sed -n 's/^ENDPOINT=//p' "${staged}" | head -n 1)"
  address="$(sed -n 's/^ADDRESS=//p' "${staged}" | head -n 1)"
  subnet="$(sed -n 's/^SUBNET=//p' "${staged}" | head -n 1)"
  nats_host="$(sed -n 's/^NATS_HOST_IP=//p' "${staged}" | head -n 1)"
  nats_port="$(sed -n 's/^NATS_PORT=//p' "${staged}" | head -n 1)"
  keepalive="$(sed -n 's/^KEEPALIVE=//p' "${staged}" | head -n 1)"
  rm -f -- "${staged}"

  [[ "${hub_key}" =~ ^[A-Za-z0-9+/]{43}=$ ]] ||
    die "Overlay request carries no usable hub public key"
  [[ "${endpoint}" =~ ^[A-Za-z0-9._-]+:[0-9]{1,5}$ ]] ||
    die "Overlay request carries no usable endpoint"
  [[ "${address}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] ||
    die "Overlay request carries no usable address"
  [[ "${subnet}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] ||
    die "Overlay request carries no usable subnet"
  [[ "${nats_host}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] ||
    die "Overlay request carries no usable NATS address"
  [[ "${nats_port}" =~ ^[0-9]{1,5}$ ]] ||
    die "Overlay request carries no usable NATS port"
  [[ "${keepalive}" =~ ^[0-9]{1,3}$ ]] || keepalive=25

  ensure_overlay_package
  ensure_overlay_key
  write_overlay_routing_table
  write_overlay_watch
  write_overlay_units

  # The subnet and the NATS address both have to reach the interface: the
  # first carries the management channel, the second is what a fallback moves.
  # AllowedIPs is also the inbound filter, so leaving the NATS address out
  # would drop the answers rather than merely fail to route the question.
  allowed="${subnet}, ${nats_host}/32"
  OVERLAY_SUBNET_VALUE="${subnet}"
  OVERLAY_NATS_HOST_VALUE="${nats_host}"
  OVERLAY_NATS_PORT_VALUE="${nats_port}"
  write_overlay_config "${mode}" "${hub_key}" "${endpoint}" "${address}" \
    "${allowed}" "${keepalive}"

  if [[ "${mode}" == "off" ]]; then
    systemctl disable --now "wg-quick@${OVERLAY_INTERFACE}" >/dev/null 2>&1 ||
      true
    systemctl disable --now "${OVERLAY_UNIT}.timer" >/dev/null 2>&1 || true
    "${OVERLAY_WATCH_PATH}" || true
  else
    systemctl enable "wg-quick@${OVERLAY_INTERFACE}" >/dev/null 2>&1 ||
      die "Could not enable the overlay interface"
    # Restart rather than start: a configuration change has to take effect,
    # and the interface may already be up from a previous mode.
    systemctl restart "wg-quick@${OVERLAY_INTERFACE}" >/dev/null 2>&1 ||
      die "The overlay interface did not come up"
    systemctl enable --now "${OVERLAY_UNIT}.timer" >/dev/null 2>&1 || true
    "${OVERLAY_WATCH_PATH}" || true
  fi

  printf 'OK overlay-configured\n'
  printf 'overlay_mode=%s\n' "${mode}"
  printf 'overlay_public_key=%s\n' "$(overlay_public_key)"
  printf 'overlay_address=%s\n' "${address}"
}

overlay_state_value() {
  local key="$1"
  local state="${STATE_DIR}/overlay-state"

  [[ -f "${state}" ]] || return 0
  sed -n "s/^${key}=//p" "${state}" | head -n 1
}

overlay_handshake_age() {
  local last=""

  command -v wg >/dev/null 2>&1 || {
    printf 'none'
    return 0
  }
  last="$(wg show "${OVERLAY_INTERFACE}" latest-handshakes 2>/dev/null |
    awk '{ print $2; exit }')" || last=""
  if [[ -z "${last}" || "${last}" == "0" ]]; then
    printf 'none'
    return 0
  fi
  printf '%s' "$(($(date +%s) - last))"
}

# Reported as part of probe-info as well, so a platform that only asks for the
# probe's state learns the overlay's without a second request. A helper from
# before the overlay omits every one of these lines, which is how it is
# recognised as one.
print_overlay_fields() {
  local public_key=""

  printf 'overlay_mode=%s\n' "$(overlay_mode)"
  public_key="$(overlay_public_key 2>/dev/null || printf 'none')"
  printf 'overlay_public_key=%s\n' "${public_key:-none}"
  printf 'overlay_address=%s\n' \
    "$(sed -n 's|^Address = \(.*\)/32$|\1|p' "${OVERLAY_CONFIG}" 2>/dev/null |
      head -n 1)"
  printf 'overlay_endpoint=%s\n' \
    "$(sed -n 's/^Endpoint = //p' "${OVERLAY_CONFIG}" 2>/dev/null | head -n 1)"
  printf 'overlay_interface_up=%s\n' \
    "$(ip link show "${OVERLAY_INTERFACE}" >/dev/null 2>&1 &&
      printf 'true' || printf 'false')"
  printf 'overlay_handshake_age=%s\n' "$(overlay_handshake_age)"
  printf 'overlay_route_active=%s\n' \
    "$(overlay_state_value ROUTE_ACTIVE || printf 'false')"
  printf 'overlay_direct_ok=%s\n' \
    "$(overlay_state_value DIRECT_OK || printf 'unknown')"
}

overlay_info() {
  printf 'OK overlay-info\n'
  print_overlay_fields
}

remove_overlay() {
  systemctl disable --now "wg-quick@${OVERLAY_INTERFACE}" >/dev/null 2>&1 || true
  systemctl disable --now "${OVERLAY_UNIT}.timer" >/dev/null 2>&1 || true
  if [[ -f "${OVERLAY_CONFIG_ENV}" ]]; then
    # Before the configuration goes: the watcher reads the address it has to
    # clean the rule for from there.
    "${OVERLAY_WATCH_PATH}" >/dev/null 2>&1 || true
  fi
  rm -f -- "${OVERLAY_CONFIG}" "${OVERLAY_CONFIG_ENV}" \
    "${OVERLAY_PRIVATE_KEY}" "${OVERLAY_WATCH_PATH}" \
    "${OVERLAY_RT_TABLES}" "${STATE_DIR}/overlay-state" \
    "${SENSOR_UNIT_DIR}/${OVERLAY_UNIT}.service" \
    "${SENSOR_UNIT_DIR}/${OVERLAY_UNIT}.timer"
  systemctl daemon-reload >/dev/null 2>&1 || true
  printf 'OK overlay-removed\n'
}

# The from= clause on the management key, rewritten in place.
#
# The platform reaches a probe from a new address once the overlay exists, and
# a key that is only valid from the old one would lock it out. This adds to
# the list rather than replacing it: a probe whose tunnel is broken has to
# stay reachable the way it always was, which is the whole reason the clause
# takes a list.
set_access_source() {
  local source_cidr="$1"
  local line=""
  local rest=""

  [[ -n "${source_cidr}" ]] || die "access-source requires a source list"
  [[ "${source_cidr}" =~ ^[A-Fa-f0-9:.,/]+$ ]] ||
    die "Invalid characters in the source list"
  [[ "${source_cidr}" != *,,* && "${source_cidr}" != ,* &&
     "${source_cidr}" != *, ]] ||
    die "The source list has an empty element"
  [[ -f "${MANAGEMENT_AUTHORIZED_KEYS}" ]] ||
    die "This probe has no management key to change"

  line="$(head -n 1 "${MANAGEMENT_AUTHORIZED_KEYS}")"
  [[ "${line}" == from=\"*\",* ]] ||
    die "The management key does not carry a from= clause"
  # Everything after the closing quote of the old from= clause: the restrict
  # options, the forced command and the key itself, all kept verbatim.
  rest="${line#*\",}"
  printf 'from="%s",%s\n' "${source_cidr}" "${rest}" \
    > "${MANAGEMENT_AUTHORIZED_KEYS}.new"
  chown --reference="${MANAGEMENT_AUTHORIZED_KEYS}" \
    "${MANAGEMENT_AUTHORIZED_KEYS}.new"
  chmod 0600 "${MANAGEMENT_AUTHORIZED_KEYS}.new"
  mv -f "${MANAGEMENT_AUTHORIZED_KEYS}.new" "${MANAGEMENT_AUTHORIZED_KEYS}"
  printf 'OK access-source %s\n' "${source_cidr}"
}

[[ "${EUID}" -eq 0 ]] || die "Helper must run as root through its sudo rule"
install -d -o root -g root -m 0700 \
  "${STATE_DIR}" \
  "${TRANSACTION_DIR}" \
  "${SENSOR_TRANSACTION_STATE_DIR}" \
  "${SENSOR_COMMIT_TOMBSTONE_DIR}"

IFS=$'\t' read -r command_name argument_one argument_two argument_three ||
  die "Missing management request"

case "${command_name}" in
  status)
    [[ -z "${argument_one:-}" ]] || die "status takes no arguments"
    status_probe
    ;;
  probe-info)
    [[ -z "${argument_one:-}" ]] || die "probe-info takes no arguments"
    probe_info
    ;;
  stage)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -z "${argument_three:-}" ]] ||
      die "stage requires transaction and username"
    IFS= read -r secret_password || die "stage requires a password on stdin"
    stage_credentials "${argument_one}" "${argument_two}" "${secret_password}"
    ;;
  write-config)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "write-config requires one transaction"
    stage_configuration "${argument_one}"
    ;;
  install-ca)
    [[ -z "${argument_one:-}" ]] || die "install-ca takes no arguments"
    install_ca
    ;;
  overlay-configure)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "overlay-configure requires one mode"
    configure_overlay "${argument_one}"
    ;;
  overlay-info)
    [[ -z "${argument_one:-}" ]] || die "overlay-info takes no arguments"
    overlay_info
    ;;
  overlay-remove)
    [[ -z "${argument_one:-}" ]] || die "overlay-remove takes no arguments"
    remove_overlay
    ;;
  access-source)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "access-source requires one source list"
    set_access_source "${argument_one}"
    ;;
  activate)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "activate requires one transaction"
    activate_credentials "${argument_one}"
    ;;
  rollback)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "rollback requires one transaction"
    rollback_credentials "${argument_one}"
    ;;
  commit)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "commit requires one transaction"
    commit_credentials "${argument_one}"
    ;;
  sensor-stage)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -n "${argument_three:-}" ]] ||
      die "sensor-stage requires transaction, sensor and slot"
    stage_sensor "${argument_one}" "${argument_two}" "${argument_three}"
    ;;
  sensor-tool-stage)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -n "${argument_three:-}" ]] ||
      die "sensor-tool-stage requires transaction, sensor and signature"
    stage_sensor_tool "${argument_one}" "${argument_two}" "${argument_three}"
    ;;
  sensor-activate)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "sensor-activate requires one transaction"
    activate_sensor "${argument_one}"
    ;;
  sensor-rollback)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "sensor-rollback requires one transaction"
    rollback_sensor "${argument_one}"
    ;;
  sensor-recover)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -z "${argument_three:-}" ]] ||
      die "sensor-recover requires sensor and transaction"
    recover_sensor_transaction "${argument_one}" "${argument_two}"
    ;;
  sensor-commit)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "sensor-commit requires one transaction"
    commit_sensor "${argument_one}"
    ;;
  sensor-list)
    [[ -z "${argument_one:-}" ]] || die "sensor-list takes no arguments"
    list_sensors
    ;;
  wireless-interfaces)
    [[ -z "${argument_one:-}" ]] ||
      die "wireless-interfaces takes no arguments"
    wireless_interfaces
    ;;
  sensor-prepare)
    [[ -z "${argument_one:-}" ]] || die "sensor-prepare takes no arguments"
    prepare_sensor_host
    ;;
  sensor-remove)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "sensor-remove requires one sensor"
    remove_sensor "${argument_one}"
    ;;
  sensor-reserve-interface)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -z "${argument_three:-}" ]] ||
      die "sensor-reserve-interface requires sensor and interface"
    reserve_sensor_interface "${argument_one}" "${argument_two}"
    ;;
  sensor-release-interface)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -z "${argument_three:-}" ]] ||
      die "sensor-release-interface requires sensor and interface"
    release_sensor_interface "${argument_one}" "${argument_two}"
    ;;
  sensor-write-profile)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -z "${argument_three:-}" ]] ||
      die "sensor-write-profile requires sensor and profile"
    write_sensor_profile "${argument_one}" "${argument_two}"
    ;;
  sensor-remove-profile)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -z "${argument_three:-}" ]] ||
      die "sensor-remove-profile requires sensor and profile"
    remove_sensor_profile "${argument_one}" "${argument_two}"
    ;;
  sensor-write-file)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -n "${argument_three:-}" ]] ||
      die "sensor-write-file requires sensor, profile and file name"
    write_sensor_file \
      "${argument_one}" "${argument_two}" "${argument_three}"
    ;;
  sensor-remove-file)
    [[ -n "${argument_one:-}" && -n "${argument_two:-}" &&
       -z "${argument_three:-}" ]] ||
      die "sensor-remove-file requires sensor and profile"
    remove_sensor_file "${argument_one}" "${argument_two}"
    ;;
  helper-update)
    [[ -n "${argument_one:-}" && -z "${argument_two:-}" ]] ||
      die "helper-update requires one signature"
    update_helper "${argument_one}"
    ;;
  mpp-uninstall)
    [[ -z "${argument_one:-}" ]] || die "mpp-uninstall takes no arguments"
    uninstall_mpp
    ;;
  unenroll)
    [[ -z "${argument_one:-}" ]] || die "unenroll takes no arguments"
    remove_access
    ;;
  *)
    die "Unsupported management request"
    ;;
esac
