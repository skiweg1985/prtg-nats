#!/bin/sh
#
# Runs on the probe, as root, once. Rendered per invitation by
# app/services/enrollment.py, which fills in the double-at placeholders below
# and refuses to serve the script if any of them is left over - an unrendered
# placeholder would reach a root shell.
#
# What it does, in the order it matters:
#   1. installs the CA, so everything after this is verified
#   2. notes the tunnel, where the operator built one before running this
#   3. installs the restricted management access (libexec/enroll-probe.sh,
#      fetched and executed, never reimplemented here)
#   4. hands the tunnel to the helper, which writes the real configuration
#   5. installs the prtgmpprobe package
#   6. reports back: this host's SSH host keys, so the platform can pin them
#
# It deliberately does not write the probe configuration. That arrives over the
# management channel afterwards, which is the channel that has to work anyway -
# doing it here would mean testing it twice and trusting it once.

set -eu

BASE_URL="@@BASE_URL@@"
TOKEN="@@TOKEN@@"
# Two digests of the same certificate, deliberately both. CA_SHA256 is the
# hash of the file, which is what sha256sum below compares and what the
# operator saw in the browser. CA_FINGERPRINT is the certificate itself, in
# its DER encoding - what install-mpp.sh means by --ca-sha256, and what the
# probe reports back over the management channel. Swapping them mismatches
# every time.
CA_SHA256="@@CA_SHA256@@"
CA_FINGERPRINT="@@CA_FINGERPRINT@@"
SSH_SOURCE_CIDR="@@SSH_SOURCE_CIDR@@"
INSTALL_PACKAGE="@@INSTALL_PACKAGE@@"
# install-mpp.sh has no default for these and asks for them at a prompt. This
# script arrives through a pipe, so there is no prompt to answer: without them
# the installer refuses before it touches a package manager.
NATS_HOST="@@NATS_HOST@@"
NATS_PORT="@@NATS_PORT@@"
# The overlay, if this installation has one. Everything here is public. The
# probe's own key is generated on this host in step 4 and never leaves it -
# only its public half travels back with the report. The one exception is
# OVERLAY_FIRST below, which is exactly the case where that order is
# impossible.
OVERLAY_ENABLED="@@OVERLAY_ENABLED@@"
OVERLAY_MODE="@@OVERLAY_MODE@@"
OVERLAY_ADDRESS="@@OVERLAY_ADDRESS@@"
OVERLAY_SUBNET="@@OVERLAY_SUBNET@@"
OVERLAY_ENDPOINT="@@OVERLAY_ENDPOINT@@"
OVERLAY_HUB_KEY="@@OVERLAY_HUB_KEY@@"
OVERLAY_NATS_HOST_IP="@@OVERLAY_NATS_HOST_IP@@"
# Set for a probe that reached this platform through the tunnel rather than
# around it - a site with no site-to-site VPN. The operator brought the tunnel
# up before running this, from two commands the interface showed, so the only
# difference here is the handover in step 4 and that a failed overlay is fatal
# rather than survivable (ADR 0010).
#
# The private key is not in this script. It went into the command that built
# the tunnel and is already at OVERLAY_KEY_PATH, where ensure_overlay_key()
# finds and keeps it.
OVERLAY_FIRST="@@OVERLAY_FIRST@@"
CA_PATH="/etc/paessler/mpprobe/certs/nats-docker-ca.pem"
OVERLAY_INTERFACE="prtgnats0"
OVERLAY_KEY_PATH="/etc/prtg-nats/overlay.key"

STAGE=""
ACCESS_INSTALLED="false"
PACKAGE_INSTALLED="false"
PACKAGE_ERROR=""
OVERLAY_PUBLIC_KEY=""

say() { printf '  %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# The tail of a log file, ready to be pasted between quotes in the report.
# Quotes and backslashes are escaped, tabs folded to spaces and the remaining
# control characters dropped, because this text was written by whatever went
# wrong and still has to arrive as a document the platform can parse. Both the
# number of lines and their length are capped: the last words of a failure are
# what explains it, and the platform refuses an oversized report outright.
#
# The deleted range runs to \013 rather than starting at \016, because \015 is
# carriage return and apt writes its progress with it. JSON forbids an
# unescaped control character, so one CR from "Reading database ... 5%" made
# the platform refuse the whole report with a 422 - losing the very failure
# the report existed to carry, and taking the enrolment with it.
json_escape_tail() {
  tail -n 20 "$1" |
    tr '\011' ' ' |
    tr -d '\000-\010\013-\037\177' |
    cut -c1-200 |
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' |
    awk '{ printf "%s%s", separator, $0; separator = "\\n" }'
}

cleanup() {
  [ -n "${STAGE}" ] && rm -rf "${STAGE}"
  return 0
}
trap cleanup EXIT INT TERM

[ "$(id -u)" -eq 0 ] || die "This has to run as root - prefix it with sudo."
for tool in curl sha256sum install id; do
  command -v "${tool}" >/dev/null 2>&1 || die "${tool} is required but missing."
done

umask 077
STAGE="$(mktemp -d /tmp/prtg-nats-enroll.XXXXXX)"

printf '\n== PRTG NATS enrolment ==\n\n'

# --- 1. The CA -------------------------------------------------------------
# Embedded rather than fetched: this script arrived over TLS verified against
# this very certificate, so it is already as trusted as the channel. Writing it
# out here also means the fingerprint the operator compared is the one that
# ends up on the probe.
say "Installing the CA"
install -d -m 0755 /etc/paessler/mpprobe/certs
cat > "${STAGE}/nats-ca.pem" <<'PRTG_NATS_CA_EOF'
@@CA_PEM@@
PRTG_NATS_CA_EOF

actual="$(sha256sum "${STAGE}/nats-ca.pem" | cut -d' ' -f1)"
[ "${actual}" = "${CA_SHA256}" ] || die "CA fingerprint mismatch: ${actual}"
install -o root -g root -m 0644 "${STAGE}/nats-ca.pem" "${CA_PATH}"
say "CA fingerprint ${CA_SHA256}"

fetch() {
  curl -fsSL --cacert "${CA_PATH}" "${BASE_URL}/enroll/${TOKEN}/asset/$1" -o "$2" \
    || die "Could not fetch $1 from ${BASE_URL}"
}

# --- 2. The tunnel the operator already built ------------------------------
# For OVERLAY_FIRST the tunnel exists before this script does: the interface
# showed two commands that install wireguard-tools and bring prtgnats0 up, and
# this script arrived through it. It is not built here, because the download
# of this very script is the first request - a script cannot be fetched over a
# tunnel it has not created yet.
#
# What remains is the handover in step 4. The helper writes the real
# configuration - policy rule, routing table, watcher - and wg-quick refuses an
# interface that already exists, so the operator's one has to go first.
overlay_down() {
  [ -n "${OVERLAY_INTERFACE}" ] || return 0
  ip link show "${OVERLAY_INTERFACE}" >/dev/null 2>&1 || return 0
  ip link delete "${OVERLAY_INTERFACE}" 2>/dev/null || true
}

# A WireGuard handshake is not instant, and every request after the helper has
# replaced the interface would otherwise fail with a bare timeout on a console
# nobody returns to.
wait_for_platform() {
  attempt=1
  while [ "${attempt}" -le 10 ]; do
    curl -fsS --max-time 5 --cacert "${CA_PATH}" \
      "${BASE_URL}/enroll/${TOKEN}/asset/enroll-probe.sh" -o /dev/null \
      2>/dev/null && return 0
    attempt=$((attempt + 1))
    sleep 2
  done
  return 1
}

if [ "${OVERLAY_FIRST}" = "true" ]; then
  # Reached us, so the tunnel is up - this script came through it. Said out
  # loud anyway, because the next lines only make sense with that in mind.
  say "Enrolling over the overlay tunnel as ${OVERLAY_ADDRESS}"
fi

# --- 3. The management access ----------------------------------------------
# enroll-probe.sh is served by the platform and run unchanged. The from=,
# restrict and forced-command rules that make this access safe are defined in
# that one file and nowhere else.
say "Installing the restricted management access"
fetch enroll-probe.sh "${STAGE}/enroll-probe.sh"
fetch prtg-nats-probe-helper "${STAGE}/prtg-nats-probe-helper"
cat > "${STAGE}/management.pub" <<'PRTG_NATS_KEY_EOF'
@@MANAGEMENT_PUBLIC_KEY@@
PRTG_NATS_KEY_EOF

# The trust anchor for later helper updates. It travels here and nowhere else:
# arriving over the management channel it protects would make it worthless.
cat > "${STAGE}/helper-signing.pub" <<'PRTG_NATS_SIGNING_EOF'
@@HELPER_SIGNING_KEY@@
PRTG_NATS_SIGNING_EOF

bash "${STAGE}/enroll-probe.sh" \
  --public-key "${STAGE}/management.pub" \
  --helper "${STAGE}/prtg-nats-probe-helper" \
  --signing-key "${STAGE}/helper-signing.pub" \
  --source-cidr "${SSH_SOURCE_CIDR}" >/dev/null
ACCESS_INSTALLED="true"
say "Management user prtg-nats-admin is ready"

# --- 4. The overlay --------------------------------------------------------
# Through the helper that step 3 installed, not reimplemented here: the
# platform configures the tunnel with the same request afterwards, and two
# implementations of it would be two ways for a probe to end up configured
# differently from what the hub believes.
#
# This is also the only moment that works for a probe behind NAT. It reports in
# once and is never reachable the other way, so the tunnel that makes it
# reachable has to be built from the script it was handed.
if [ "${OVERLAY_ENABLED}" = "true" ]; then
  say "Joining the overlay as ${OVERLAY_ADDRESS} (${OVERLAY_MODE})"
  # The throwaway interface goes first: wg-quick refuses to bring up one that
  # already exists. Nothing between here and the helper's own configuration
  # needs the network - it is all local - and the helper puts the tunnel back
  # before the report at the end.
  [ "${OVERLAY_FIRST}" != "true" ] || overlay_down
  {
    printf 'HUB_PUBLIC_KEY=%s\n' "${OVERLAY_HUB_KEY}"
    printf 'ENDPOINT=%s\n' "${OVERLAY_ENDPOINT}"
    printf 'ADDRESS=%s\n' "${OVERLAY_ADDRESS}"
    printf 'SUBNET=%s\n' "${OVERLAY_SUBNET}"
    printf 'NATS_HOST_IP=%s\n' "${OVERLAY_NATS_HOST_IP}"
    printf 'NATS_PORT=%s\n' "${NATS_PORT}"
  } > "${STAGE}/overlay.request"

  if {
    printf 'overlay-configure\t%s\n' "${OVERLAY_MODE}"
    cat "${STAGE}/overlay.request"
  } | /usr/local/sbin/prtg-nats-probe-helper > "${STAGE}/overlay.answer" 2>&1; then
    OVERLAY_PUBLIC_KEY="$(sed -n 's/^overlay_public_key=//p' "${STAGE}/overlay.answer")"
    say "Overlay key ${OVERLAY_PUBLIC_KEY}"
    # The helper took the interface down and brought it back up, so the
    # handshake starts over. Everything left in this script - the package and
    # the report - goes through it.
    if [ "${OVERLAY_FIRST}" = "true" ]; then
      wait_for_platform ||
        die "The tunnel did not come back after it was configured properly.
The management access is installed; retry with a fresh invitation."
    fi
  elif [ "${OVERLAY_FIRST}" = "true" ]; then
    # Fatal here, unlike below. This probe has no second path: the report at
    # the end of this script travels over the tunnel, and so does everything
    # the platform would do afterwards.
    sed -n '1,5p' "${STAGE}/overlay.answer" | while read -r line; do
      say "  ${line}"
    done
    die "The overlay could not be configured, and this probe has no other way
to reach the platform. The management access is installed; retry with a fresh
invitation once the cause above is fixed."
  else
    # Not fatal. The probe is enrolled and reachable the ordinary way; the
    # overlay is the second path, and reporting why it failed is more use than
    # abandoning an otherwise finished installation.
    say "The overlay could not be set up - the probe is enrolled without it:"
    sed -n '1,5p' "${STAGE}/overlay.answer" | while read -r line; do
      say "  ${line}"
    done
  fi
fi

# --- 5. The package --------------------------------------------------------
# --no-config on purpose: the configuration arrives over the management
# channel, so the channel is exercised before anything depends on it.
if [ "${INSTALL_PACKAGE}" = "true" ]; then
  if command -v prtgmpprobe >/dev/null 2>&1 || [ -f /opt/paessler/mpprobe/mpprobe ]; then
    say "prtgmpprobe is already installed - keeping it"
    PACKAGE_INSTALLED="true"
  else
    say "Installing prtgmpprobe (this fetches from packages.paessler.com)"
    fetch install-mpp.sh "${STAGE}/install-mpp.sh"
    # Teed rather than swallowed or hidden. The operator keeps watching an
    # installation that takes minutes, and the same words are kept on disk so
    # a failure can travel back with the report - without them the platform
    # only ever learned that the package is absent, never why, and the reason
    # scrolled off a console nobody returns to. sh has no PIPESTATUS, so the
    # failure leaves a marker file behind instead.
    {
      bash "${STAGE}/install-mpp.sh" \
        --nats-host "${NATS_HOST}" \
        --nats-port "${NATS_PORT}" \
        --ca-file "${CA_PATH}" \
        --ca-sha256 "${CA_FINGERPRINT}" \
        --accept-ca \
        --no-config || touch "${STAGE}/install-mpp.failed"
    } 2>&1 | tee "${STAGE}/install-mpp.log"
    if [ -e "${STAGE}/install-mpp.failed" ]; then
      PACKAGE_ERROR="$(json_escape_tail "${STAGE}/install-mpp.log")"
      say "Package installation failed - reporting back anyway so the platform"
      say "can show what happened; the management access is already in place."
    else
      PACKAGE_INSTALLED="true"
    fi
  fi
fi

# --- 6. Report back --------------------------------------------------------
# The host keys are read from disk rather than scanned over the network: this
# is the host itself, so there is nothing to be in the middle of. They travel
# over the token-authenticated channel, which is what makes pinning them
# better than a blind scan from the platform.
say "Reporting back to the platform"

keys=""
for pub in /etc/ssh/ssh_host_*_key.pub; do
  [ -f "${pub}" ] || continue
  line="$(cut -d' ' -f1,2 < "${pub}")"
  [ -n "${keys}" ] && keys="${keys},"
  keys="${keys}\"${line}\""
done
[ -n "${keys}" ] || die "No SSH host keys found - is sshd installed?"

ssh_port="$(
  awk '/^[Pp]ort[ \t]+[0-9]+/ { print $2; exit }' /etc/ssh/sshd_config 2>/dev/null
)"
[ -n "${ssh_port:-}" ] || ssh_port=22

if [ -n "${PACKAGE_ERROR}" ]; then
  package_error="\"${PACKAGE_ERROR}\""
else
  package_error="null"
fi

if [ -n "${OVERLAY_PUBLIC_KEY}" ]; then
  overlay_key="\"${OVERLAY_PUBLIC_KEY}\""
else
  overlay_key="null"
fi

payload="$(printf '{"hostname":"%s","ssh_port":%s,"host_keys":[%s],"access_installed":%s,"package_installed":%s,"package_error":%s,"overlay_public_key":%s}' \
  "$(hostname -f 2>/dev/null || hostname)" "${ssh_port}" "${keys}" \
  "${ACCESS_INSTALLED}" "${PACKAGE_INSTALLED}" "${package_error}" \
  "${overlay_key}")"

printf '%s' "${payload}" > "${STAGE}/callback.json"
curl -fsS --cacert "${CA_PATH}" \
  -H 'Content-Type: application/json' \
  --data-binary "@${STAGE}/callback.json" \
  "${BASE_URL}/enroll/${TOKEN}/callback" > "${STAGE}/answer" \
  || die "The platform did not accept the report. The management access is
installed; retry with a fresh invitation from the interface."

printf '\n== Done ==\n\n'
say "The platform is now configuring this probe."
say "Watch it finish in the web interface."
printf '\n'
